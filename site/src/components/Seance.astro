---
// Trancher des votes, un par un (frames V5 « ① Première question », « ② Révélation » et
// « ⑥ Séance ») : la question, « Concrètement », Pour / Contre / Je ne sais pas, puis la
// révélation du vote réel ; à droite, ton hémicycle se construit à chaque réponse. Commun au
// quiz d'entrée et aux lots de votes ; le déroulé est dans lib/seance.ts, l'écran de fin vient
// de la page (slot « fin »).
import JaugePrecision from './JaugePrecision.astro';
import Salle from './Salle.astro';
import { composition, dateLisible, lienVote, scrutinPublie } from '../lib/donnees.ts';
import { NIVEAUX, SANS_VOTE_COMMUN } from '../lib/profil.ts';
import { verdict } from '../lib/votes.ts';

interface Props {
  /** `uid` vide : un vote annoncé, pas encore tenu (séance de la semaine) ; `quand` dit alors
   *  quand les députés votent (« le mardi 13 octobre à 15 h »). */
  cartes: { uid: string; numero: number; theme: string; question: string; concretement: string;
    quand?: string }[];
  /** La puce de chaque carte, « fond:encre ». */
  puces: string[];
  /** Afficher la date du vote à côté du thème (frame ⑥). */
  dates?: boolean;
  /** Proposer un pronostic après chaque vote pas encore tenu (frame ⑥). */
  pronostic?: boolean;
}

const { cartes, puces, dates = false, pronostic = false } = Astro.props;
const compo = composition();
// Le vote de chaque député d'aujourd'hui, siège par siège dans la salle du jour : P, C, A
// (abstention), N (non-votant), - (absent), en minuscule s'il a voté contre son groupe ;
// x s'il n'était pas député à la date du vote, V pour un siège vacant.
const LETTRES: Record<string, string> = { pour: 'P', contre: 'C', abstention: 'A',
  non_votant: 'N', absent: '-' };
const questions = cartes.map((q, k) => {
  const s = q.uid ? scrutinPublie(q.uid) : null;
  if (!s) {
    // Pas encore voté : ni sièges ni décompte, la révélation viendra avec le verdict (t25).
    return {
      uid: q.uid, numero: q.numero, theme: q.theme, concretement: q.concretement,
      question: q.question.replace(/ ([?!:;])/g, ' $1'), attente: true, quand: q.quand ?? '',
      date: dates ? `Scrutin solennel · ${q.quand ?? ''}` : '', lien: '', verdict: '',
      adopte: false, decompte: { pour: 0, contre: 0, abstention: 0 }, dissidents: 0, marge: null,
      requis: null, puce: puces[k], sieges: '',
    };
  }
  const votes = new Map(s.sieges.filter((x) => x.depute).map((x) => [x.depute!, x]));
  return {
    uid: q.uid, numero: q.numero, theme: q.theme, concretement: q.concretement,
    question: q.question.replace(/ ([?!:;])/g, ' $1'),
    date: dates ? `${s.solennel ? 'Scrutin solennel' : 'Vote'} du ${dateLisible(s.date)}` : '',
    lien: lienVote(s), verdict: verdict(s), adopte: s.sort === 'adopté', decompte: s.decompte,
    dissidents: s.dissidents, marge: s.voix_pour_inverser, requis: s.requis, puce: puces[k],
    attente: false,
    quand: '', sieges: compo.sieges.map((c) => {
      if (c.vacant || !c.depute) return 'V';
      const x = votes.get(c.depute);
      if (!x) return 'x';
      const l = LETTRES[x.vote ?? 'absent'] ?? '-';
      return x.dissident ? l.toLowerCase() : l;
    }).join(''),
  };
});
const donnees = JSON.stringify({ questions }).replace(/</g, '\\u003c');
---
<div class="quiz" data-quiz>
  <!-- Les puces de caméra, décoratives en mode focus : la salle est ici une image fixe (CAM 2). -->
  <div class="cameras-deco" aria-hidden="true">
    <span>Cam 1<span class="cam-nom"> · Salle</span></span>
    <span class="actif">Cam 2<span class="cam-nom"> · Tribune</span></span>
    <span>Cam 3<span class="cam-nom"> · Ta travée</span></span>
    <span>Cam 4<span class="cam-nom"> · Plan</span></span>
  </div>
  <section class="gauche" aria-live="polite">
    <div class="question" data-ecran="question">
      {Astro.slots.has('bulle') && (
        <div class="bulle" data-bulle>
          <span class="robot" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28"><rect x="6" y="12" width="16" height="9" rx="3" fill="#fff"></rect><rect x="9" y="5" width="10" height="8" rx="3" fill="#fff"></rect><rect x="8" y="20" width="3" height="5" rx="1.5" fill="#fff"></rect><rect x="17" y="20" width="3" height="5" rx="1.5" fill="#fff"></rect></svg>
          </span>
          <p><slot name="bulle" /></p>
        </div>
      )}
      <div class="carte-question" data-carte>
      <div class="puces">
        <span class="puce-theme" data-theme></span>
        {dates && (
          <span class="puce-date" data-date>
            <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M8 4.5V8l2.5 1.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
            <span data-date-texte></span>
          </span>
        )}
      </div>
      <h1 data-question tabindex="-1"></h1>
      <p class="concretement"><span class="concretement-titre">Ce que ça change, concrètement</span> <span data-concretement></span></p>
      </div>
      <p class="choix-titre">{pronostic ? 'Et toi, tu voterais quoi ?' : 'Et toi, qu’aurais-tu voté ?'}</p>
      <div class="choix">
        <button type="button" class="b-pour" data-reponse="pour"><svg class="coche" viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M5 12.5l4.5 4.5L19 7.5"></path></svg>Pour</button>
        <button type="button" class="b-contre" data-reponse="contre"><svg class="coche" viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M5 12.5l4.5 4.5L19 7.5"></path></svg>Contre</button>
      </div>
      <button type="button" class="b-passer" data-reponse=""><svg class="coche" viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M5 12.5l4.5 4.5L19 7.5"></path></svg>Je ne sais pas</button>
      <span class="visuellement-cache" data-annonce-vote></span>
      <!-- L'action principale du panneau après la révélation (le bandeau de la révélation est à gauche). -->
      <button type="button" class="b-continuer" data-continuer>Continuer</button>
      {pronostic && (
        <div class="pronostic" data-pronostic hidden>
          <div class="prono-tete">
            <span class="prono-titre">Bonus : ton pronostic</span>
            <span class="facultatif">facultatif</span>
          </div>
          <p class="prono-question" data-prono-question></p>
          <div class="prono-choix">
            <button type="button" data-prono="adopte">Adopté</button>
            <button type="button" data-prono="rejete">Rejeté</button>
          </div>
          <button type="button" class="b-suivant" data-suivant>Vote suivant</button>
        </div>
      )}
    </div>
    <slot name="fin" />
  </section>

  <section class="panneau" aria-labelledby="titre-panneau">
    <div class="panneau-tete">
      <div class="precision-tete" data-precision-tete title="Plus tu tranches de votes, plus ton résultat est fiable">
        <span class="precision-tete-titre">Précision</span>
        <span class="precision-tete-segments" aria-hidden="true" data-segments-tete>
          {Array.from({ length: 10 }, () => <span></span>)}
        </span>
        <span class="precision-tete-pct" data-precision-tete-pct>0 %</span>
      </div>
    </div>
    <div class="cadre-salle">
      <Salle sieges={compo.sieges} groupes={compo.groupes} titre="L'Assemblée nationale" libre
        chiffre="577" legende="sièges… et le tien" />
    </div>
    <ul class="legende" data-legende-vote hidden>
      <li><span style="background: var(--pour)"></span>Pour</li>
      <li><span style="background: var(--contre)"></span>Contre</li>
      <li><span style="background: var(--abstention)"></span>Abstention</li>
      <li><span style="background: var(--non-votant)"></span>Non-votant</li>
      <li><span style="background: var(--absent)"></span>Absent</li>
      <li><span class="anneau"></span>Contre son groupe</li>
      <li data-legende-hors hidden><span class="sans" style={`border-color: ${SANS_VOTE_COMMUN}`}></span>Pas encore député</li>
    </ul>
    <ul class="legende" data-legende-accord>
      {NIVEAUX.map((t) => <li><span style={`background: ${t.couleur}`}></span>{t.libelle}</li>)}
      <li><span class="sans" style={`border-color: ${SANS_VOTE_COMMUN}`}></span>Aucun vote en commun</li>
    </ul>
    <!-- Le bandeau de l'étape (maquette V6C-02), en bas de la colonne de gauche. -->
    <div class="bandeau etape">
      <div class="bandeau-ligne">
        <span class="bandeau-etiquette">L’Assemblée</span>
        <h2 id="titre-panneau" class="bandeau-titre" data-panneau-titre>Ton hémicycle</h2>
      </div>
      <p class="bandeau-legende" data-panneau-sous>Il se construit à chaque réponse</p>
    </div>
  </section>
</div>

<div class="revelation" data-revelation hidden>
  <div class="revelation-dedans">
    <span class="revelation-icone" aria-hidden="true">
      <svg width="30" height="30" viewBox="0 0 30 30"><circle cx="9" cy="10" r="3.5" fill="currentColor"></circle><circle cx="21" cy="10" r="3.5" fill="currentColor"></circle><circle cx="15" cy="20" r="4.5" fill="currentColor"></circle></svg>
    </span>
    <div class="revelation-texte">
      <p class="revelation-titre" data-rv-titre></p>
      <p><span data-rv-ligne></span> <a data-lien-vote href="/explorer/">Tout savoir sur ce vote</a></p>
      <div class="rv-precision" data-rv-precision hidden>
        <span class="rv-precision-titre">Précision</span>
        <JaugePrecision />
      </div>
    </div>
    <div class="ta-voix" data-ta-voix>
      <p class="sur-titre">
        <svg width="22" height="14" viewBox="0 0 40 24" aria-hidden="true"><circle cx="5" cy="20" r="3.2" fill="#6E6A63"></circle><circle cx="9" cy="11" r="3.2" fill="#6E6A63"></circle><circle cx="17" cy="5" r="3.2" fill="#6E6A63"></circle><circle cx="26" cy="5" r="3.2" fill="#6E6A63"></circle><circle cx="33" cy="11" r="3.2" fill="#6E6A63"></circle><circle cx="36" cy="20" r="3.8" fill="#F2C98A"></circle></svg>
        <span>Ta voix de 578<sup>e</sup></span>
      </p>
      <p data-rv-voix></p>
    </div>
  </div>
</div>

<script type="application/json" data-donnees-seance set:html={donnees}></script>

<style>
  /* Le mode focus de « La Séance » (maquettes V6C-02 et V6C-05, DESIGN-FINAL.md § 6) : la tribune
     visible derrière ; à droite, le panneau de vote posé sur la salle (la question en Literata,
     « Ce que ça change, concrètement », trois boutons identiques, le pronostic facultatif) ; à
     gauche, les puces de caméra, ton hémicycle sur un voile et le bandeau de l'étape. */
  :global(main.page.focus) { flex: 1; max-width: none; padding: 24px 32px 28px; }
  /* Le fond : l'image fixe de la salle (CAM 2 · Tribune, scripts/images-fixes.mjs), nette à
     gauche, assombrie seulement derrière le panneau ; la 3D ne s'ouvre pas en direct ici. */
  :global(body.focus)::before { content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(90deg, rgba(12, 13, 16, 0.15) 0%, rgba(12, 13, 16, 0.25) 45%, rgba(12, 13, 16, 0.82) 62%),
      url('/salle3d/fond-tribune.webp') center 40% / cover no-repeat; }

  .quiz { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 560px); grid-template-rows: auto 1fr;
    grid-template-areas: 'cameras gauche' 'panneau gauche'; gap: 24px 48px; align-items: start; }
  .cameras-deco { grid-area: cameras; display: flex; flex-wrap: wrap; gap: 8px; }
  .cameras-deco > span { display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 14px; border-radius: var(--rayon-puce);
    border: 1px solid rgba(242, 238, 230, 0.28); background: var(--voile); color: var(--ivoire);
    font: 600 13px/1 var(--police-titre); letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap; }
  .cameras-deco .actif { background: var(--ivoire); color: var(--nuit); border-color: var(--ivoire); }
  .cameras-deco .actif::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--direct); }
  /* Le panneau de vote : le seul carton posé sur la salle, avec ombre et rayon de 6 px. */
  .gauche { grid-area: gauche; min-width: 0; padding: 28px; border-radius: var(--rayon);
    background: var(--panneau); box-shadow: var(--ombre-panneau); }
  /* Ton hémicycle, sur un voile, sans bordure ni ombre ; le bandeau de l'étape en bas. */
  .panneau { grid-area: panneau; align-self: stretch; display: flex; flex-direction: column; gap: 14px; min-width: 0;
    max-width: 640px; scroll-margin-top: 16px; }
  .panneau-tete, .cadre-salle, .panneau > .legende { max-width: 520px; }
  .panneau-tete { display: flex; justify-content: flex-start; }
  .cadre-salle { padding: 16px 18px 6px; background: var(--voile); }
  .panneau > .legende { margin: 0; padding: 10px 14px; background: var(--voile); }
  .etape { margin-top: auto; }
  .etape .bandeau-titre { margin: 0; font-size: 26px; line-height: 1.05; }
  .etape .bandeau-legende { margin: 0; }
  /* Pendant la révélation, son bandeau prend la place de celui de l'étape. */
  :global(.quiz:has(~ .revelation:not([hidden]))) .etape { visibility: hidden; }
  /* Tablette et téléphone : une colonne, le panneau de vote d'abord. */
  @media (max-width: 1000px) {
    :global(main.page.focus) { padding: 16px var(--gouttiere) 24px; }
    .quiz { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; grid-template-areas: 'cameras' 'gauche' 'panneau'; gap: 20px; }
    .panneau { max-width: none; }
    .etape { margin-top: 0; }
  }
  /* Téléphone (maquette V6C-05) : la salle sur les 40 % du haut, les puces en bas de l'image, le
     panneau de vote monte en feuille. */
  @media (max-width: 640px) {
    :global(body.focus)::before { background: linear-gradient(180deg, rgba(12, 13, 16, 0) 0, rgba(12, 13, 16, 0) 30vh, var(--nuit) 40vh),
      url('/salle3d/fond-tribune-telephone.webp') center -26vh / 100% auto no-repeat, var(--nuit); }
    :global(main.page.focus) { padding: 0 0 16px; }
    .quiz { gap: 0; }
    .cameras-deco { flex-wrap: nowrap; justify-content: center; gap: 6px; padding: calc(40vh - 120px) 16px 12px; }
    .cameras-deco > span { padding: 0 9px; gap: 5px; letter-spacing: 0.06em; }
    .cameras-deco > span:not(.actif) .cam-nom { display: none; }
    .gauche { padding: 16px; border-radius: 0; box-shadow: none; }
    .panneau { padding: 16px; }
    .revelation { margin: 0 16px; }
  }
  .precision-tete { display: flex; align-items: center; gap: 10px; padding: 8px 12px; background: var(--panneau-2); }
  .precision-tete-titre { font: 600 var(--taille-puce)/16px var(--police-titre); letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--ivoire-2); }
  .precision-tete-segments { display: flex; gap: 3px; }
  .precision-tete-segments span { width: 9px; height: 4px; background: var(--filet); }
  .precision-tete-segments :global(span.plein) { background: var(--lumiere); }
  .precision-tete-pct { min-width: 36px; font: 600 15px/1 var(--police-titre); font-variant-numeric: tabular-nums; }

  .legende { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; margin: 18px 0 0; padding: 0;
    list-style: none; font-size: 14px; color: var(--ivoire-2); }
  .legende li { display: inline-flex; align-items: center; gap: 7px; }
  .legende span { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
  .legende .anneau { background: var(--panneau); box-shadow: 0 0 0 2.5px var(--ivoire); }
  .legende .sans { background: var(--panneau); border: 2px solid; }

  .bulle { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 24px; }
  .bulle p { margin: 0; padding: 12px 16px; background: var(--panneau-2);
    font-size: 16px; line-height: 1.5; color: var(--ivoire); }
  .bulle :global(strong) { color: var(--ivoire); }
  .robot { flex: none; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px;
    background: var(--panneau-2); }
  /* L'arrivée de la carte suivante (A1). */
  .carte-question:global(.arrive) { animation: monte var(--dur-m) var(--ease-monte) both; }
  @media (prefers-reduced-motion: reduce) { .carte-question:global(.arrive) { animation: fondu var(--dur-xs) linear both; } }
  .puces { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  /* Le thème : une étiquette de régie, la même pour tous les thèmes (la couleur de la puce,
     posée par lib/seance.ts, cède la place au rouge de régie). */
  .puce-theme { display: inline-flex; align-items: center; padding: 6px 8px;
    background: var(--direct) !important; color: var(--sur-direct) !important;
    font: 600 12px/1 var(--police-titre); letter-spacing: 0.12em; text-transform: uppercase; }
  .puce-date { display: inline-flex; align-items: center; gap: 6px; color: var(--ivoire-2);
    font: 600 var(--taille-puce)/16px var(--police-titre); letter-spacing: 0.12em; text-transform: uppercase; }
  .question h1 { margin: 18px 0 18px; font: 500 var(--taille-question)/1.24 var(--police-question);
    letter-spacing: 0; text-wrap: balance; outline: none; }
  .question h1:global(.longue) { font-size: 28px; line-height: 1.28; }
  @media (max-width: 640px) {
    .question h1 { font-size: 22px; line-height: 1.3; }
    .question h1:global(.longue) { font-size: 20px; }
    .concretement { font-size: 15px; line-height: 1.45; }
  }
  .concretement { margin: 0 0 24px; font-size: 17px; line-height: 27px; color: var(--ivoire); }
  .concretement-titre { display: block; margin-bottom: 6px; font: 600 var(--taille-puce)/16px var(--police-titre);
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--ivoire-2); }

  /* Les boutons de vote : strictement identiques, seule la pastille porte la couleur du vote. */
  .choix-titre { margin: 0; padding-top: 18px; border-top: 1px solid var(--filet); font: 600 13px/16px var(--police-titre);
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--ivoire); }
  .choix { display: flex; flex-direction: column; gap: 12px; padding-top: 12px; }
  .choix button, .b-passer {
    position: relative; display: flex; align-items: center; gap: 14px; width: 100%; min-height: 58px;
    padding: 0 18px; border: 1px solid var(--filet); border-radius: var(--rayon); background: var(--panneau-2);
    color: var(--ivoire); font: 600 21px/1 var(--police-titre); letter-spacing: 0.03em; text-transform: uppercase;
    text-align: left; cursor: pointer; transition: transform .08s ease, opacity .2s;
  }
  .b-passer { margin-top: 12px; }
  .choix button::before, .b-passer::before { content: ''; flex: none; width: 14px; height: 14px; border-radius: 50%; }
  .b-pour::before { background: var(--pour); }
  .b-contre::before { background: var(--contre); }
  .b-passer::before { background: var(--voyant-eteint); box-shadow: inset 0 0 0 1px var(--ivoire-2); }
  .choix button:hover:not(:disabled), .b-passer:hover:not(:disabled) { border-color: var(--ivoire-2); }
  .choix button:active, .b-passer:active { transform: translateY(5px); }
  .choix button:disabled, .b-passer:disabled { cursor: default; }
  /* Choisi : un cadre ivoire de 2 px et « Ton vote », pour chaque choix. */
  .choix button:global(.choisi), .b-passer:global(.choisi) { border: 2px solid var(--ivoire); padding: 0 17px; }
  .choix button:global(.choisi)::after, .b-passer:global(.choisi)::after { content: 'Ton vote'; margin-left: auto;
    margin-right: 30px; font: 600 12px/1 var(--police-titre); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ivoire-2); }
  /* Après le vote, les autres réponses restent identiques (DESIGN-FINAL.md, § 6) : seul le choisi
     prend son cadre ivoire. */
  .choix button:global(.estompe), .b-passer:global(.estompe) { opacity: 1; transform: none; }
  /* Le geste de vote (A2 + A3, docs/animations-lot-1.md § 1) : la même animation pour chaque
     choix. Le bouton choisi rebondit et une coche se trace ; les autres s'éteignent. */
  .choix button:global(.choisi), .b-passer:global(.choisi) { animation: ressort var(--dur-s) var(--ease-ressort) both; }
  .choix button:global(.estompe), .b-passer:global(.estompe) { transition: transform .2s ease, opacity .2s ease; }
  .coche { position: absolute; right: 14px; top: calc(50% - 9px); width: 18px; height: 18px; opacity: 0; pointer-events: none; }
  .coche path { fill: none; stroke: currentColor; stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 1; stroke-dashoffset: 1; }
  :global(.choisi) > .coche { opacity: 1; }
  :global(.choisi) > .coche path { animation: trace 300ms ease-out 50ms both; }
  @media (prefers-reduced-motion: reduce) {
    .choix button:global(.choisi), .b-passer:global(.choisi) { animation: none; }
    :global(.choisi) > .coche path { animation: none; stroke-dashoffset: 0; }
    .choix button:global(.estompe), .b-passer:global(.estompe) { transition: none; }
  }

  /* La révélation : un bandeau de régie posé en bas de la colonne de gauche, sur la salle ; l'action
     « Continuer » reste dans le panneau de vote. */
  .revelation { position: relative; z-index: 5; margin: 16px 0 0; animation: bandeau var(--dur-bandeau) var(--ease-bandeau) both; }
  @media (min-width: 1000px) {
