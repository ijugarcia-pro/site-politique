---
import Base from '../layouts/Base.astro';
---
<Base titre="Page introuvable" description="Cette page n'existe pas.">
  <section class="vide">
    <svg width="120" height="72" viewBox="0 0 40 24" aria-hidden="true">
      <circle cx="5" cy="20" r="3.2" fill="#C9CFDA"></circle>
      <circle cx="9" cy="11" r="3.2" fill="#C9CFDA"></circle>
      <circle cx="17" cy="5" r="3.2" fill="#C9CFDA"></circle>
      <circle cx="26" cy="5" r="3.2" fill="#C9CFDA"></circle>
      <circle cx="33" cy="11" r="3.2" fill="#C9CFDA"></circle>
      <circle cx="36" cy="20" r="3.6" fill="none" stroke="#7C4DFF" stroke-width="1.2" stroke-dasharray="1.6 1.2"></circle>
    </svg>
    <h1>Ce siège est vide</h1>
    <p>La page demandée n'existe pas, ou plus. Le vote ou le député que tu cherches est peut-être ailleurs :</p>
    <div class="liens">
      <a class="bouton" href="/explorer/">Tous les votes</a>
      <a class="bouton" href="/deputes/">Trouver mon député</a>
      <a class="bouton" href="/">Accueil</a>
    </div>
  </section>
</Base>

<style>
  .vide { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 40px 0; text-align: center; }
  .vide p { margin: 0; max-width: 520px; color: var(--texte-doux); }
  .liens { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 8px; }
</style>
