---
// Mise en page commune : en-tête avec les 3 onglets (Cette semaine · Mon hémicycle · Explorer),
// contenu, pied de page avec les sources. Polices servies par le site (aucun appel à Google).
import '@fontsource-variable/fredoka/wght.css';
import '@fontsource-variable/nunito/wght.css';
import '../styles/global.css';
import { scrutins } from '../lib/donnees.ts';

interface Props {
  titre: string;
  description: string;
  onglet?: 'semaine' | 'hemicycle' | 'explorer';
  /** Mode focus (quiz, séance) : pas d'onglets ; l'en-tête reçoit le contenu du slot
   *  « entete » (barre de progression…). */
  focus?: boolean;
}

const { titre, description, onglet, focus = false } = Astro.props;
const ONGLETS = [
  { id: 'semaine', href: '/', label: 'Cette semaine', icone: 'M3 5h14v12H3zM3 9h14M7 3v4M13 3v4' },
  { id: 'hemicycle', href: '/hemicycle/', label: 'Mon hémicycle',
    icone: 'M2 16a8 8 0 0 1 16 0M6 16a4 4 0 0 1 8 0' },
  { id: 'explorer', href: '/explorer/', label: 'Explorer',
    icone: 'M9 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12zM13.5 13.5L18 18' },
];
const titreComplet = titre === 'Le 578e siège' ? titre : `${titre} · Le 578e siège`;
// La précision compte les réponses aux votes de la matrice : tous les votes à page, sauf les
// motions de censure (lib/profil.ts).
const horsMatrice = JSON.stringify(scrutins().filter((s) => s.motion_censure).map((s) => s.uid));
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class:list={[{ focus }]}>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <header class:list={['entete', { focus }]}>
      <a class="logo" href="/" aria-label="Le 578e siège, accueil">
        <svg width="40" height="24" viewBox="0 0 40 24" aria-hidden="true">
          <circle cx="5" cy="20" r="3.2" fill="#C9CFDA"></circle>
          <circle cx="9" cy="11" r="3.2" fill="#C9CFDA"></circle>
          <circle cx="17" cy="5" r="3.2" fill="#C9CFDA"></circle>
          <circle cx="26" cy="5" r="3.2" fill="#C9CFDA"></circle>
          <circle cx="33" cy="11" r="3.2" fill="#C9CFDA"></circle>
          <circle cx="36" cy="20" r="3.8" fill="#7C4DFF"></circle>
        </svg>
        <span>578<sup>e</sup> siège</span>
      </a>
      {focus ? <slot name="entete" /> : (
      <>
      <nav aria-label="Navigation principale">
        <ul>
          {ONGLETS.map((o) => (
            <li>
              <a href={o.href} aria-current={o.id === onglet ? 'page' : undefined}
                aria-label={o.label}>
                <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                  <path d={o.icone} fill="none" stroke="currentColor" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span class="texte-onglet">{o.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="outils">
        <a class="rond" href="/explorer/#recherche" aria-label="Rechercher un vote ou un député">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="2.2"></circle>
            <path d="M12.5 12.5l4 4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
          </svg>
        </a>
        <a class="anneau" href="/hemicycle/" data-anneau hidden
          title="Précision de ton hémicycle : plus tu tranches de votes, plus elle monte">
          <span data-anneau-pct></span>
        </a>
        <a class="rond etoile" href="/hemicycle/" aria-label="Mon hémicycle : ta place">
          <svg width="22" height="22" viewBox="0 0 34 34" aria-hidden="true">
            <path d="M17 2l4.4 9.2 10 1.3-7.3 7 1.9 10L17 24.6 8 29.5l1.9-10-7.3-7 10-1.3z"
              fill="#FFC531" stroke="#1F2433" stroke-width="2.4" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
      </>
      )}
    </header>
    <main id="contenu" class:list={['page', { focus }]}>
      <slot />
    </main>
    {focus ? (
    <footer class="pied-focus" data-pied-focus>
      <span>Votes issus des données ouvertes de l'Assemblée nationale. Tes réponses restent dans ton navigateur.</span>
      <a href="/etat/">État des données</a>
    </footer>
    ) : (
    <footer class="pied">
      <p>
        Données : <a href="https://data.assemblee-nationale.fr/">open data de l'Assemblée
        nationale</a> (17<sup>e</sup> législature, Licence ouverte), retraitées chaque
        nuit. <a href="/etat/">État des données</a>.
      </p>
      <p>Aucun commentaire politique : seulement des votes réels et leurs décomptes.</p>
    </footer>
    )}
    <script type="application/json" data-hors-matrice set:html={horsMatrice}></script>
    <script>
      import { reponses } from '../lib/navigateur.ts';
      import { precision } from '../lib/profil.ts';

      // L'anneau de précision de l'en-tête (frame V5) : calculé sur place, comme tout le profil.
      const anneau = document.querySelector<HTMLElement>('[data-anneau]');
      if (anneau) {
        const hors = new Set(JSON.parse(
          document.querySelector('[data-hors-matrice]')?.textContent ?? '[]') as string[]);
        const n = Object.keys(reponses()).filter((uid) => !hors.has(uid)).length;
        if (n > 0) {
          const pct = Math.round(100 * precision(n));
          anneau.style.setProperty('--pct', `${pct}%`);
          anneau.querySelector('[data-anneau-pct]')!.textContent = `${pct}%`;
          anneau.setAttribute('aria-label', `Précision de ton hémicycle : ${pct} %`);
          anneau.hidden = false;
        }
      }

      // Les formulaires « code postal » mènent à /deputes/#cp=… : le fragment n'est jamais
      // envoyé au serveur. Sans JavaScript, ils passent par ?cp=, que la page efface.
      for (const form of document.querySelectorAll<HTMLFormElement>('form[action="/deputes/"]')) {
        form.addEventListener('submit', (ev) => {
          ev.preventDefault();
          const cp = String(new FormData(form).get('cp') ?? '').trim();
          location.href = `/deputes/#cp=${encodeURIComponent(cp)}`;
        });
      }
    </script>
  </body>
</html>

<style>
  .evitement {
    position: absolute;
    left: 12px;
    top: -60px;
    padding: 10px 16px;
    border-radius: 12px;
    background: var(--violet);
    color: #fff;
    z-index: 20;
  }
  .evitement:focus { top: 12px; }

  .entete {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 12px var(--gouttiere);
    background: var(--fond);
    border-bottom: 2px solid var(--bord-leger);
  }
  .logo {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--texte);
    font-family: var(--police-titre);
    font-weight: 700;
    font-size: 23px;
  }
  .logo sup { font-size: 13px; }
  nav { margin: 0 auto; }
  nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 5px;
    list-style: none;
    border-radius: 18px;
    background: var(--fond-doux);
  }
  nav a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 14px;
    font-family: var(--police-titre);
    font-weight: 600;
    font-size: 16px;
    color: var(--gris);
    text-decoration: none;
  }
  nav a:hover { background: var(--fond); color: var(--gris); }
  nav a[aria-current='page'] {
    background: var(--fond);
    color: var(--violet-fonce);
    box-shadow: 0 3px 0 var(--bord);
  }
  .outils { flex: none; display: flex; align-items: center; gap: 16px; }
  .rond {
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    border: 2px solid var(--bord); background: var(--fond); color: var(--gris);
  }
  .rond:hover { background: var(--fond-doux); color: var(--gris); }
  .etoile { background: var(--jaune-pale); border-color: var(--abstention); }
  .etoile:hover { background: #FFE7A3; }
  .anneau {
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: conic-gradient(var(--violet) 0 var(--pct, 0%), var(--bord-leger) var(--pct, 0%) 100%);
    text-decoration: none; color: var(--texte);
  }
  .anneau span {
    display: flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 50%; background: var(--fond);
    font-family: var(--police-titre); font-weight: 700; font-size: 11px;
  }
  @media (max-width: 900px) {
    .texte-onglet { display: none; }
  }
  @media (max-width: 640px) {
    .entete { position: static; flex-wrap: wrap; gap: 12px; justify-content: space-between; }
    nav { order: 3; width: 100%; }
    nav ul { justify-content: space-between; }
    nav li { flex: 1; }
    nav a { flex-direction: column; gap: 2px; padding: 6px 4px; font-size: 13px;
      justify-content: center; text-align: center; }
    .texte-onglet { display: inline; }
    .outils { gap: 10px; }
  }

  /* Mode focus (quiz, séance) : la page tient dans l'écran, contenu centré (frames V5). */
  body.focus { min-height: 100vh; display: flex; flex-direction: column; }
  .entete.focus { position: static; flex-wrap: wrap; gap: 16px 32px; padding: 18px clamp(16px, 3.4vw, 48px);
    border-bottom: 0; }
  .entete.focus .logo span { font-size: 24px; letter-spacing: -0.01em; }
  .entete.focus .logo sup { font-size: 14px; }
  .pied-focus { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; width: 100%;
    max-width: 1320px; margin: 0 auto; padding: 16px clamp(16px, 3.4vw, 48px) 22px; font-size: 13px; color: #8A91A3; }
  .pied-focus a { color: inherit; }

  .pied {
    max-width: 1320px;
    margin: 0 auto;
    padding: 24px var(--gouttiere) 40px;
    border-top: 2px solid var(--bord-leger);
    color: var(--gris);
    font-size: 15px;
  }
  .pied p { margin: 0 0 6px; }
</style>
