---
// La page introuvable (VDEF, gabarit des pages de service, lot V9) : un siège vide, et où aller.
import PageService from '../components/vdef/PageService.astro';
import Bouton from '../components/vdef/Bouton.astro';
---
<PageService titre="Ce siège est vide" description="Cette page n'existe pas." noindex
  chapeau="La page demandée n’existe pas, ou plus. Le vote ou le député que tu cherches est peut-être ailleurs.">
  <section>
    <div class="liens">
      <Bouton href="/explorer/">La galerie : tous les votes</Bouton>
      <Bouton href="/deputes/" variante="contour">Trouver ton député</Bouton>
      <Bouton href="/" variante="contour">La tribune</Bouton>
    </div>
  </section>
</PageService>

<style>
  .liens { display: flex; flex-wrap: wrap; gap: 10px; }
</style>
