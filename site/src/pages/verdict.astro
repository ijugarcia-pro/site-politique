---
// Le verdict de la séance de la semaine (t25, frame V5 « ⑧ Verdict ») : adopté ou rejeté, à
// combien de voix près, et ta place dans le résultat : ton vote, ton pronostic, ta voix de
// 578e, ton député et ton jumeau. Formulation du délai : « le verdict du matin » (décision de
// t10, en attendant la mesure du délai de publication) — le scrutin est récupéré la nuit, et
// les soirs de vote solennel à chaque heure (soiree.yml). Pas de comparaison avec les
// utilisateurs du site : il faudrait des agrégats (reportés). Tant que la séance n'est tranchée
// qu'en partie, un bandeau le dit et chaque vote à venir garde une étape en pointillés (retour de
// Julien du 12 octobre 2026) : la page ne laisse pas croire que la séance est finie.
import Base from '../layouts/Base.astro';
import Salle from '../components/Salle.astro';
import Salle3D from '../components/Salle3D.astro';
import { avancementSeance, composition, dateLisible, lienVote, quandVote, questionSeance,
  scrutinPublie, semaine, voteJuge } from '../lib/donnees.ts';
import { marge, verdict } from '../lib/votes.ts';
import { puceTheme } from '../lib/themes.ts';

const sem = semaine();
const compo = composition();
const LETTRES: Record<string, string> = { pour: 'P', contre: 'C', abstention: 'A',
  non_votant: 'N', absent: '-' };
const seance = sem.votes.filter((v) => v.statut !== 'retiré');
const verdicts = seance.flatMap((v) => {
  const s = voteJuge(v) ? scrutinPublie(v.scrutin!.uid) : null;
  if (!s) return [];
  const votes = new Map(s.sieges.filter((x) => x.depute).map((x) => [x.depute!, x]));
  return [{
    cle: v.cle, uid: s.uid, numero: s.numero, titre: questionSeance(v).titre,
    theme: v.carte?.theme ?? 'Vote solennel',
    puce: v.carte ? puceTheme(v.carte.theme) : '#EFE9FF:#5B33D6',
    quand: `${s.solennel ? 'Scrutin solennel' : 'Vote'} du ${dateLisible(s.date)}`,
    verdict: verdict(s), adopte: s.sort === 'adopté', marge: marge(s), decompte: s.decompte,
    requis: s.requis, lien: lienVote(s),
    sieges: compo.sieges.map((c) => {
      if (c.vacant || !c.depute) return 'V';
      const x = votes.get(c.depute);
      if (!x) return 'x';
      const l = LETTRES[x.vote ?? 'absent'] ?? '-';
      return x.dissident ? l.toLowerCase() : l;
    }).join(''),
  }];
});
const attendus = sem.votes.filter((v) => v.type === 'annonce' && v.statut === 'à venir');
const etape = avancementSeance(sem);
// Une étape par vote de la séance, dans son ordre : le verdict s'il est tombé (`k` : son rang
// parmi les verdicts), sinon une étape en pointillés.
const onglets = seance.map((v) => ({ titre: questionSeance(v).titre,
  k: verdicts.findIndex((x) => x.cle === v.cle) }));
const donnees = JSON.stringify({ lundi: sem.lundi, verdicts }).replace(/</g, '\\u003c');
---
<Base titre="Le verdict" onglet="semaine" theme="seance"
  description="Le verdict des votes de la semaine à l'Assemblée, face à tes réponses.">
  <p class="fil"><a href="/">Cette semaine</a> › Verdict</p>
  {verdicts.length > 0 && (
    <Salle3D titre="La salle de l'Assemblée nationale : chaque voyant de pupitre s'allume à la couleur du vote du député (pour, contre, abstention) ; éteint, il n'a pas pris part au vote."
      cameras={['salle', 'plan']} hauteur="min(60vh, 560px)" />
  )}
  {verdicts.length === 0 ? (
    <section class="attente">
      <h1>Pas encore de verdict</h1>
      {attendus.length > 0 ? (
        <>
          <p>Les députés n'ont pas encore voté :</p>
          <ul>
            {attendus.map((v) => <li><strong>{questionSeance(v).titre}</strong> · {quandVote(v)}</li>)}
          </ul>
          <p>Le verdict s'affiche ici le lendemain matin, dès que l'Assemblée publie le scrutin.</p>
          <a class="b-principal" href="/seance/">Trancher avant eux · 2 min</a>
        </>
      ) : (
        <>
          <p>Aucun vote de la séance de cette semaine n'a encore été tenu.</p>
          <a class="b-principal" href="/explorer/">Les derniers votes</a>
        </>
      )}
    </section>
  ) : (
    <>
    {etape.bandeau && (
      <p class="bandeau-etape" role="status">
        <strong>{etape.bandeau}</strong>
        <span>Leur verdict s'affiche ici le lendemain matin, dès que l'Assemblée publie le scrutin.</span>
      </p>
    )}
    <script is:inline define:vars={{ uids: verdicts.map((v) => v.uid) }}>
      // Un verdict pas encore découvert : il reste caché jusqu'au toucher (D1).
      try {
        const vus = JSON.parse(localStorage.getItem('578e.verdicts-vus.v1') || '[]');
        if (uids.some((u) => !vus.includes(u))) document.documentElement.classList.add('verdict-cache');
      } catch { document.documentElement.classList.add('verdict-cache'); }
    </script>
    <div class="verdict">
      <section class="gauche">
        <button type="button" class="b-passer-seq" data-passer-seq hidden>Passer</button>
        {onglets.length > 1 && (
          <nav class="etapes" aria-label="Les verdicts de ta séance">
            <p class="etapes-texte" data-etape-texte>Verdict {onglets.findIndex((o) => o.k === 0) + 1} sur {onglets.length}</p>
            <div class="segments">
              {onglets.map((o, n) => (o.k >= 0 ? (
                <button type="button" class="segment" data-onglet={o.k} data-rang={n + 1}
                  aria-current={o.k === 0 ? 'step' : undefined} aria-label={`Verdict ${n + 1} : ${o.titre}`}
                  title={o.titre}><span></span></button>
              ) : (
                <span class="segment a-venir" role="img" aria-label={`Vote ${n + 1} : ${o.titre}, verdict après le vote`}
                  title="Verdict après le vote"><span></span></span>
              )))}
            </div>
          </nav>
        )}
        {verdicts.map((v, k) => (
          <article class="un-verdict" data-verdict={k} hidden={k > 0}>
            <div class="puces">
              <span class="puce-theme" style={`background: ${v.puce.split(':')[0]}; color: ${v.puce.split(':')[1]}`}>{v.theme}</span>
              <span class="puce-date">{v.quand}</span>
            </div>
            <h1 tabindex="-1" data-titre-verdict>{v.titre}</h1>
            <div class="decouvrir" data-decouvrir>
              <button type="button" class="b-principal" data-decouvrir-bouton>Découvrir le verdict</button>
            </div>
            <div class="boite">
              <span class="tampon">{v.verdict}</span>
              <div class="bandeau">
                <div class="bandeau-ligne">
                  <span class="bandeau-etiquette">Verdict</span>
                  <span class="bandeau-titre">{v.verdict} <span class="marge" data-ecart>{v.marge ?? `${v.decompte.pour} – ${v.decompte.contre}`}</span></span>
                </div>
                <span class="bandeau-legende decompte">{v.decompte.pour} pour · {v.decompte.contre} contre · {v.decompte.abstention} abstention{v.decompte.abstention > 1 ? 's' : ''}{v.requis ? ` · majorité requise : ${v.requis}` : ''}</span>
              </div>
              <ul class="compteurs" aria-label="Le décompte">
                {([['pour', 'Pour', v.decompte.pour], ['contre', 'Contre', v.decompte.contre],
                  ['abstention', v.decompte.abstention > 1 ? 'Abstentions' : 'Abstention', v.decompte.abstention],
                  ['absent', v.decompte.absent > 1 ? 'Absents' : 'Absent', v.decompte.absent]] as const).map(([cle, mot, n]) => (
                  <li class={`compteur c-${cle}`}>
                    <span class="compteur-mot">{mot}</span>
                    <span class="chiffre" style={`--from:0;--to:${n}`}><span class="chiffre-texte">{n}</span></span>
                  </li>
                ))}
              </ul>
              {v.decompte.non_votant > 0 && <p class="non-votants">Non-votants : {v.decompte.non_votant} (présents, sans prendre part au vote)</p>}
            </div>
            <ul class="lignes" data-lignes={k}></ul>
            <div class="actions">
              {k < verdicts.length - 1
                ? <button type="button" class="b-principal" data-suivant={k + 1}>Verdict suivant →</button>
                : <a class="b-principal" href="/hemicycle/">Mon hémicycle →</a>}
              <a class="b-second" href={v.lien}>Tout le détail</a>
            </div>
          </article>
        ))}
      </section>
      <section class="panneau">
        <div class="panneau-tete">
          <h2>Comment l'Assemblée a voté</h2>
          <span data-signales>En couleur : pour, contre, abstention</span>
        </div>
        <div class="cadre-salle">
          <Salle sieges={compo.sieges} groupes={compo.groupes} titre="L'Assemblée nationale"
            chiffre="" legende="" />
        </div>
        <ul class="legende">
          <li><span style="background: var(--pour)"></span>Pour</li>
          <li><span style="background: var(--contre)"></span>Contre</li>
          <li><span style="background: var(--abstention)"></span>Abstention</li>
          <li><span style="background: var(--non-votant)"></span>Non-votant</li>
          <li><span style="background: var(--absent)"></span>Absent</li>
          <li><span class="anneau"></span>Contre son groupe</li>
        </ul>
      </section>
    </div>
    </>
  )}
  <script type="application/json" data-donnees-verdict set:html={donnees}></script>
</Base>

<script>
  import { deputeChoisi, reponses } from '../lib/navigateur.ts';
  import { profil, type Matrice } from '../lib/profil.ts';
  import { mouvementReduit, quandVisible, sequence } from '../lib/motion.ts';
  import { lireJSON } from '../lib/navigateur.ts';
  import { Salle } from '../lib/salle.ts';
  import { etatSeance } from '../lib/seances.ts';
  import { voix578 } from '../lib/votes.ts';
  import { salle3D } from '../salle3d/pilote.ts';

  interface Verdict {
    cle: string; uid: string; titre: string; verdict: string; adopte: boolean;
    decompte: { pour: number; contre: number; abstention: number }; requis: number | null;
    sieges: string;
  }
  const { lundi, verdicts } = JSON.parse(
    document.querySelector('[data-donnees-verdict]')!.textContent!) as { lundi: string; verdicts: Verdict[] };
  const racine = document.querySelector<HTMLElement>('[data-salle]');
  if (racine && verdicts.length) {
    const salle = new Salle(racine);
    // La salle 3D en tête de page : ses voyants prennent la couleur du vote de chaque député,
    // une fois le verdict découvert (rien avant le toucher).
    const scene = document.querySelector<HTMLElement>('[data-salle3d]');
    const s3 = scene ? salle3D(scene) : null;
    const VOYANTS: Record<string, string> = { P: '#2F7BFF', C: '#FF6A3D', A: '#FFC531' };
    const voyantsDe = (v: Verdict) => [...v.sieges].map((l) => VOYANTS[l.toUpperCase()] ?? null);
    // Absent et non-votant : les teintes « éteintes » du thème (styles/global.css).
    const COULEURS: Record<string, string> = { P: '#2F7BFF', C: '#FF6A3D', A: '#FFC531', N: 'var(--non-votant)', '-': 'var(--absent)' };
    const MOTS: Record<string, string> = { P: 'pour', C: 'contre', A: 'abstention' };
    const pluriel = (n: number, mot: string) => `${n} ${mot}${n > 1 ? 's' : ''}`;
    const seance = etatSeance(lundi);
    const mes = Object.fromEntries(Object.entries(reponses()).map(([k, r]) => [k, r.v]));
    const monDepute = deputeChoisi();
    let matrice: Matrice | null = null;
    const ICONES = {
      // Majorité ou minorité : la même pastille neutre, seul le pictogramme change (neutralité) ;
      // ta voix, en lumière.
      ok: ['#3A3D45', 'M5 10.5l3.5 3.5L15 7'], non: ['#3A3D45', 'M6 6l8 8M14 6l-8 8'],
      neutre: ['#3A3D45', 'M5 10h10'], prono: ['#3A3D45', 'M10 3l2 4.4 4.8.6-3.5 3.3.9 4.7L10 13.7 5.8 16l.9-4.7L3.2 8l4.8-.6z'],
      voix: ['#8A5A12', 'M3 15a7 7 0 0 1 14 0M7 15a3 3 0 0 1 6 0'],
    } as const;
    const ligne = (icone: keyof typeof ICONES, titre: string, detail: string) => {
      const li = document.createElement('li');
      const ic = document.createElement('span');
      ic.className = 'icone';
      ic.style.background = ICONES[icone][0];
      ic.innerHTML = `<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="${ICONES[icone][1]}" fill="none" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
      const t = document.createElement('span');
      const b = document.createElement('span');
      b.className = 'ligne-titre';
      b.textContent = titre;
      const d = document.createElement('span');
      d.className = 'ligne-detail';
      d.textContent = detail;
      t.append(b, d);
      li.append(ic, t);
      return li;
    };

    /** L'onglet k, et l'hémicycle de son vote ; `anime` : en onde, chiffres comptés (D1). */
    let onde: { passer(): void } | null = null;
    const peindre = (k: number, anime = false) => {
      const v = verdicts[k];
      for (const a of document.querySelectorAll<HTMLElement>('[data-verdict]')) a.hidden = a.dataset.verdict !== String(k);
      for (const o of document.querySelectorAll<HTMLElement>('[data-onglet]')) {
        if (o.dataset.onglet === String(k)) {
          o.setAttribute('aria-current', 'step');
          const texte = document.querySelector('[data-etape-texte]');
          if (texte) texte.textContent = texte.textContent!.replace(/\d+ sur/, `${o.dataset.rang} sur`);
        } else o.removeAttribute('aria-current');
      }
      onde?.passer();
      const rendu = (i: number) => {
        const brut = v.sieges[i];
        if (brut === 'x') return { sansCommun: true };
        const l = brut.toUpperCase();
        return { fond: COULEURS[l] ?? 'var(--absent)', contreGroupe: brut !== l };
      };
      const legende = `${v.adopte ? 'Adopté' : 'Rejeté'} · pour – contre`;
      if (anime) onde = salle.reveler(rendu, { pour: v.decompte.pour, contre: v.decompte.contre, legende, duree: 1000 });
      else {
        salle.colorer(rendu);
        salle.centre(`${v.decompte.pour} – ${v.decompte.contre}`, legende);
      }
      salle.libre(false);
      // La salle allumée (ambiance « verdict ») ; au toucher, les voyants s'allument en onde.
      if (!document.documentElement.classList.contains('verdict-cache')) {
        s3?.ambiance('verdict');
        if (anime) s3?.onde(voyantsDe(v), 1000); else s3?.voyants(voyantsDe(v));
      }
    };

    /** Les lignes de l'onglet k : ta place dans le résultat, ton pronostic, ta voix. */
    const remplir = (k: number) => {
      const v = verdicts[k];
      // Ta place dans le résultat.
      const a = mes[v.uid] ?? seance.reponses[v.cle] ?? null;
      const gagnant = v.adopte ? 'pour' : 'contre';
      const p = matrice ? profil(matrice, mes) : null;
      const k2 = matrice ? matrice.votes.indexOf(v.uid) : -1;
      const jumeau = p?.jumeau ?? null;
      const lettre = (s: string | undefined) => (k2 >= 0 && s ? s[k2] : '-');
      const depute = monDepute && matrice ? matrice.deputes.find((d) => d.u === monDepute) : null;
      salle.jumeau(jumeau?.ligne.u ?? null);
      // Dans la salle 3D : ta place est le siège de ton jumeau ; un repère dit vos deux votes.
      const kJumeau = jumeau ? salle.reglages.sieges.findIndex(([u]) => u === jumeau.ligne.u) : -1;
      s3?.jumeau(kJumeau >= 0 ? kJumeau : null);
      s3?.repere(kJumeau >= 0 ? kJumeau : null, kJumeau < 0 ? ''
        : `${a ? `Toi : ${a} · ` : ''}Ton jumeau : ${MOTS[lettre(jumeau!.ligne.s)] ?? 'absent'}`);
      const lignes = [];
      if (a) {
        const comme = a === 'pour' ? v.decompte.pour : v.decompte.contre;
        const jum = jumeau ? (MOTS[lettre(jumeau.ligne.s)] === a ? ', dont ton jumeau' : ', mais pas ton jumeau') : '';
        const dep = depute ? ` ; ton député, ${depute.n}, a voté ${MOTS[lettre(depute.s)] ?? 'absent'}` : '';
        lignes.push(ligne(a === gagnant ? 'ok' : 'non',
          `Tu avais voté ${a} : tu es ${a === gagnant ? 'du côté de la majorité' : 'dans la minorité'}`,
          `Comme ${comme} députés${jum}${dep}.`));
      } else {
        lignes.push(ligne('neutre', 'Tu n’avais pas tranché ce vote',
          depute ? `Ton député, ${depute.n}, a voté ${MOTS[lettre(depute.s)] ?? 'absent'}.` : 'Il ne compte pas dans ton hémicycle.'));
      }
      const pr = seance.pronostics[v.cle];
      if (pr) {
        const juste = (pr === 'adopte') === v.adopte;
        lignes.push(ligne('prono', `Pronostic ${juste ? 'juste' : 'raté'} : tu avais dit « ${pr === 'adopte' ? 'adopté' : 'rejeté'} »`,
          'Ton pronostic reste dans ton navigateur, comme tes réponses.'));
      }
      if (a) {
        // Le décompte et la marge avec ta voix : la majorité requise est recalculée (lib/votes.ts).
        const x = voix578(v.decompte, v.requis, a);
        const avec = `Avec la tienne : ${v.decompte.pour + (a === 'pour' ? 1 : 0)} pour, ${v.decompte.contre + (a === 'contre' ? 1 : 0)} contre`;
        lignes.push(ligne('voix', 'Ta voix de 578e', !x ? `${avec}.`
          : x.adopte !== v.adopte
            ? `${avec} : ta voix aurait changé le résultat, le texte aurait été ${x.adopte ? 'adopté' : 'rejeté'}.`
            : `${avec}. Il aurait alors suffi que ${pluriel(x.inverser, 'député')} change${x.inverser > 1 ? 'nt' : ''} d’avis pour que le texte soit ${x.adopte ? 'rejeté' : 'adopté'}.`));
      }
      document.querySelector(`[data-lignes="${k}"]`)!.replaceChildren(...lignes);
      const sig = [jumeau ? 'ton jumeau signalé' : null].filter(Boolean);
      document.querySelector('[data-signales]')!.textContent = sig.length ? 'En couleur : pour, contre ; ' + sig.join(', ') : 'En couleur : pour, contre, abstention';
    };

    const html = document.documentElement;
    /** Passer à un autre verdict : il s'affiche en haut de page, l'étape reste visible. */
    const aller = (k: number, depuisSuivant: boolean) => {
      if (html.classList.contains('verdict-cache')) return;
      peindre(k);
      remplir(k);
      if (!depuisSuivant) return;
      window.scrollTo({ top: 0, behavior: 'instant' });
      const article = document.querySelector<HTMLElement>(`[data-verdict="${k}"]`)!;
      article.classList.remove('arrive');
      void article.offsetWidth;
      article.classList.add('arrive');
      article.querySelector<HTMLElement>('[data-titre-verdict]')?.focus({ preventScroll: true });
    };
    for (const o of document.querySelectorAll<HTMLElement>('[data-onglet]')) {
      o.addEventListener('click', () => aller(Number(o.dataset.onglet), false));
    }
    for (const b of document.querySelectorAll<HTMLElement>('[data-suivant]')) {
      b.addEventListener('click', () => aller(Number(b.dataset.suivant), true));
    }

    // D1 : un verdict pas encore découvert attend le toucher. Avant, l'hémicycle est gris et
    // « respire », un « ? » au centre ; aucun compte à rebours, aucune attente imposée.
    const VUS = '578e.verdicts-vus.v1';
    const vus = lireJSON<string[]>(VUS, []);
    const k0 = verdicts.findIndex((v) => !vus.includes(v.uid));
    if (k0 < 0) {
      html.classList.remove('verdict-cache');
      peindre(0);
      remplir(0);
    } else {
      html.classList.add('verdict-cache');
      peindre(k0);
      remplir(k0);
      onde?.passer();
      salle.colorer(() => ({ fond: 'var(--siege-repos)' }));
      salle.centre('?', 'Le verdict est tombé');
      const svg = racine.querySelector('[data-salle-svg]')!;
      // La respiration attend, à l'arrêt, que l'hémicycle soit à l'écran (règle 6).
      svg.classList.add('respire');
      quandVisible(svg, () => svg.classList.add('a-l-ecran'));
      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-decouvrir-bouton]')) {
        b.addEventListener('click', () => decouvrir(k0, svg));
      }
    }

    /** D1 + D3 : l'hémicycle en ondes (1 s), puis la carte sombre et son tampon, le chiffre de
     *  l'écart qui grossit une fois, et tes lignes avec « Ta voix de 578e ». ADOPTÉ et REJETÉ :
     *  la même chose. « Passer » ou un appui sur l'écran donnent l'état final. */
    const decouvrir = (k: number, svg: Element) => {
      try { localStorage.setItem(VUS, JSON.stringify([...new Set([...vus, ...verdicts.map((v) => v.uid)])])); } catch { /* */ }
      svg.classList.remove('respire');
      html.classList.remove('verdict-cache');
      const article = document.querySelector<HTMLElement>(`[data-verdict="${k}"]`)!;
      const conteneur = document.querySelector<HTMLElement>('.verdict')!;
      const bouton = document.querySelector<HTMLElement>('[data-passer-seq]')!;
      article.querySelector<HTMLElement>('[data-titre-verdict]')?.focus({ preventScroll: true });
      const montrer = (sel: string) => article.querySelector(sel)?.classList.add('apparait');
      const finir = () => {
        article.classList.remove('en-revelation');
        bouton.hidden = true;
        document.removeEventListener('click', appui);
      };
      const appui = () => { onde?.passer(); suite.passer(); };
      if (mouvementReduit()) conteneur.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 200 });
      else {
        article.classList.add('en-revelation');
        bouton.hidden = false;
        setTimeout(() => document.addEventListener('click', appui), 0);
      }
      const suite = sequence([
        { a: 0, faire: () => peindre(k, true) },
        { a: 1000, faire: () => montrer('.boite') },
        { a: 1500, faire: () => { montrer('.lignes'); montrer('.actions'); } },
        { a: 1550, faire: () => article.querySelector('[data-ecart]')?.classList.add('grossit') },
        { a: 1950, faire: finir },
      ], conteneur);
    };

    if (Object.keys(mes).length || monDepute) {
      fetch('/donnees/matrice.json').then((r) => r.json()).then((m: Matrice) => {
        matrice = m;
        const actif = document.querySelector<HTMLElement>('[data-onglet][aria-current="step"]');
        remplir(Number(actif?.dataset.onglet ?? (k0 < 0 ? 0 : k0)));
      }).catch(() => {});
    }
  }
</script>

