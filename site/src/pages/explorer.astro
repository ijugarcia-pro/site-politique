---
// La galerie (VDEF, captures 13 et T4 ; lot V7), à l'adresse /explorer/ : la recherche (votes et
// députés), les 12 thèmes et leurs dossiers, les votes qui divisent, les plus serrés, puis tous
// les votes, filtrables (tous, solennels, tranchés par toi, pas encore tranchés). Un vote sans
// carte n'a pas de thème : il n'est que dans « Tous les votes » (le classement de tous les votes
// par thème est la tâche t28). Tes réponses sont lues dans le navigateur.
import Base from '../layouts/Base.astro';
import Bouton from '../components/vdef/Bouton.astro';
import { cartesParVote, dateLisible, lienVote, majuscule, scrutins } from '../lib/donnees.ts';
import { slugTheme, THEMES } from '../lib/themes.ts';
import { marge, normaliser, verdict } from '../lib/votes.ts';

const tous = scrutins();
const cartes = cartesParVote();
const avecPage = new Set(tous.map((v) => v.uid));
const parTheme = THEMES.map((t) => ({ theme: t,
  n: [...cartes.values()].filter((c) => c.theme === t && avecPage.has(c.uid)).length }));
// Un seul vote par dossier dans les deux encarts : les lectures successives d'un même texte
// ne doivent pas occuper toute la liste.
const unParDossier = (liste: typeof tous) => {
  const vus = new Set<string>();
  return liste.filter((v) => {
    const cle = v.dossier ?? v.uid;
    if (vus.has(cle)) return false;
    vus.add(cle);
    return true;
  });
};
const titreDe = (v: (typeof tous)[number]) => {
  const q = cartes.get(v.uid)?.question;
  return q ? q.replace(/ ([?!:;])/g, ' $1') : majuscule(v.titre).replace(/\.$/, '');
};
const divisent = unParDossier([...tous].filter((v) => v.dissidents > 0).sort((a, b) => b.dissidents - a.dissidents)).slice(0, 3);
const serres = unParDossier(tous
  .filter((v) => !v.motion_censure && v.voix_pour_inverser && v.voix_pour_inverser > 0)
  .sort((a, b) => a.voix_pour_inverser! - b.voix_pour_inverser! || b.numero - a.numero))
  .slice(0, 3);
const MOIS = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'];
const dateCourte = (iso: string) => `${Number(iso.slice(8, 10))} ${MOIS[Number(iso.slice(5, 7)) - 1]} ${iso.slice(0, 4)}`;
const PAR_PAGE = 20;
---
<Base titre="La galerie" gabarit="lecture" vue="tribune" bas="galerie"
  description="Tous les votes de l'Assemblée nationale de la 17e législature : chercher un vote ou un député, les thèmes, les votes qui divisent, les plus serrés.">
  <header class="entete">
    <div>
      <span class="t-etiquette">La galerie du public · ouverte à tous</span>
      <h1 class="t-ecran">Tous les votes de la législature</h1>
    </div>
    <Bouton href="/deputes/" variante="contour" class="trouver">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
      Trouver ton député
    </Bouton>
  </header>

  <div class="recherche-bloc">
    <label class="recherche">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
      <span class="visuellement-cache">Chercher un vote ou un député</span>
      <input type="search" id="recherche" placeholder="Une loi, un mot, un député…" autocomplete="off" aria-controls="liste" />
    </label>
    <div class="res-deputes" data-res-deputes hidden>
      <p class="t-etiquette">Députés</p>
      <ul data-res-liste></ul>
    </div>
  </div>

  <section class="bloc" aria-labelledby="titre-themes">
    <h2 id="titre-themes" class="t-section">Par thème</h2>
    <ul class="themes">
      {parTheme.map((t) => (
        <li><a href={`/dossiers/${slugTheme(t.theme)}/`}><span class="theme-nom">{t.theme}</span><span class="t-legende">{t.n} vote{t.n > 1 ? 's' : ''}</span></a></li>
      ))}
    </ul>
  </section>

  <div class="duo">
    <section class="bloc" aria-labelledby="titre-divisent">
      <div><h2 id="titre-divisent" class="t-section">Les votes qui divisent</h2><p class="t-legende">Des députés ont voté contre leur propre groupe</p></div>
      <ul class="courte">
        {divisent.map((v) => (
          <li><a href={lienVote(v)}><span class="c-texte"><span class="c-titre">{titreDe(v)}</span><span class="t-legende">{dateLisible(v.date)} · {verdict(v)}</span></span><span class="badge">{v.dissidents} contre leur groupe</span></a></li>
        ))}
      </ul>
    </section>
    <section class="bloc" aria-labelledby="titre-serres">
      <div><h2 id="titre-serres" class="t-section">Les plus serrés</h2><p class="t-legende">Le moins de voix pour faire basculer le résultat</p></div>
      <ul class="courte">
        {serres.map((v) => (
          <li><a href={lienVote(v)}><span class="c-texte"><span class="c-titre">{titreDe(v)}</span><span class="t-legende">{dateLisible(v.date)} · {verdict(v)}</span></span><span class="badge">{marge(v)}</span></a></li>
        ))}
      </ul>
    </section>
  </div>

  <section class="bloc" id="tous" aria-labelledby="titre-tous">
    <div class="titre-ligne">
      <h2 id="titre-tous" class="t-section">Tous les votes</h2>
      <span class="t-legende" aria-live="polite" data-compte>Du plus récent au plus ancien</span>
    </div>
    <div class="filtres" role="group" aria-label="Filtrer les votes">
      <button type="button" class="filtre" data-filtre="" aria-pressed="true">Tous · <span>{tous.length}</span></button>
      <button type="button" class="filtre" data-filtre="solennels" aria-pressed="false">Solennels · <span>{tous.filter((v) => v.solennel).length}</span></button>
      <button type="button" class="filtre" data-filtre="tranches" aria-pressed="false">Tranchés par toi · <span data-n-tranches>0</span></button>
      <button type="button" class="filtre" data-filtre="a-trancher" aria-pressed="false">Pas encore tranchés · <span data-n-a-trancher>{tous.filter((v) => !v.motion_censure).length}</span></button>
    </div>
    <ul class="liste" id="liste">
      {tous.map((v, k) => {
        const carte = cartes.get(v.uid);
        const d = v.decompte;
        return (
          <li data-uid={v.uid} data-solennel={v.solennel ? '1' : undefined} data-censure={v.motion_censure ? '1' : undefined}
            data-recherche={normaliser(`${v.titre} ${v.dossier ?? ''} ${carte?.question ?? ''} ${carte?.theme ?? ''} ${v.numero}`)}
            hidden={k >= PAR_PAGE}>
            <a href={lienVote(v)}>
              <span class="l-date t-legende">{dateCourte(v.date)}</span>
              <span class="l-texte"><span class="l-titre">{titreDe(v)}</span>{carte && <span class="t-legende">{carte.theme}</span>}</span>
              <span class="l-barre" aria-hidden="true">
                {d.pour > 0 && <span class="point pour" style={`flex: ${d.pour}`}></span>}
                {d.contre > 0 && <span class="point contre" style={`flex: ${d.contre}`}></span>}
                {d.abstention > 0 && <span class="point abstention" style={`flex: ${d.abstention}`}></span>}
                {d.absent + d.non_votant > 0 && <span class="point absent" style={`flex: ${d.absent + d.non_votant}`}></span>}
              </span>
              <span class="l-issue"><span class="issue">{verdict(v)}</span><span class="t-legende">{v.motion_censure ? `${d.pour} pour` : `${d.pour} – ${d.contre}`}</span></span>
              <span class="l-etat t-legende" data-etat>{v.motion_censure ? '' : 'À trancher'}</span>
            </a>
          </li>
        );
      })}
    </ul>
    <p class="t-texte" data-vide hidden>Aucun vote ne correspond. Essaie un autre mot.</p>
    <Bouton variante="contour" data-plus>Afficher {PAR_PAGE} votes de plus</Bouton>
  </section>
</Base>

<script>
  import { reponses } from '../lib/navigateur.ts';
  import { normaliser } from '../lib/votes.ts';

  const PAR_PAGE = 20;
  document.addEventListener('astro:page-load', () => {
    const champ = document.querySelector<HTMLInputElement>('#recherche');
    const liste = document.querySelector('#liste');
    if (!champ || !liste) return;
    const mes = reponses();
    const lignes = [...liste.querySelectorAll<HTMLElement>(':scope > li')];
    for (const l of lignes) {
      if (!mes[l.dataset.uid ?? '']?.v) continue;
      l.dataset.repondu = '1';
      l.querySelector('[data-etat]')!.textContent = 'Tranché';
    }
    const aTrancher = (l: HTMLElement) => !l.dataset.repondu && !l.dataset.censure;
    document.querySelector('[data-n-tranches]')!.textContent = String(lignes.filter((l) => l.dataset.repondu).length);
    document.querySelector('[data-n-a-trancher]')!.textContent = String(lignes.filter(aTrancher).length);

    const boutons = [...document.querySelectorAll<HTMLButtonElement>('[data-filtre]')];
    const compte = document.querySelector<HTMLElement>('[data-compte]')!;
    const vide = document.querySelector<HTMLElement>('[data-vide]')!;
    const plus = document.querySelector<HTMLButtonElement>('[data-plus]')!;
    let filtre = location.hash === '#a-trancher' ? 'a-trancher' : '';
    let limite = PAR_PAGE;
    const appliquer = () => {
      const mots = normaliser(champ.value).split(' ').filter(Boolean);
      const retenues = lignes.filter((l) => {
        const bon = !filtre || (filtre === 'solennels' ? l.dataset.solennel === '1'
          : filtre === 'tranches' ? !!l.dataset.repondu : aTrancher(l));
        return bon && mots.every((m) => (l.dataset.recherche ?? '').includes(m));
      });
      for (const l of lignes) l.hidden = true;
      retenues.slice(0, limite).forEach((l) => { l.hidden = false; });
      const n = retenues.length;
      compte.textContent = n === lignes.length ? 'Du plus récent au plus ancien' : `${n} vote${n > 1 ? 's' : ''} sur ${lignes.length}`;
      vide.hidden = n > 0;
      plus.hidden = n <= limite;
      plus.textContent = `Afficher ${Math.min(PAR_PAGE, n - limite)} votes de plus`;
      for (const b of boutons) b.setAttribute('aria-pressed', String((b.dataset.filtre ?? '') === filtre));
    };
    for (const b of boutons) b.addEventListener('click', () => { filtre = b.dataset.filtre ?? ''; limite = PAR_PAGE; appliquer(); });
    plus.addEventListener('click', () => {
      const premiere = lignes.filter((l) => !l.hidden).length;
      limite += PAR_PAGE;
      appliquer();
      lignes.filter((l) => !l.hidden)[premiere]?.querySelector('a')?.focus();
    });

    // Les députés qui correspondent à la recherche ; la liste n'est chargée qu'à la première.
    type D = { u: string; n: string; g: string | null; c: string; d: string; e?: 1 };
    let deputes: (D & { r: string })[] | null = null;
    const bloc = document.querySelector<HTMLElement>('[data-res-deputes]')!;
    const ul = document.querySelector<HTMLElement>('[data-res-liste]')!;
    const chercherDeputes = async () => {
      const mots = normaliser(champ.value).split(' ').filter(Boolean);
      if (mots.join('').length < 3) { bloc.hidden = true; return; }
      if (!deputes) {
        try {
          const brut: D[] = await (await fetch('/donnees/deputes.json')).json();
          deputes = brut.map((x) => ({ ...x, r: normaliser(`${x.n} ${x.g ?? ''} ${x.d}`) }));
        } catch { return; }
      }
      const trouves = deputes.filter((x) => mots.every((m) => x.r.includes(m))).sort((a, b) => (b.e ?? 0) - (a.e ?? 0)).slice(0, 6);
      ul.replaceChildren(...trouves.map((x) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/deputes/${x.u}/`;
        const nom = document.createElement('strong');
        nom.textContent = x.n;
        a.append(nom, ` · ${x.g ?? 'sans groupe'} · ${x.d}${x.e ? '' : ' · ancien député'}`);
        li.append(a);
        return li;
      }));
      bloc.hidden = trouves.length === 0;
    };
    champ.addEventListener('input', () => { limite = PAR_PAGE; appliquer(); void chercherDeputes(); });
    // La loupe de la barre du haut mène ici : le champ est prêt à recevoir la saisie.
    if (location.hash === '#recherche') champ.focus();
    appliquer();
    if (filtre) document.querySelector('#tous')?.scrollIntoView({ block: 'start' });
  });
</script>

<style>
  .entete { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .entete > div { display: flex; flex-direction: column; gap: 8px; }
  .recherche-bloc { display: flex; flex-direction: column; gap: 10px; }
  .recherche {
    display: flex; align-items: center; gap: 12px; min-height: 60px; padding: 0 22px;
    border-radius: var(--pilule); background: var(--surface); color: var(--texte-2);
  }
  .recherche:focus-within { box-shadow: inset 0 0 0 2px var(--encre); }
  .recherche input { flex: 1; min-width: 0; border: 0; outline: none; background: transparent; font: 500 18px/1 var(--police-texte); color: var(--encre); }
  .res-deputes { padding: 12px 18px; border-radius: 16px; border: 1px solid var(--filet); }
  .res-deputes ul { list-style: none; margin: 6px 0 0; padding: 0; }
  .res-deputes :global(a) { display: block; padding: 8px 0; color: var(--encre); text-decoration: none; font: 500 15px/1.3 var(--police-texte); }
  .res-deputes :global(a:hover) { text-decoration: underline; }
  .bloc { display: flex; flex-direction: column; gap: 14px; }
  .themes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; }
  .themes a { display: flex; flex-direction: column; gap: 4px; padding: 16px; border-radius: 16px; background: var(--surface); color: var(--encre); text-decoration: none; }
  .themes a:hover { box-shadow: inset 0 0 0 2px var(--encre); }
  .theme-nom { font: 700 16px/1.2 var(--police-texte); }
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .courte { list-style: none; margin: 0; padding: 0; }
  .courte li { border-top: 1px solid var(--filet); }
  .courte a { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 0; color: var(--encre); text-decoration: none; }
  .courte a:hover .c-titre { text-decoration: underline; }
  .c-texte { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .c-titre { font: 600 15px/1.35 var(--police-texte); }
  .badge { flex: 0 0 auto; padding: 7px 12px; border-radius: var(--pilule); background: var(--surface); font: 600 13px/1 var(--police-texte); white-space: nowrap; }
  .titre-ligne { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .filtres { display: flex; flex-wrap: wrap; gap: 8px; }
  .filtre {
    min-height: 44px; padding: 0 16px; border-radius: var(--pilule); border: 1px solid var(--bord);
    background: var(--feuille); color: var(--encre); font: 600 14px/1 var(--police-texte); cursor: pointer;
  }
  .filtre[aria-pressed='true'] { background: var(--encre); border-color: var(--encre); color: var(--feuille); }
  .liste { list-style: none; margin: 0; padding: 0; }
  .liste li { border-top: 1px solid var(--filet); }
  .liste a {
    display: grid; grid-template-columns: 80px minmax(0, 1fr) 160px 120px 90px; align-items: center; gap: 16px;
    padding: 14px 4px; color: var(--encre); text-decoration: none;
  }
  .liste a:hover { background: var(--surface); }
  .l-texte { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .l-titre { font: 600 15px/1.35 var(--police-texte); }
  .l-barre { display: flex; gap: 2px; height: 8px; border-radius: var(--pilule); overflow: hidden; background: var(--surface); }
  .l-barre .point { width: auto; height: auto; border-radius: 0; }
  .l-issue { display: flex; flex-direction: column; gap: 2px; }
  .issue { font: 800 17px/1.1 var(--police-titre); }
  @media (max-width: 1000px) {
    .themes { grid-template-columns: repeat(3, 1fr); }
    .duo { grid-template-columns: 1fr; }
    .liste a { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'texte issue' 'barre barre' 'date etat'; gap: 8px 12px; }
    .l-texte { grid-area: texte; }
    .l-issue { grid-area: issue; text-align: right; }
    .l-barre { grid-area: barre; }
    .l-date { grid-area: date; }
    .l-etat { grid-area: etat; text-align: right; }
  }
  @media (max-width: 520px) { .themes { grid-template-columns: repeat(2, 1fr); } }
</style>
