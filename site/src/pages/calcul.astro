---
// « Comment c'est calculé » (t34 ; VDEF, capture 18, lot V9) : les définitions exactes du site
// (CLAUDE.md, décisions du 22 oct. 2026 : le jumeau en votes identiques, les paliers), avec des
// exemples chiffrés. L'exemple des voix qui font basculer un résultat vient d'un vrai scrutin ;
// l'exemple du jumeau est un calcul d'école, présenté comme tel. La section « Tes données »
// (#tes-donnees) télécharge tes réponses (un fichier fait dans le navigateur) ou les efface.
import PageService from '../components/vdef/PageService.astro';
import Bouton from '../components/vdef/Bouton.astro';
import { dateLisible, lienVote, lotsDeVotes, lotsDuParcours, questionsQuiz, scrutins } from '../lib/donnees.ts';
import { PALIERS, SEUIL_DOSSIER } from '../lib/paliers.ts';
import { INTENSITES, NIVEAUX, precision, VOTES_FIABLES } from '../lib/profil.ts';
import { bascule } from '../lib/votes.ts';

const exemple = scrutins().find((v) => v.solennel && !v.motion_censure && v.requis
  && v.voix_pour_inverser && v.sort === 'adopté')!;
const P = exemple.decompte.pour;
const R = exemple.requis!;
const pourcent = (x: number) => `${Math.round(100 * x)} %`;
// Les étapes de la précision : après le quiz, puis après chaque lot (parcours et facultatifs).
const lots = lotsDeVotes();
const parLot = lots[0].length;
const parcours = lotsDuParcours();
const facultatifs = lots.length - parcours;
const etapes = [0, ...lots].map((_, k) => questionsQuiz().length + parLot * k);
const niveaux = NIVEAUX.map((t, k) => ({
  libelle: t.libelle, couleur: INTENSITES[k],
  borne: k === 0 ? `moins de ${Math.round(100 * t.jusqua)} % de tes votes`
    : t.jusqua === Infinity ? `${Math.round(100 * NIVEAUX[k - 1].jusqua)} % et plus`
    : `de ${Math.round(100 * NIVEAUX[k - 1].jusqua)} à ${Math.round(100 * t.jusqua)} %`,
}));
const TEXTES_PALIERS: Record<string, string> = {
  place: 'ton personnage s’assoit sur le siège de ton jumeau, et la vue « Ta place » s’ouvre',
  'salle-eclairee': 'dans la salle, chaque siège s’éclaire selon ses votes comme toi ; ta place est dite fiable',
  bilan: 'ton année à l’Assemblée, en cinq images à partager si tu veux',
};
---
<PageService titre="Comment c’est calculé" actif="calcul"
  description="Les définitions exactes du 578e siège : ton jumeau, ta place, les paliers, « à N voix près », les votes contre son groupe, la précision."
  chapeau="Tout est calculé dans ton navigateur, à partir de vrais votes de l’Assemblée nationale. Aucun axe gauche-droite : seulement des votes comparés un par un.">
  <section id="jumeau">
    <h2>Ton jumeau</h2>
    <p>C’est le député en exercice qui a voté comme toi sur le plus grand nombre de <strong>tes</strong> votes tranchés (pour ou contre ; « Je ne sais pas » ne compte pas). Une absence ne compte pas comme un accord. À égalité, celui qui a le moins voté l’inverse de toi passe devant, puis l’ordre alphabétique. Il est montré dès un vote identique, avec le nombre de députés à égalité s’il y en a.</p>
    <div class="exemple">
      <p class="exemple-titre">Exemple (chiffres d’école)</p>
      <p>Tu as tranché 20 votes. A a voté comme toi 15 fois, autrement 3 fois, et n’a pas voté 2 fois. B a voté comme toi 9 fois, autrement 1 fois, et n’a pas voté 10 fois. Ton jumeau est A : 15 votes comme toi sur 20, contre 9 sur 20 pour B, même si B n’a presque jamais voté autrement que toi : B n’a pas voté la moitié du temps.</p>
    </div>
    <p><strong>Ton opposé</strong> est celui qui a voté autrement que toi le plus de fois (le vote inverse, ou une abstention) ; un député toujours absent ne l’est jamais. Les <strong>groupes les plus proches</strong> se classent de la même façon, sur la position de chaque groupe.</p>
  </section>

  <section id="accord">
    <h2>« X votes comme toi sur N »</h2>
    <p>Sur chacun de tes <em>N</em> votes tranchés, un député (ou un groupe) a voté <strong>comme toi</strong>, <strong>autrement</strong> (le vote inverse, ou une abstention), ou <strong>n’a pas voté</strong> (absent, non-votant, ou pas encore élu). Le site écrit donc « <em>X</em> votes comme toi sur <em>N</em> » ; une part, quand il en faut une, est <em>X</em> / <em>N</em>. Dans la salle éclairée, chaque siège prend une intensité selon cette part :</p>
    <ul class="niveaux">
      {niveaux.map((t) => <li><span style={`background: ${t.couleur}`}></span><span class="texte-niveau"><strong>{t.libelle}</strong> : {t.borne}</span></li>)}
    </ul>
  </section>

  <section id="place">
    <h2>Ta place et les paliers</h2>
    <p>Ta place est le siège de ton jumeau : ton personnage s’y assoit. Ce qui s’ouvre dépend du nombre de votes que tu tranches, jamais de ce que tu réponds :</p>
    <ul>
      {PALIERS.map((p) => <li><strong>{p.seuil} votes · {p.libelle}</strong> : {TEXTES_PALIERS[p.id]}.</li>)}
      <li><strong>{SEUIL_DOSSIER} votes sur un thème</strong> : la synthèse personnelle de son dossier (ton jumeau sur ce thème, ta part avec la majorité).</li>
    </ul>
    <p>Tout ce qui est public (les votes, les verdicts, les députés, la salle) est ouvert dès le départ. Pas de points, pas de classement entre utilisateurs, pas de badge lié à une opinion.</p>
  </section>

  <section id="precision">
    <h2>La précision</h2>
    <p>Avec <em>n</em> votes tranchés, la précision vaut <strong>1 − e<sup>−n/20</sup></strong> : elle monte vite au début, puis plus lentement. Ta place est dite fiable à {VOTES_FIABLES} votes, ceux du quiz et des {parcours} lots de {parLot} votes qui le suivent ({pourcent(precision(VOTES_FIABLES))}). {facultatifs > 0 && `Les ${facultatifs} lots facultatifs l’affinent ensuite, jusqu’à ${pourcent(precision(etapes[etapes.length - 1]))} après ${etapes[etapes.length - 1]} votes.`}</p>
    <div class="tableau-defile">
      <table>
        <thead><tr><th scope="col">Votes tranchés</th>{etapes.map((n) => <th scope="col">{n}</th>)}</tr></thead>
        <tbody><tr><th scope="row">Précision</th>{etapes.map((n) => <td>{pourcent(precision(n))}</td>)}</tr></tbody>
      </table>
    </div>
  </section>

  <section id="bascule">
    <h2>Le résultat d’un vote</h2>
    <p>« À <em>N</em> voix près » veut dire : il aurait suffi que <em>N</em> députés changent d’avis pour que le résultat bascule. Avec <em>P</em> les voix pour et <em>R</em> les suffrages requis (publiés avec chaque scrutin) : <strong>P − R + 1</strong> députés ayant voté pour qui votent contre font tomber un texte adopté ; <strong>R − P</strong> députés ayant voté contre qui votent pour font passer un texte rejeté.</p>
    <div class="exemple">
      <p class="exemple-titre">Exemple réel</p>
      <p>Le <a href={lienVote(exemple)}>scrutin n° {exemple.numero}</a> du {dateLisible(exemple.date)} : {P} voix pour, {R} suffrages requis. {P} − {R} + 1 = <strong>{P - R + 1}</strong>. {bascule(exemple)}</p>
    </div>
    <p>« Ta voix de 578<sup>e</sup> » refait ce calcul en ajoutant ta voix : les suffrages exprimés augmentent d’un, et la majorité requise est recalculée (la moitié des suffrages exprimés, plus une voix).</p>
  </section>

  <section id="cases">
    <h2>Une case par député et par scrutin</h2>
    <p>Pour chaque scrutin, chaque député en exercice ce jour-là occupe exactement une case : <strong>pour</strong>, <strong>contre</strong>, <strong>abstention</strong>, <strong>non-votant</strong> ou <strong>absent</strong>. L’Assemblée ne publie pas la liste des absents : nous la reconstituons à partir des députés en exercice à la date du vote. Un non-votant (par exemple la présidence de séance) n’est pas un absent.</p>
  </section>

  <section id="groupes">
    <h2>Les votes « contre son groupe »</h2>
    <p>La position d’un groupe est celle de la majorité de ses membres qui ont voté pour, contre ou se sont abstenus ; à égalité, il n’a pas de position. Un député vote <strong>contre son groupe</strong> quand il vote l’inverse de cette position. S’abstenir n’est pas voter contre son groupe, et les non-inscrits n’ont pas de groupe. Cette notion n’est pas publiée par l’Assemblée : nous la calculons, et chaque page de vote montre le décompte du groupe pour qu’elle soit vérifiable.</p>
  </section>

  <section id="censure">
    <h2>Les motions de censure</h2>
    <p>Pour une motion de censure, l’Assemblée ne publie que les voix pour : on ne peut pas distinguer un député contre d’un absent. Les motions ont leur page, mais ne comptent ni dans tes comparaisons ni dans les votes contre son groupe.</p>
  </section>

  <section id="participation">
    <h2>La participation d’un député</h2>
    <p>La part des scrutins de son mandat où il a voté pour, contre ou s’est abstenu, hors motions de censure. La plupart des scrutins portent sur des amendements : la fiche de chaque député donne donc aussi sa participation aux seuls votes solennels, où tous sont appelés à voter, avec la médiane des députés.</p>
  </section>

  <section id="tes-donnees">
    <span id="navigateur"></span>
    <h2>Tes données</h2>
    <p>Tes réponses, tes pronostics, ton député et ton personnage restent dans ton navigateur : rien n’est envoyé. Les opinions politiques sont des données sensibles ; le site n’a aucune base de données qui pourrait les recevoir (voir <a href="/confidentialite/">Tes données</a>).</p>
    <div class="actions">
      <Bouton variante="contour" data-telecharger>Télécharger mes réponses</Bouton>
      <Bouton variante="contour" data-tout-effacer>Tout effacer</Bouton>
    </div>
    <p class="t-texte" aria-live="polite" data-efface></p>
  </section>

  <section id="donnees">
    <h2>Les sources</h2>
    <p>Données ouvertes de l’Assemblée nationale (17<sup>e</sup> législature, Licence ouverte), récupérées et contrôlées chaque nuit : chaque scrutin doit retrouver le décompte officiel, sinon rien n’est publié et le site garde sa dernière version valide. Codes postaux et circonscriptions : data.gouv.fr.</p>
    <p><a href="/etat/">État des données de cette nuit</a></p>
  </section>
</PageService>

<script>
  // Tout effacer : réponses, pronostics, député choisi, avancement du quiz, des lots et des
  // séances, verdicts déjà découverts, personnage, paliers annoncés. Rien d'autre à effacer :
  // rien n'a été envoyé ailleurs. Télécharger : les mêmes clés, dans un fichier fait sur place.
  const CLES = ['578e.reponses.v1', '578e.depute.v1', '578e.quiz.v1', '578e.lots.v1', '578e.seances.v1',
    '578e.verdicts-vus.v1', '578e.personnage.v1', '578e.paliers-vus.v1'];
  document.addEventListener('astro:page-load', () => {
    const effacer = document.querySelector('[data-tout-effacer]');
    if (!effacer) return;
    const message = document.querySelector<HTMLElement>('[data-efface]')!;
    effacer.addEventListener('click', () => {
      if (!window.confirm('Effacer toutes tes réponses, tes pronostics et ton député de ce navigateur ?')) return;
      for (const cle of CLES) {
        try { localStorage.removeItem(cle); } catch { /* stockage indisponible */ }
      }
      document.dispatchEvent(new Event('vdef:reponses'));
      message.textContent = 'C’est fait : ce navigateur ne garde plus rien de toi.';
    });
    document.querySelector('[data-telecharger]')!.addEventListener('click', () => {
      const tout: Record<string, unknown> = {};
      for (const cle of CLES) {
        try { const v = localStorage.getItem(cle); if (v !== null) tout[cle] = JSON.parse(v); } catch { /* illisible */ }
      }
      if (!Object.keys(tout).length) { message.textContent = 'Ce navigateur ne garde rien de toi pour l’instant.'; return; }
      const url = URL.createObjectURL(new Blob([JSON.stringify(tout, null, 2)], { type: 'application/json' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = '578e-siege-mes-reponses.json';
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });
  });
</script>

<style>
  .niveaux { list-style: none; padding: 0; }
  .niveaux li { display: flex; align-items: center; gap: 10px; }
  .niveaux span { width: 16px; height: 16px; border-radius: var(--pilule); flex: none; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.2); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  #tes-donnees, #navigateur { scroll-margin-top: 24px; }
</style>
