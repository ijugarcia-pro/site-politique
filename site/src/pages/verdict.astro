---
// Le verdict de la séance de la semaine (t25 ; VDEF, lot V5 ; maquette 08) : la salle vue du
// perchoir, aux couleurs du vote (voyants et sièges), le repère « Toi » sur ta place ; la feuille
// de droite : l'issue en grand, « il aurait suffi que N députés changent d'avis », la barre et
// les pastilles, toi / ton jumeau / ton député, ton pronostic et ta voix de 578e, « Comprendre ce
// vote » et « Verdict suivant ». La logique ne change pas : le verdict du matin (décision de t10),
// le verdict partiel tant que la séance n'est tranchée qu'en partie (retour de Julien du 12 oct.
// 2026), un verdict pas encore découvert qui attend le toucher (D1, `578e.verdicts-vus.v1`).
// Pas de comparaison avec les utilisateurs du site : il faudrait des agrégats (reportés).
import Base from '../layouts/Base.astro';
import Bouton from '../components/vdef/Bouton.astro';
import Feuille from '../components/vdef/Feuille.astro';
import MiniHemicycle from '../components/MiniHemicycle.astro';
import { avancementSeance, composition, lienVote, quandVote, questionSeance, scrutinPublie, semaine,
  voteJuge } from '../lib/donnees.ts';
import { SIEGES } from '../lib/hemicycle.ts';
import { verdict } from '../lib/votes.ts';

const sem = semaine();
const compo = composition();
const LETTRES: Record<string, string> = { pour: 'P', contre: 'C', abstention: 'A', non_votant: 'N', absent: '-' };
const seance = sem.votes.filter((v) => v.statut !== 'retiré');
const JOURS = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
const MOIS = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];
const jourLong = (d: string) => `${JOURS[new Date(`${d}T12:00:00Z`).getUTCDay()]} ${Number(d.slice(8, 10))} ${MOIS[Number(d.slice(5, 7)) - 1]}`;
const verdicts = seance.flatMap((v) => {
  const s = voteJuge(v) ? scrutinPublie(v.scrutin!.uid) : null;
  if (!s) return [];
  const votes = new Map(s.sieges.filter((x) => x.depute).map((x) => [x.depute!, x]));
  return [{
    cle: v.cle, uid: s.uid, titre: questionSeance(v).titre, theme: v.carte?.theme ?? 'Vote solennel',
    quand: jourLong(s.date), verdict: verdict(s), adopte: s.sort === 'adopté', inverser: s.voix_pour_inverser,
    decompte: s.decompte, requis: s.requis, lien: lienVote(s),
    sieges: compo.sieges.map((c) => {
      if (c.vacant || !c.depute) return 'V';
      const x = votes.get(c.depute);
      return x ? LETTRES[x.vote ?? 'absent'] ?? '-' : 'x';
    }).join(''),
  }];
});
const attendus = sem.votes.filter((v) => v.type === 'annonce' && v.statut === 'à venir');
const etape = avancementSeance(sem);
const donnees = JSON.stringify({
  lundi: sem.lundi, verdicts, sieges: compo.sieges.map((s) => s.depute ?? null),
}).replace(/</g, '\\u003c');
const eteints = Array.from({ length: SIEGES }, () => '#E7E7E7');
const pl = (n: number, mot: string) => `${n} ${mot}${n > 1 ? 's' : ''}`;
---
{verdicts.length === 0 ? (
  <Base titre="Le verdict" vue="tribune" fond="tribune"
    description="Le verdict des votes de la semaine à l'Assemblée, face à tes réponses.">
    <Feuille position="droite" titre="titre-attente">
      <span class="t-etiquette">Le verdict</span>
      <h1 id="titre-attente" class="t-feuille">Pas encore de verdict</h1>
      {attendus.length > 0 ? (
        <>
          <p class="t-texte">Les députés n’ont pas encore voté. Le verdict s’affiche ici le lendemain matin, dès que l’Assemblée publie le scrutin.</p>
          <ul class="lignes">
            {attendus.map((v) => <li>{questionSeance(v).titre}<span>{quandVote(v)}</span></li>)}
          </ul>
          <Bouton href="/seance/" large>Trancher avant eux</Bouton>
        </>
      ) : (
        <>
          <p class="t-texte">Aucun vote de la séance de cette semaine n’a encore été tenu.</p>
          <Bouton href="/explorer/" large>Les derniers votes</Bouton>
        </>
      )}
    </Feuille>
  </Base>
) : (
  <Base titre="Le verdict" fond="salle" vueSalle="salle"
    focus={{ quitter: '/', total: seance.length, libelle: `Verdict 1 sur ${seance.length}` }}
    description="Le verdict des votes de la semaine à l'Assemblée, face à tes réponses.">
    <script is:inline define:vars={{ uids: verdicts.map((v) => v.uid) }}>
      // Un verdict pas encore découvert : il reste caché jusqu'au toucher (D1).
      try {
        const vus = JSON.parse(localStorage.getItem('578e.verdicts-vus.v1') || '[]');
        if (uids.some((u) => !vus.includes(u))) document.documentElement.classList.add('verdict-cache');
      } catch { document.documentElement.classList.add('verdict-cache'); }
    </script>
    <Feuille position="droite" titre="titre-verdict-0" class="feuille-verdict" data-verdicts>
      {verdicts.map((v, k) => (
        <article class="un-verdict" data-verdict={k} hidden={k > 0}>
          <div class="pastilles">
            <span class="pastille-v">{v.theme}</span>
            <span class="pastille-v">{v.quand}</span>
          </div>
          <h1 id={`titre-verdict-${k}`} class="t-interface question" tabindex="-1" data-titre-verdict>{v.titre}</h1>
          <div class="decouvrir" data-decouvrir>
            <p class="t-texte">Les députés ont voté. Découvre le verdict, et ta place dans le résultat.</p>
            <Bouton large data-decouvrir-bouton>Découvrir le verdict</Bouton>
          </div>
          <div class="resultat" data-resultat>
            <p class="t-issue issue">{v.verdict}</p>
            {v.inverser && v.inverser > 0 && (
              <p class="t-texte suffi">Il aurait suffi que <strong>{pl(v.inverser, 'député')}</strong> change{v.inverser > 1 ? 'nt' : ''} d’avis.</p>
            )}
            <div class="barre" role="img" aria-label={`${v.decompte.pour} pour, ${v.decompte.contre} contre, ${pl(v.decompte.abstention, 'abstention')}, ${pl(v.decompte.absent, 'absent')}`}>
              {([['pour', v.decompte.pour], ['contre', v.decompte.contre], ['abstention', v.decompte.abstention], ['absent', v.decompte.absent]] as const)
                .filter(([, n]) => n > 0).map(([c, n]) => <span class={`point ${c}`} style={`flex: ${n}`}></span>)}
            </div>
            <div class="pastilles">
              <span class="pastille-v"><span class="point pour" aria-hidden="true"></span>{v.decompte.pour} pour</span>
              <span class="pastille-v"><span class="point contre" aria-hidden="true"></span>{v.decompte.contre} contre</span>
              <span class="pastille-v"><span class="point abstention" aria-hidden="true"></span>{pl(v.decompte.abstention, 'abstention')}</span>
              <span class="pastille-v"><span class="point absent" aria-hidden="true"></span>{pl(v.decompte.absent, 'absent')}</span>
              {v.decompte.non_votant > 0 && <span class="pastille-v"><span class="point non-votant" aria-hidden="true"></span>{pl(v.decompte.non_votant, 'non-votant')}</span>}
            </div>
            <ul class="lignes" data-lignes={k}></ul>
            <p class="t-legende" data-voix={k}></p>
            {etape.bandeau && <p class="t-legende partiel" role="status">{etape.bandeau}. Leur verdict s’affiche ici le lendemain matin.</p>}
            <div class="repli-2d" data-repli-2d hidden>
              <MiniHemicycle couleurs={eteints} titre="Comment l'Assemblée a voté, siège par siège" />
            </div>
            <div class="actions">
              <Bouton href={v.lien} variante="contour">Comprendre ce vote</Bouton>
              {k < verdicts.length - 1
                ? <Bouton data-suivant={k + 1}>Verdict suivant</Bouton>
                : <Bouton href="/">Retour à la tribune</Bouton>}
            </div>
          </div>
        </article>
      ))}
    </Feuille>
    <script type="application/json" data-donnees-verdict set:html={donnees}></script>
  </Base>
)}

<script>
  import { deputeChoisi, lireJSON, reponses } from '../lib/navigateur.ts';
  import { palierAtteint, votesTranches } from '../lib/paliers.ts';
  import { profil, type Matrice } from '../lib/profil.ts';
  import { donnee } from '../lib/matrice-cache.ts';
  import { etatSeance } from '../lib/seances.ts';
  import { VOYANTS } from '../lib/trancher.ts';
  import { voix578 } from '../lib/votes.ts';
  import { salle3D } from '../salle3d/pilote.ts';

  interface Verdict {
    cle: string; uid: string; titre: string; verdict: string; adopte: boolean; inverser: number | null;
    decompte: { pour: number; contre: number; abstention: number }; requis: number | null; sieges: string;
  }
  const REPLI: Record<string, string> = { P: '#2F7BFF', C: '#FF6A3D', A: '#FFC531', '-': '#8A8A8A', N: '#3A3A3A', x: '#E7E7E7', V: '#FFFFFF' };
  const MOTS: Record<string, string> = { P: 'Pour', C: 'Contre', A: 'Abstention', N: 'Non-votant' };
  const POINTS: Record<string, string> = { P: 'pour', C: 'contre', A: 'abstention', N: 'non-votant' };
  const pluriel = (n: number, mot: string) => `${n} ${mot}${n > 1 ? 's' : ''}`;

  document.addEventListener('astro:page-load', () => {
    const brut = document.querySelector('[data-donnees-verdict]')?.textContent;
    if (!brut) return;
    const { lundi, verdicts, sieges } = JSON.parse(brut) as { lundi: string; verdicts: Verdict[]; sieges: (string | null)[] };
    const racineSalle = document.querySelector<HTMLElement>('[data-salle-vdef]');
    const salle = racineSalle ? salle3D(racineSalle) : null;
    let sans3D = !salle;
    salle?.prete.then((s) => { sans3D = !s; });
    const seance = etatSeance(lundi);
    const mes = Object.fromEntries(Object.entries(reponses()).map(([k, r]) => [k, r.v]));
    const monDepute = deputeChoisi();
    let matrice: Matrice | null = null;
    const html = document.documentElement;
    let courant = 0;

    /** La ligne « Toi », « Ton jumeau, … », « Ton député, … » : son vote, avec sa pastille. */
    const ligne = (qui: string, lettre: string | null, suite = '', lien?: string) => {
      const li = document.createElement('li');
      const nom = document.createElement(lien ? 'a' : 'span');
      nom.textContent = qui;
      if (lien) (nom as HTMLAnchorElement).href = lien;
      const vote = document.createElement('span');
      const pt = document.createElement('span');
      pt.className = `point ${lettre ? POINTS[lettre] ?? 'absent' : 'absent'}`;
      pt.setAttribute('aria-hidden', 'true');
      vote.append(pt, `${lettre ? MOTS[lettre] ?? 'Absent' : 'Absent'}${suite}`);
      li.append(nom, vote);
      return li;
    };

    /** Le verdict k : la feuille, la salle aux couleurs du vote, le repère « Toi ». */
    const peindre = (k: number, onde = false) => {
      courant = k;
      const v = verdicts[k];
      for (const a of document.querySelectorAll<HTMLElement>('[data-verdict]')) a.hidden = a.dataset.verdict !== String(k);
      const libelle = document.querySelector('[data-focus-libelle]');
      const total = document.querySelectorAll('[data-focus-segment]').length;
      if (libelle) libelle.textContent = `Verdict ${k + 1} sur ${total}`;
      document.querySelectorAll<HTMLElement>('[data-focus-segment]').forEach((s, i) => s.classList.toggle('plein', i <= k));
      const cache = html.classList.contains('verdict-cache');
      const couleurs = cache ? [] : [...v.sieges].map((l) => VOYANTS[l] ?? null);
      if (onde) salle?.onde(couleurs, 1100); else salle?.voyants(couleurs);
      const repli = document.querySelector<HTMLElement>(`[data-verdict="${k}"] [data-repli-2d]`);
      if (repli) {
        repli.hidden = !sans3D || cache;
        repli.querySelectorAll<SVGCircleElement>('circle:not(.marque)').forEach((c, i) => c.setAttribute('fill', REPLI[v.sieges[i]] ?? '#E7E7E7'));
      }
      remplir(k);
    };

    /** Les lignes du verdict k : toi, ton jumeau, ton député ; ton pronostic ; ta voix de 578e. */
    const remplir = (k: number) => {
      const v = verdicts[k];
      const a = mes[v.uid] ?? seance.reponses[v.cle] ?? null;
      const gagnant = v.adopte ? 'pour' : 'contre';
      const p = matrice ? profil(matrice, mes) : null;
      const kv = matrice ? matrice.votes.indexOf(v.uid) : -1;
      const lettre = (s: string | undefined) => (kv >= 0 && s && s[kv] !== '-' ? s[kv] : null);
      const jumeau = p?.jumeau ?? null;
      const depute = monDepute && matrice ? matrice.deputes.find((d) => d.u === monDepute) : null;
      const lignes = [ligne('Toi', a === 'pour' ? 'P' : a === 'contre' ? 'C' : null,
        a ? ` · ${a === gagnant ? 'avec la majorité' : 'à contre-courant'}` : '')];
      if (!a) lignes[0].lastChild!.textContent = 'Pas tranché';
      if (jumeau) lignes.push(ligne(`Ton jumeau, ${jumeau.ligne.n}`, lettre(jumeau.ligne.s), '', `/deputes/${jumeau.ligne.u}/`));
      if (depute) lignes.push(ligne(`Ton député, ${depute.n}`, lettre(depute.s), '', `/deputes/${depute.u}/`));
      document.querySelector(`[data-lignes="${k}"]`)!.replaceChildren(...lignes);
      // Ton pronostic et ta voix de 578e (lib/votes.ts) : la majorité requise est recalculée.
      const textes: string[] = [];
      const pr = seance.pronostics[v.cle];
      if (pr) textes.push(`Ton pronostic était « ${pr === 'adopte' ? 'adopté' : 'rejeté'} » : ${(pr === 'adopte') === v.adopte ? 'juste' : 'raté'}.`);
      if (a) {
        const x = voix578(v.decompte, v.requis, a);
        textes.push(`Ta voix de 578e : ${(a === 'pour' ? v.decompte.pour : v.decompte.contre) + 1} ${a}. `
          + (x && x.adopte !== v.adopte ? `Ta voix aurait changé le résultat : le texte aurait été ${x.adopte ? 'adopté' : 'rejeté'}.`
            : 'Le résultat ne change pas.'));
      }
      document.querySelector(`[data-voix="${k}"]`)!.textContent = textes.join(' ');
      // Le repère « Toi » sur ta place (le siège de ton jumeau, à partir du palier 1), avec ton vote.
      const n = votesTranches(mes);
      const place = jumeau && palierAtteint(n) ? sieges.indexOf(jumeau.ligne.u) : -1;
      salle?.reperes(place >= 0 && !html.classList.contains('verdict-cache')
        ? [{ i: place, libelle: a ? `Toi · ${a}` : 'Toi', toi: true }] : []);
    };

    for (const b of document.querySelectorAll<HTMLElement>('[data-suivant]')) {
      b.addEventListener('click', () => {
        peindre(Number(b.dataset.suivant));
        document.querySelector<HTMLElement>(`[data-verdict="${courant}"] [data-titre-verdict]`)?.focus();
      });
    }

    // D1 : un verdict pas encore découvert attend le toucher ; la salle reste éteinte.
    const VUS = '578e.verdicts-vus.v1';
    const vus = lireJSON<string[]>(VUS, []);
    const k0 = verdicts.findIndex((v) => !vus.includes(v.uid));
    if (k0 < 0) {
      html.classList.remove('verdict-cache');
      peindre(0);
    } else {
      html.classList.add('verdict-cache');
      peindre(k0);
      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-decouvrir-bouton]')) {
        b.addEventListener('click', () => {
          try { localStorage.setItem(VUS, JSON.stringify([...new Set([...vus, ...verdicts.map((v) => v.uid)])])); } catch { /* stockage indisponible */ }
          html.classList.remove('verdict-cache');
          peindre(courant, true);
          document.querySelector<HTMLElement>(`[data-verdict="${courant}"] .issue`)?.focus?.();
        });
      }
    }
    if (Object.keys(mes).length || monDepute) {
      donnee('matrice.json').then((m: Matrice) => {
        matrice = m;
        remplir(courant);
      }).catch(() => {});
    }
  });
</script>

<style>
  :global(.feuille.feuille-verdict) { gap: 0; }
  .un-verdict { flex: 1; display: flex; flex-direction: column; gap: 16px; min-height: 0; }
  .un-verdict[hidden] { display: none; }
  .pastilles { display: flex; gap: 8px; flex-wrap: wrap; }
  .pastille-v {
    display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: var(--pilule);
    background: var(--surface); color: var(--encre); font: 600 13px/1 var(--police-texte); white-space: nowrap;
  }
  .question { font: 600 16px/1.35 var(--police-texte); }
  .issue { font-size: 72px; }
  .resultat, .decouvrir { display: flex; flex-direction: column; gap: 16px; flex: 1; min-height: 0; }
  :global(.verdict-cache) .resultat { display: none; }
  :global(html:not(.verdict-cache)) .decouvrir { display: none; }
  .decouvrir :global(.bouton) { margin-top: auto; }
  .barre { display: flex; height: 12px; gap: 2px; border-radius: var(--pilule); overflow: hidden; }
  .barre .point { width: auto; height: auto; border-radius: 0; }
  .lignes :global(li > span:last-child) { white-space: nowrap; }
  .lignes :global(a) { text-decoration: none; }
  .lignes :global(a:hover) { text-decoration: underline; }
  .partiel { padding: 10px 14px; border-radius: 14px; background: var(--surface); }
  .repli-2d { padding: 8px; border-radius: var(--rayon-carte); background: var(--surface); }
  .repli-2d[hidden] { display: none; }
  .actions { margin-top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  @media (max-width: 720px) {
    .issue { font-size: 44px; }
  }
</style>
