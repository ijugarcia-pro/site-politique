---
// L'en-tête du mode focus (quiz, lots) : la barre de progression et son compteur, un titre
// facultatif (frame V5 « ⑥ Séance ») et un lien pour sortir. À placer dans le slot « entete »
// de Base.
interface Props {
  total: number;
  libelle: string;
  /** Le titre à gauche de la barre (« Votes passés · lot 2 »), mis à jour par la page. */
  titre?: string;
  sortie: { href: string; texte: string };
}

const { total, libelle, titre, sortie } = Astro.props;
---
<div class="progression">
  {titre !== undefined && <span class="titre-seance" data-titre-seance>{titre}</span>}
  <div class="barre-cadre">
    <div class="barre" role="progressbar" aria-label={libelle} aria-valuemin="0"
      aria-valuemax={total} aria-valuenow="0" data-barre>
      <span data-barre-pleine></span>
    </div>
    <span class="compteur" data-compteur>Vote 1 sur {total}</span>
  </div>
  <a class="quitter" href={sortie.href}>{sortie.texte}</a>
</div>

<style>
  .progression { display: contents; }
  .titre-seance { flex: none; font-family: var(--police-titre); font-weight: 700; font-size: 18px; }
  @media (max-width: 640px) { .titre-seance { display: none; } }
  .barre-cadre { flex: 1 1 280px; display: flex; align-items: center; gap: 14px; max-width: 640px; margin: 0 auto; }
  .barre { flex: 1; height: 16px; border-radius: 999px; background: var(--bord-leger); overflow: hidden; }
  .barre span { display: block; height: 100%; width: 0; border-radius: 999px; background: var(--violet);
    box-shadow: inset 0 4px 0 rgba(255,255,255,.28); transition: width .4s ease; }
  .compteur { font-family: var(--police-titre); font-weight: 600; font-size: 15px; color: var(--gris-legende); white-space: nowrap; }
  .quitter { padding: 12px 4px; font-family: var(--police-titre); font-weight: 600; font-size: 16px;
    color: var(--violet-fonce); text-decoration: none; }
</style>
