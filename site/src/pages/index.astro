---
// La tribune (VDEF, lot V4 ; maquettes 01, 05 et T1) : l'accueil et le tableau de bord. La salle
// vue du sol, face au pupitre ; une feuille en bas. Deux états, choisis dans le navigateur selon
// les votes tranchés (lib/paliers.ts) : la première visite (0 vote : la grande carte noire vers
// le quiz, le dernier verdict, ton député, les paliers en cadenas, la galerie) et le tableau de
// bord (cette semaine, le dernier verdict, ton député, tes réponses, la galerie, ton parcours).
// Sans JavaScript, la première visite s'affiche. Tout ce qui dépend du visiteur est calculé dans
// son navigateur.
import Base from '../layouts/Base.astro';
import BarreVote from '../components/vdef/BarreVote.astro';
import Bouton from '../components/vdef/Bouton.astro';
import Carte from '../components/vdef/Carte.astro';
import Feuille from '../components/vdef/Feuille.astro';
import Palier from '../components/vdef/Palier.astro';
import Repere from '../components/vdef/Repere.astro';
import { cartesThemes, composition, lienVote, lotsDeVotes, lotsDuParcours, majuscule, questionSeance,
  questionsQuiz, scrutins, semaine } from '../lib/donnees.ts';
import { quandCourt } from '../lib/seances.ts';
import { THEMES } from '../lib/themes.ts';
import { adopte, marge, verdict } from '../lib/votes.ts';

const tous = scrutins();
const solennels = tous.filter((v) => v.solennel && !v.motion_censure);
const dernier = solennels[0];
if (!dernier) throw new Error('Aucun vote solennel exporté');
// La question d'un vote : celle de sa carte quand elle existe (quiz, lots), sinon son titre court.
const cartes = new Map([...questionsQuiz(), ...lotsDeVotes().flat()].map((c) => [c.uid, c]));
const carteDernier = cartes.get(dernier.uid);
const titreDernier = carteDernier?.question ?? dernier.dossier ?? majuscule(dernier.titre).replace(/\.$/, '');
const titreCourtDernier = carteDernier?.titre ?? titreDernier;
const occupes = composition().sieges.filter((s) => !s.vacant).length;

// La séance de la semaine (t23-t24) : ses votes, sans ceux retirés de l'agenda.
const sem = semaine();
const seance = sem.vacances ? [] : sem.votes.filter((v) => v.statut !== 'retiré');
const avenir = seance.filter((v) => v.type === 'annonce' && v.statut === 'à venir');
const prochain = avenir[0] ?? null;
const JOURS = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
const lendemain = (date: string) => JOURS[(new Date(`${date}T12:00:00Z`).getUTCDay() + 1) % 7];
const dernierVote = avenir.length ? avenir.map((v) => v.date).sort().at(-1)! : null;
const rendezVous = dernierVote ? `Verdict ${lendemain(dernierVote)} matin` : null;
const lieu = prochain ? `La tribune · ${quandCourt(prochain.date, prochain.debut)}`
  : 'La tribune · c’est ici que tout se vote';

const donnees = JSON.stringify({
  seance: { lundi: sem.lundi, vacances: sem.vacances, avant: avenir.length > 0,
    votes: seance.map((v) => ({ cle: v.cle, question: questionSeance(v).titre })) },
  lots: lotsDeVotes().map((l) => l.map((c) => c.uid)),
  parcours: lotsDuParcours(),
  quiz: questionsQuiz().length,
  // L'issue de chaque vote : « avec la majorité » quand ta réponse est celle qui l'a emporté.
  issues: Object.fromEntries(tous.filter((v) => !v.motion_censure).map((v) => [v.uid, adopte(v) ? 'pour' : 'contre'])),
  horsMatrice: tous.filter((v) => v.motion_censure).map((v) => v.uid),
  dernier: { uid: dernier.uid, gagnant: adopte(dernier) ? 'pour' : 'contre' },
  cartes: cartesThemes(),
}).replace(/</g, '\\u003c');
const decompte = dernier.decompte;
---
<Base titre="Le 578e siège" vue="tribune" fond="tribune"
  description="Les votes de l'Assemblée nationale rendus accessibles : tranche de vrais votes, compare-toi aux 577 députés, retrouve ce qu'a voté le tien.">
  <Repere libelle={lieu} forme="lieu" x={50} y={33} class="lieu-tribune" />

  <Feuille position="bas" etiquette="La tribune" class="tribune" data-tribune data-etat="premiere">
    <!-- 1. Première visite (maquette 01) : la grande carte noire, ou cette semaine (maquette 05). -->
    <Carte variante="noire" class="entree" data-bloc-premiere>
      <span class="t-etiquette sur-noir">Première visite · 2 minutes</span>
      <h1 class="titre-entree">Prends le 578<sup>e</sup> siège de l’Assemblée</h1>
      <p class="texte-entree">Réponds à {questionsQuiz().length} vrais votes déjà passés. Tu découvres comment les 577 députés ont voté, puis où tu siégerais et qui vote comme toi.</p>
      <div class="pied-entree">
        <Bouton href="/quiz/" variante="contour" data-bouton-quiz>Commencer</Bouton>
        <span class="t-legende sur-noir">Sans compte. Tes réponses restent dans ton navigateur.</span>
      </div>
    </Carte>

    <Carte variante="bordee" class="semaine" data-bloc-semaine hidden>
      <span class="t-etiquette" data-semaine-etiquette>Cette semaine · vote avant eux</span>
      <h1 class="t-feuille titre-semaine" data-semaine-titre>{avenir.length ? `${seance.length} votes à trancher avant les députés` : `${seance.length} votes à trancher`}</h1>
      <span class="segments" aria-hidden="true" data-semaine-segments>
        {seance.map(() => <span></span>)}
      </span>
      <ol class="liste" data-semaine-liste>
        {seance.map((v, k) => (
          <li data-cle={v.cle}>
            <span class="rang">{k + 1}</span>
            <span class="question">
              <span class="t-interface">{questionSeance(v).titre}</span>
              <span class="t-legende">{v.carte?.theme ?? 'Vote solennel'}</span>
            </span>
            <span class="etat t-legende" data-etat-vote>À trancher</span>
          </li>
        ))}
      </ol>
      <p class="t-texte" data-semaine-texte hidden></p>
      <div class="actions">
        <Bouton href="/seance/" data-semaine-bouton>Commencer</Bouton>
        <span class="t-etiquette" data-semaine-rdv>{rendezVous}</span>
      </div>
    </Carte>

    <!-- 2. Le dernier verdict, puis ton député. -->
    <div class="colonne">
      <Carte etiquette="Le dernier verdict" href={lienVote(dernier)} class="verdict">
        <span class="t-carte-petit question-verdict ordi">{titreDernier}</span>
        <span class="t-legende titre-court tel">{titreCourtDernier}</span>
        <span class="issue"><span class="t-chiffre">{verdict(dernier)}</span>{marge(dernier) && <span class="t-etiquette">{marge(dernier)}</span>}</span>
        <BarreVote pour={decompte.pour} contre={decompte.contre} abstention={decompte.abstention}
          absents={decompte.absent} class="ordi" />
        <span class="t-interface ordi" data-verdict-toi hidden></span>
      </Carte>
      <Carte etiquette="Ton député" href="/deputes/" class="depute" data-carte-depute hidden>
        <span class="t-carte-petit nom-depute" data-nom-depute></span>
        <span class="t-legende accord-depute" data-accord-depute></span>
      </Carte>
      <form class="carte-cp" action="/deputes/" method="get" data-cp-depute>
        <span class="t-etiquette">Ton député</span>
        <label for="cp-tribune" class="t-carte-petit">Qui te représente ?</label>
        <span class="cp">
          <input id="cp-tribune" name="cp" inputmode="numeric" pattern="[0-9]{5}" maxlength="5"
            placeholder="Code postal" autocomplete="postal-code" required />
          <button type="submit">Trouver</button>
        </span>
      </form>
    </div>

    <!-- 3. Ce que tu débloques (première visite) ou tes réponses ; puis la galerie. -->
    <div class="colonne">
      <div class="debloques" data-bloc-debloques>
        <span class="t-etiquette">Ce que tu débloques en tranchant</span>
        <ul>
          <li><Palier etat="verrouille" libelle="Ta place" detail="À 10 votes : ton jumeau parmi les 577" /></li>
          <li><Palier etat="verrouille" libelle="La salle éclairée" detail="À 25 votes : chaque siège selon toi" /></li>
          <li><Palier etat="verrouille" libelle="Ton bilan" detail="À 40 votes : ton année à partager" /></li>
        </ul>
      </div>
      <Carte etiquette="Tes réponses" href="/tes-reponses/" class="reponses" data-bloc-reponses hidden>
        <span class="t-chiffre" data-nb-votes></span>
        <span class="t-legende" data-phrase-reponses></span>
      </Carte>
      <Carte etiquette="La galerie du public" href="/explorer/" class="galerie">
        <span class="t-carte-petit" data-galerie-titre>Tous les votes, sans rien trancher</span>
        <span class="faux-champ ordi" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
          Une loi, un thème, un député…
        </span>
        <span class="t-legende">{tous.length} votes · {THEMES.length} thèmes · {occupes} députés</span>
      </Carte>
    </div>

    <!-- 4. Ton parcours (tableau de bord) : les paliers et le prochain dossier. -->
    <a class="parcours" href="/parcours/" data-bloc-parcours hidden>
      <span class="titre-parcours">Ton parcours</span>
      <span class="paliers">
        <Palier etat="verrouille" libelle="Ta place" detail="À 10 votes" data-palier="place" />
        <Palier etat="verrouille" libelle="La salle éclairée" detail="À 25 votes" data-palier="salle-eclairee" />
        <Palier etat="verrouille" libelle="Ton bilan" detail="À 40 votes" data-palier="bilan" />
        <Palier etat="verrouille" libelle="Dossiers" detail="À 3 votes sur un thème" data-palier="dossier" />
      </span>
      <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
    </a>

    <p class="pied">
      <span>Site indépendant, sans commentaire politique : seulement des votes réels, issus des <a href="https://data.assemblee-nationale.fr/">données ouvertes de l’Assemblée nationale</a>.</span>
      <a href="/calcul/">Comment c’est calculé</a>
    </p>
  </Feuille>

  <script type="application/json" data-donnees-tribune set:html={donnees}></script>
</Base>

<script>
  import { deputeChoisi, lireJSON, reponse, reponses } from '../lib/navigateur.ts';
  import { etatLots, prochainLot } from '../lib/lots.ts';
  import { dossiers, palierAtteint, PALIERS, prochainPalier, votesTranches } from '../lib/paliers.ts';
  import { colonnes, comparer, type Matrice } from '../lib/profil.ts';
  import { etatSeance } from '../lib/seances.ts';

  interface Donnees {
    seance: { lundi: string; vacances: boolean; avant: boolean; votes: { cle: string; question: string }[] };
    lots: string[][]; parcours: number; quiz: number;
    issues: Record<string, 'pour' | 'contre'>; horsMatrice: string[];
    dernier: { uid: string; gagnant: 'pour' | 'contre' };
    cartes: { uid: string; theme: string }[];
  }

  document.addEventListener('astro:page-load', () => {
    const racine = document.querySelector<HTMLElement>('[data-tribune]');
    const brut = document.querySelector('[data-donnees-tribune]')?.textContent;
    if (!racine || !brut) return;
    const d = JSON.parse(brut) as Donnees;
    const $ = <T extends Element = HTMLElement>(s: string) => racine.querySelector<T>(s)!;
    const pluriel = (n: number, mot: string) => `${n} ${mot}${n > 1 ? 's' : ''}`;

    const hors = new Set(d.horsMatrice);
    const toutes = Object.fromEntries(Object.entries(reponses())
      .filter(([uid]) => !hors.has(uid)).map(([uid, r]) => [uid, r.v]));
    const n = votesTranches(toutes);

    // --- Le dernier verdict : ce que tu avais répondu ---
    const toi = reponse(d.dernier.uid);
    if (toi) {
      const el = $('[data-verdict-toi]');
      el.textContent = `Tu avais voté ${toi} : ${toi === d.dernier.gagnant ? 'avec la majorité' : 'à contre-courant'}.`;
      el.hidden = false;
    }

    // --- Première visite ou tableau de bord ---
    const quiz = lireJSON<{ i?: number; fini?: boolean }>('578e.quiz.v1', {});
    if (n === 0) {
      if ((quiz.i ?? 0) > 0) $<HTMLAnchorElement>('[data-bouton-quiz]').textContent = 'Reprendre';
      return;
    }
    racine.dataset.etat = 'tableau';
    for (const s of ['[data-bloc-premiere]', '[data-bloc-debloques]']) $(s).hidden = true;
    for (const s of ['[data-bloc-semaine]', '[data-bloc-reponses]', '[data-bloc-parcours]']) $(s).hidden = false;

    // --- Cette semaine : le quiz à finir, la séance, ou les votes passés ---
    const titre = $('[data-semaine-titre]');
    const etiquette = $('[data-semaine-etiquette]');
    const bouton = $<HTMLAnchorElement>('[data-semaine-bouton]');
    const texte = $('[data-semaine-texte]');
    const liste = $('[data-semaine-liste]');
    const segments = [...racine.querySelectorAll<HTMLElement>('[data-semaine-segments] span')];
    const sansListe = (t: string) => {
      liste.hidden = true; $('[data-semaine-segments]').hidden = true;
      texte.textContent = t; texte.hidden = false;
    };
    const lots = etatLots();
    const lotSuivant = lots.lot ?? prochainLot(lots.faits, d.lots.length);
    const versLots = () => {
      bouton.href = '/lots/';
      bouton.textContent = lots.lot !== null && lots.i > 0 ? 'Reprendre les votes passés' : 'Trancher des votes passés';
    };
    if (!quiz.fini) {
      etiquette.textContent = 'Ton quiz d’entrée';
      const reste = Math.max(0, d.quiz - (quiz.i ?? 0));
      titre.textContent = `Encore ${pluriel(reste, 'vote')} pour finir le quiz`;
      sansListe('Après le quiz, tu découvres où tu siégerais et qui vote comme toi.');
      bouton.href = '/quiz/';
      bouton.textContent = 'Reprendre le quiz';
      $('[data-semaine-rdv]').hidden = true;
    } else if (d.seance.vacances || !d.seance.votes.length) {
      etiquette.textContent = 'Cette semaine';
      titre.textContent = 'Pas de séance cette semaine';
      sansListe('L’Assemblée ne tient pas de séance publique : ce sont les vacances parlementaires. En attendant, tranche des votes passés.');
      versLots();
      $('[data-semaine-rdv]').hidden = true;
    } else {
      const ma = etatSeance(d.seance.lundi);
      const faits = d.seance.votes.map((v) => v.cle in ma.reponses);
      etiquette.textContent = d.seance.avant ? 'Cette semaine · vote avant eux' : 'Cette semaine · et toi, qu’aurais-tu voté ?';
      for (const li of liste.querySelectorAll<HTMLElement>('li')) {
        const k = d.seance.votes.findIndex((v) => v.cle === li.dataset.cle);
        li.classList.toggle('fait', faits[k]);
        const etat = li.querySelector<HTMLElement>('[data-etat-vote]')!;
        etat.textContent = faits[k] ? 'Tranché' : 'À trancher';
        etat.classList.toggle('tranche', faits[k]);
      }
      segments.forEach((s, k) => s.classList.toggle('plein', faits[k]));
      const restants = faits.filter((f) => !f).length;
      if (ma.fini || !restants) {
        titre.textContent = 'A voté.';
        if (lotSuivant === null) { bouton.href = '/explorer/#a-trancher'; bouton.textContent = 'Trancher d’autres votes'; } else versLots();
      } else {
        bouton.href = '/seance/';
        bouton.textContent = faits.some(Boolean) ? `Reprendre · ${pluriel(restants, 'vote')}` : 'Commencer';
      }
    }

    // --- Tes réponses : le nombre et sa phrase ---
    let avec = 0, contre = 0;
    for (const [uid, r] of Object.entries(toutes)) {
      const g = d.issues[uid];
      if (!g || (r !== 'pour' && r !== 'contre')) continue;
      if (r === g) avec += 1; else contre += 1;
    }
    $('[data-nb-votes]').textContent = pluriel(n, 'vote');
    $('[data-phrase-reponses]').textContent = avec + contre
      ? `${avec} fois avec la majorité, ${contre} fois à contre-courant.`
      : 'Les verdicts de tes votes ne sont pas encore tombés.';
    $('[data-galerie-titre]').textContent = 'Tous les votes de la législature';

    // --- Ton parcours : les paliers et le prochain dossier ---
    const poser = (cle: string, etat: 'fait' | 'en-cours' | 'verrouille', detail: string, part = 0, libelle?: string) => {
      const el = $(`[data-palier="${cle}"]`);
      el.classList.remove('fait', 'en-cours', 'verrouille');
      el.classList.add(etat);
      el.style.setProperty('--angle', `${Math.round(360 * part)}deg`);
      el.querySelector('[data-palier-detail]')!.textContent = detail;
      el.querySelector('[data-palier-etat]')!.textContent = ` · ${{ fait: 'débloqué', 'en-cours': 'en cours', verrouille: 'verrouillé' }[etat]}`;
      if (libelle) el.querySelector('.libelle')!.firstChild!.textContent = libelle;
    };
    const prochain = prochainPalier(n);
    for (const p of PALIERS) {
      if (n >= p.seuil) poser(p.id, 'fait', `${p.id === 'bilan' ? 'Débloqué' : 'Débloquée'} à ${p.seuil} votes`);
      else if (prochain?.palier.id === p.id) poser(p.id, 'en-cours', `${n} / ${p.seuil} votes`, n / p.seuil);
      else poser(p.id, 'verrouille', `À ${p.seuil} votes`);
    }
    const ds = dossiers(toutes, d.cartes).filter((x) => x.votes.length);
    const ouverts = ds.filter((x) => x.ouvert);
    const suivant = ds.filter((x) => !x.ouvert && x.votes.length >= 3)
      .sort((a, b) => b.tranches - a.tranches)[0];
    if (suivant) poser('dossier', suivant.tranches ? 'en-cours' : 'verrouille',
      `Encore ${pluriel(suivant.reste, 'vote')}`, suivant.tranches / 3, `Dossier ${suivant.theme}`);
    else if (ouverts.length) poser('dossier', 'fait', `${pluriel(ouverts.length, 'dossier')} ouvert${ouverts.length > 1 ? 's' : ''}`, 1, 'Tes dossiers');
    else $('[data-palier="dossier"]').hidden = true;
    // Sur téléphone, la bande ne montre que le palier en cours (maquette T1).
    const atteint = palierAtteint(n);
    racine.querySelector<HTMLElement>('[data-bloc-parcours]')!.dataset.enCours = prochain?.palier.id ?? atteint?.id ?? '';

    // --- Ton député : ses votes comme les tiens ---
    const uid = deputeChoisi();
    if (!uid) return;
    Promise.all([
      fetch('/donnees/deputes.json').then((r) => r.json()) as Promise<{ u: string; n: string; g: string | null }[]>,
      fetch('/donnees/matrice.json').then((r) => r.json()) as Promise<Matrice>,
    ]).then(([liste, m]) => {
      const dep = liste.find((x) => x.u === uid);
      if (!dep) return;
      const carte = $<HTMLAnchorElement>('[data-carte-depute]');
      carte.href = `/deputes/${dep.u}/`;
      $('[data-nom-depute]').textContent = dep.g ? `${dep.n} · ${dep.g}` : dep.n;
      const ligne = m.deputes.find((x) => x.u === uid);
      const mes = colonnes(m, toutes as Record<string, 'pour' | 'contre'>);
      const c = ligne ? comparer(ligne.s, mes) : null;
      const k = m.votes.indexOf(d.dernier.uid);
      const MOTS: Record<string, string> = { P: 'pour', C: 'contre', A: 'abstention' };
      const auDernier = ligne && k >= 0 ? MOTS[ligne.s[k]] : undefined;
      $('[data-accord-depute]').textContent = (c ? `${pluriel(c.identiques, 'vote')} comme toi sur tes ${mes.length}.` : '')
        + (auDernier ? ` Au dernier verdict : ${auDernier}.` : ' Absent au dernier verdict.');
      carte.hidden = false;
      $('[data-cp-depute]').hidden = true;
    }).catch(() => {});
  });
</script>

<style>
  /* La feuille du bas (maquette 05) : trois colonnes, puis la bande du parcours. */
  :global(.feuille.tribune) {
    display: grid; grid-template-columns: 1.35fr 1fr 1fr; grid-template-rows: minmax(0, 1fr) auto auto;
    height: var(--feuille-bas); gap: 12px;
  }
  :global(.tribune[data-etat='premiere']) { grid-template-rows: minmax(0, 1fr) auto; }
  .colonne { display: flex; flex-direction: column; gap: 12px; min-height: 0; }
  .colonne > :global(.verdict), .colonne > :global(.galerie) { flex: 1; }
  :global(.tribune[data-etat='tableau']) .colonne > :global(.galerie) { flex: 1; }

  /* La grande carte noire de la première visite. */
  :global(.carte.entree) { padding: 28px; gap: 16px; }
  .sur-noir { color: var(--sur-encre-2); }
  .titre-entree { font: 700 46px/1.05 var(--police-titre); letter-spacing: -0.01em; color: var(--feuille); }
  .titre-entree sup { font-size: 0.5em; line-height: 0; vertical-align: super; }
  .texte-entree { font: 500 17px/1.5 var(--police-texte); max-width: 480px; }
  .pied-entree { margin-top: auto; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }

  /* Cette semaine. */
  .titre-semaine { font-size: 30px; line-height: 1.08; }
  .liste { list-style: none; margin: 0; padding: 0; }
  .liste li { display: flex; gap: 12px; align-items: center; padding: 11px 0; border-top: 1px solid var(--filet); }
  .rang { flex: 0 0 30px; height: 30px; border-radius: var(--pilule); display: flex; align-items: center; justify-content: center; font: 700 14px/1 var(--police-texte); }
  .liste li.fait .rang { background: var(--encre); color: var(--feuille); }
  .question { flex: 1; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .etat { font-weight: 600; white-space: nowrap; }
  .etat.tranche { color: var(--encre); font-weight: 700; }
  .etat.tranche::before { content: '✓ '; }
  .segments { display: none; gap: 4px; }
  .segments span { flex: 1; height: 6px; border-radius: var(--pilule); background: var(--bord); }
  .segments span.plein { background: var(--encre); }
  .actions { margin-top: auto; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }

  /* Le dernier verdict, ton député. */
  .issue { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
