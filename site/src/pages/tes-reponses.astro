---
// Tes réponses (VDEF, capture 11 ; lot V6) : tout ce que tu as tranché, du plus récent au plus
// ancien, groupé par mois. Trois chiffres en phrases, des filtres (toutes, avec la majorité, à
// contre-courant, en attente du verdict), et pour chaque vote : la question (ou le titre court),
// le thème de sa carte, ta réponse, l'issue en phrase. Les « Je ne sais pas » de la séance y
// sont, puisqu'elle les garde. Tout est lu dans le navigateur (lib/navigateur.ts,
// lib/seances.ts) ; la liste des votes vient de /donnees/votes.json.
import Base from '../layouts/Base.astro';
import Bouton from '../components/vdef/Bouton.astro';
import { questionSeance, scrutins, semaine, voteJuge } from '../lib/donnees.ts';

const sem = semaine();
const JOURS = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
const lendemain = (date: string) => JOURS[(new Date(`${date}T12:00:00Z`).getUTCDay() + 1) % 7];
// La séance de la semaine : ses votes, publiés ou pas encore (le verdict, le lendemain matin).
const seance = sem.vacances ? [] : sem.votes.filter((v) => v.statut !== 'retiré').map((v) => ({
  cle: v.cle, question: questionSeance(v).question, theme: v.carte?.theme ?? '', date: v.date,
  uid: voteJuge(v) ? v.scrutin!.uid : null, verdict: lendemain(v.date),
}));
const donnees = JSON.stringify({
  lundi: sem.lundi, seance,
  horsMatrice: scrutins().filter((s) => s.motion_censure).map((s) => s.uid),
}).replace(/</g, '\\u003c');
const FILTRES = [
  { id: 'toutes', libelle: 'Toutes' },
  { id: 'majorite', libelle: 'Avec la majorité' },
  { id: 'contre-courant', libelle: 'À contre-courant' },
  { id: 'attente', libelle: 'En attente du verdict' },
];
---
<Base titre="Tes réponses" gabarit="lecture" vue="place" bas="place"
  description="Tous les votes que tu as tranchés, du plus récent au plus ancien, avec l'issue de chacun. Ils restent dans ton navigateur.">
  <a class="retour" href="/ta-place/">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
    Ta place
  </a>
  <header class="entete">
    <span class="t-etiquette" data-rep-sous-titre>Du plus récent au plus ancien</span>
    <h1 class="t-ecran">Tes réponses</h1>
  </header>

  <div class="vide" data-rep-vide>
    <p class="t-texte">Tu n’as encore tranché aucun vote. Commence par le quiz : 10 vrais votes de l’Assemblée, environ 2 minutes.</p>
    <Bouton href="/quiz/">Faire le quiz</Bouton>
  </div>

  <div class="contenu" data-rep-contenu hidden>
    <div class="chiffres">
      <div class="chiffre"><span class="t-chiffre" data-rep-n></span><span class="t-texte" data-rep-n-texte></span></div>
      <div class="chiffre"><span class="t-chiffre" data-rep-majorite></span><span class="t-texte">fois avec la majorité, quand le verdict est tombé</span></div>
      <a class="chiffre lien" href="/ta-place/" data-rep-jumeau><span class="t-chiffre" data-rep-jumeau-n></span><span class="t-texte" data-rep-jumeau-texte></span></a>
    </div>

    <div class="filtres" role="group" aria-label="Filtrer tes réponses">
      {FILTRES.map((f, k) => (
        <button type="button" class="filtre" aria-pressed={k === 0 ? 'true' : 'false'} data-filtre={f.id}>
          {f.libelle} · <span data-filtre-n={f.id}>0</span>
        </button>
      ))}
    </div>
    <p class="visuellement-cache" aria-live="polite" data-rep-annonce></p>
    <div class="mois" data-rep-liste></div>
  </div>

  <p class="pied t-legende">
    Tes réponses restent dans ton navigateur : rien n’est envoyé.
    <a href="/calcul/#tes-donnees">Changer ou tout effacer</a>
  </p>
  <script type="application/json" data-donnees-reponses set:html={donnees}></script>
</Base>

<script>
  import { reponses } from '../lib/navigateur.ts';
  import { palierAtteint, prochainPalier, votesTranches } from '../lib/paliers.ts';
  import { profil, type Matrice } from '../lib/profil.ts';
  import { donnee } from '../lib/matrice-cache.ts';
  import { etatSeance } from '../lib/seances.ts';
  import { $, mesReps, pluriel } from '../lib/trancher.ts';

  type Etat = 'majorite' | 'contre-courant' | 'attente' | 'nsp';
  interface Ligne {
    titre: string; theme: string; lien: string; reponse: 'pour' | 'contre' | null;
    etat: Etat; issue: string; date: string;
  }
  type InfoVote = [number, string, string, 0 | 1, string];
  const MOIS = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre',
    'Octobre', 'Novembre', 'Décembre'];

  document.addEventListener('astro:page-load', async () => {
    const brut = document.querySelector('[data-donnees-reponses]')?.textContent;
    if (!brut) return;
    const d = JSON.parse(brut) as {
      lundi: string; horsMatrice: string[];
      seance: { cle: string; question: string; theme: string; date: string; uid: string | null; verdict: string }[];
    };
    const mes = reponses();
    const tranchesSeance = JSON.parse(
      document.querySelector('[data-tranches-seance]')?.textContent ?? '{}') as Record<string, Record<string, string>>;
    const seanceCourante = etatSeance(d.lundi).reponses;
    const aSeance = Object.keys(seanceCourante).length > 0;
    // Les « Je ne sais pas » des séances passées dont le vote a eu lieu.
    const nspPasses: string[] = [];
    for (const [lundi, cles] of Object.entries(tranchesSeance)) {
      if (lundi === d.lundi) continue;
      const r = etatSeance(lundi).reponses;
      for (const [cle, uid] of Object.entries(cles)) if (cle in r && r[cle] === null) nspPasses.push(uid);
    }
    if (!Object.keys(mes).length && !aSeance && !nspPasses.length) return;

    const votes: Record<string, InfoVote> = await donnee('votes.json');
    const issue = (adopte: boolean, r: 'pour' | 'contre' | null) => (adopte ? 'Adopté' : 'Rejeté')
      + (r ? ` · tu étais ${(r === 'pour') === adopte ? 'avec la majorité' : 'à contre-courant'}` : '');
    const lignes: Ligne[] = [];
    const vus = new Set<string>();
    for (const [uid, r] of Object.entries(mes)) {
      const v = votes[uid];
      if (!v) continue;
      vus.add(uid);
      const adopte = v[3] === 1;
      lignes.push({ titre: v[1], theme: v[2], lien: `/votes/${v[0]}/`, reponse: r.v,
        etat: (r.v === 'pour') === adopte ? 'majorite' : 'contre-courant', issue: issue(adopte, r.v), date: r.le.slice(0, 10) });
    }
    // La séance de la semaine : ce qui attend le verdict, et les « Je ne sais pas ».
    for (const s of d.seance) {
      if (!(s.cle in seanceCourante)) continue;
      const r = seanceCourante[s.cle];
      if (s.uid && (vus.has(s.uid) || r !== null)) continue;
      const v = s.uid ? votes[s.uid] : null;
      lignes.push({ titre: s.question, theme: s.theme, lien: v ? `/votes/${v[0]}/` : '/seance/', reponse: r,
        etat: v ? 'nsp' : 'attente', issue: v ? issue(v[3] === 1, null) : `Verdict ${s.verdict} matin`, date: s.date });
    }
    for (const uid of nspPasses) {
      const v = votes[uid];
      if (!v || vus.has(uid)) continue;
      lignes.push({ titre: v[1], theme: v[2], lien: `/votes/${v[0]}/`, reponse: null, etat: 'nsp',
        issue: issue(v[3] === 1, null), date: v[4] });
    }
    lignes.sort((a, b) => b.date.localeCompare(a.date));
    if (!lignes.length) return;

    $('[data-rep-vide]').hidden = true;
    $('[data-rep-contenu]').hidden = false;
    $('[data-rep-sous-titre]').textContent = `Tes ${pluriel(lignes.length, 'vote')}, du plus récent au plus ancien`;

    // Les trois chiffres, chacun avec sa phrase.
    const hors = new Set(d.horsMatrice);
    const reps = Object.fromEntries(Object.entries(mesReps()).filter(([uid]) => !hors.has(uid)));
    const n = votesTranches(reps);
    const nsp = lignes.filter((l) => l.reponse === null).length;
    $('[data-rep-n]').textContent = String(n);
    $('[data-rep-n-texte]').textContent = `vote${n > 1 ? 's' : ''} tranché${n > 1 ? 's' : ''}`
      + (nsp ? `, et ${nsp} « je ne sais pas »` : '');
    const juges = lignes.filter((l) => l.etat === 'majorite' || l.etat === 'contre-courant');
    const avec = juges.filter((l) => l.etat === 'majorite').length;
    $('[data-rep-majorite]').textContent = `${avec} sur ${juges.length}`;
    const carteJumeau = $<HTMLAnchorElement>('[data-rep-jumeau]');
    if (palierAtteint(n)) {
      const m: Matrice = await donnee('matrice.json');
      const j = profil(m, reps).jumeau;
      $('[data-rep-jumeau-n]').textContent = String(j?.identiques ?? 0);
      $('[data-rep-jumeau-texte]').textContent = j ? `fois comme ton jumeau, ${j.ligne.n}` : 'fois comme ton jumeau';
      if (j) carteJumeau.href = `/deputes/${j.ligne.u}/`;
    } else {
      const reste = prochainPalier(n)!.reste;
      $('[data-rep-jumeau-n]').textContent = String(reste);
      $('[data-rep-jumeau-texte]').textContent = `vote${reste > 1 ? 's' : ''} de plus pour prendre ta place`;
      carteJumeau.href = '/ta-place/';
    }

    // La liste, groupée par mois.
    const filtres = [...document.querySelectorAll<HTMLButtonElement>('[data-filtre]')];
    const garde = (f: string, l: Ligne) => f === 'toutes' || l.etat === f;
    for (const b of filtres) $(`[data-filtre-n="${b.dataset.filtre}"]`).textContent = String(lignes.filter((l) => garde(b.dataset.filtre!, l)).length);
    const dessiner = (f: string) => {
      const liste = $('[data-rep-liste]');
      const groupes = new Map<string, Ligne[]>();
      for (const l of lignes.filter((x) => garde(f, x))) {
        const cle = `${MOIS[Number(l.date.slice(5, 7)) - 1]} ${l.date.slice(0, 4)}`;
        groupes.set(cle, [...(groupes.get(cle) ?? []), l]);
      }
      liste.replaceChildren(...[...groupes].map(([mois, ls]) => {
        const sec = document.createElement('section');
        const h = document.createElement('h2');
        h.className = 'titre-mois';
        h.textContent = mois;
        const ul = document.createElement('ul');
        ul.className = 'votes';
        for (const l of ls) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = l.lien;
          a.innerHTML = '<span class="q"><span class="question"></span><span class="theme t-legende"></span></span>'
            + '<span class="toi"><span class="point" aria-hidden="true"></span><span class="toi-texte"></span></span>'
            + '<span class="issue"></span>'
            + '<svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>';
          a.querySelector('.question')!.textContent = l.titre;
          const theme = a.querySelector<HTMLElement>('.theme')!;
          if (l.theme) theme.textContent = l.theme; else theme.remove();
          a.querySelector('.point')!.className = `point ${l.reponse ?? 'non-votant'}`;
          a.querySelector('.toi-texte')!.textContent = `Toi : ${l.reponse === 'pour' ? 'Pour' : l.reponse === 'contre' ? 'Contre' : 'Je ne sais pas'}`;
          a.querySelector('.issue')!.textContent = l.issue;
          li.append(a);
          ul.append(li);
        }
        sec.append(h, ul);
        return sec;
      }));
    };
    for (const b of filtres) {
      b.addEventListener('click', () => {
        for (const x of filtres) x.setAttribute('aria-pressed', String(x === b));
        dessiner(b.dataset.filtre!);
        const k = lignes.filter((l) => garde(b.dataset.filtre!, l)).length;
        $('[data-rep-annonce]').textContent = `${pluriel(k, 'vote')} affiché${k > 1 ? 's' : ''}.`;
      });
    }
    dessiner('toutes');
  });
</script>

<style>
  .entete { display: flex; flex-direction: column; gap: 8px; }
  .vide { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .contenu { display: flex; flex-direction: column; gap: 28px; }
  .chiffres { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .chiffre {
    display: flex; flex-direction: column; gap: 10px; padding: 22px 20px; border-radius: 20px;
    background: var(--surface); color: var(--encre); text-decoration: none;
  }
  .chiffre .t-texte { font-size: 15px; line-height: 1.4; }
  a.chiffre:hover { box-shadow: inset 0 0 0 2px var(--encre); }
  .filtres { display: flex; flex-wrap: wrap; gap: 8px; }
  .filtre {
    min-height: 44px; padding: 0 16px; border-radius: var(--pilule); border: 1px solid var(--bord);
    background: var(--feuille); color: var(--encre); font: 600 14px/1 var(--police-texte); cursor: pointer;
  }
  .filtre[aria-pressed='true'] { background: var(--encre); border-color: var(--encre); color: var(--feuille); }
  .mois { display: flex; flex-direction: column; gap: 24px; }
  .mois :global(.titre-mois) { font: 700 19px/1.2 var(--police-titre); padding-bottom: 10px; border-bottom: 1px solid var(--filet); }
  .mois :global(.votes) { list-style: none; margin: 0; padding: 0; }
  .mois :global(.votes li) { border-bottom: 1px solid var(--filet); }
  .mois :global(.votes a) {
    display: grid; grid-template-columns: minmax(0, 1fr) 190px 290px 20px; align-items: center; gap: 16px;
    padding: 14px 4px; color: var(--encre); text-decoration: none;
  }
  .mois :global(.votes a:hover) { background: var(--surface); }
  .mois :global(.q) { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .mois :global(.question) { font: 600 16px/1.35 var(--police-texte); }
  .mois :global(.toi) { display: inline-flex; align-items: center; gap: 8px; font: 700 14px/1.3 var(--police-texte); }
  .mois :global(.issue) { font: 600 14px/1.35 var(--police-texte); color: var(--texte); }
  .pied { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 8px; }
  .pied a { color: var(--encre); font-weight: 600; }
  @media (max-width: 900px) {
    .chiffres { grid-template-columns: 1fr; }
    .mois :global(.votes a) { grid-template-columns: minmax(0, 1fr) 20px; gap: 6px 12px; }
    .mois :global(.q) { grid-column: 1; }
    .mois :global(.toi), .mois :global(.issue) { grid-column: 1; }
    .mois :global(.chevron) { grid-column: 2; grid-row: 1 / span 3; }
  }
</style>
