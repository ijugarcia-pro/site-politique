---
// Fiche d'un député (frame V5 « Ma députée ») : identité, groupe, circonscription, place dans
// l'hémicycle, participation, votes contre son groupe, et ses votes face aux réponses du
// visiteur (calculées dans le navigateur). Pas de photo : des initiales, comme la maquette.
import Base from '../../layouts/Base.astro';
import MiniHemicycle from '../../components/MiniHemicycle.astro';
import { composition, dateLisible, deputes, ficheDepute, LIBELLES, lienVote, majuscule,
  medianes, nomComplet, scrutins, type Position } from '../../lib/donnees.ts';
import { libelleCirco } from '../../lib/geo.ts';
import { FAMILLES, famille, verdict } from '../../lib/votes.ts';

export function getStaticPaths() {
  return deputes().map((d) => ({ params: { uid: d.uid } }));
}

const { uid } = Astro.params as { uid: string };
const d = ficheDepute(uid);
const elle = d.civilite === 'Mme';
const e = elle ? 'e' : '';
const nom = nomComplet(d);
const PARTICULES = new Set(['de', 'du', 'des', 'la', 'le', "d'"]);
const initiales = [d.prenom, d.nom.split(/[\s-]+/).find((m) => !PARTICULES.has(m.toLowerCase())) ?? d.nom]
  .map((m) => m.charAt(0).toUpperCase()).join('');
const index = new Map(scrutins().map((s) => [s.uid, s]));
const votes = d.votes.filter((v) => index.has(v.uid)).map((v) => ({ ...v, s: index.get(v.uid)! }));
const t = d.chiffres.tous;
const pris = t.pour + t.contre + t.abstention;
const pct = (a: number, b: number) => (b ? Math.round((100 * a) / b) : 0);
const sol = d.chiffres.solennels;
const prisSol = sol.pour + sol.contre + sol.abstention;
const dissidences = votes.filter((v) => v.dissident).length;
const reperes = medianes();
const compo = composition();
const siege = compo.sieges.findIndex((s) => s.depute === uid);
const couleurs = compo.sieges.map((s) => s.vacant ? '#FFFFFF'
  : s.groupe === d.groupe ? '#A98BFF' : '#DCE0E8');
const membres = compo.sieges.filter((s) => s.groupe === d.groupe).length;
const censures = votes.filter((v) => v.s.motion_censure).map((v) => v.uid);
const libelleVote = (vote: Position, censure: boolean) => censure
  ? (vote === 'pour' ? 'pour la censure' : vote === 'absent' ? "ne l'a pas votée" : LIBELLES[vote])
  : LIBELLES[vote];
const description = `${nom}, ${elle ? 'députée' : 'député'} ${d.sigle ? `(${d.sigle}) ` : ''}de la ${libelleCirco(d.circo)} ${d.departement === 'Français établis hors de France' ? 'des Français établis hors de France' : `(${d.departement})`} : ses votes, sa participation, ses votes contre son groupe.`;
---
<Base titre={nom} description={description} onglet="explorer">
  <nav class="fil" aria-label="Fil d'Ariane">
    <a href="/explorer/">Explorer</a> <span aria-hidden="true">›</span>
    <a href="/deputes/">Députés</a> <span aria-hidden="true">›</span>
    <span aria-current="page">{nom}</span>
  </nav>

  <div class="bandeau-mien" data-bandeau hidden>
    <span class="coche" aria-hidden="true">✓</span>
    <span><strong>{elle ? 'Ta députée' : 'Ton député'}</strong> · {libelleCirco(d.circo)} · {d.departement}</span>
    <a href="/deputes/">Changer</a>
  </div>

  <section class="identite" aria-labelledby="nom-depute">
    <span class="avatar" aria-hidden="true">{initiales}</span>
    <div class="identite-texte">
      <h1 id="nom-depute">{nom}</h1>
      <div class="puces">
        {d.groupe_libelle && <span class="puce-groupe">{d.groupe_libelle}{d.sigle && d.sigle !== d.groupe_libelle ? ` (${d.sigle})` : ''}</span>}
        <span class="puce-gris">{libelleCirco(d.circo)} · {d.departement}</span>
        {d.place && d.en_exercice && <span class="puce-gris">Siège n° {d.place}</span>}
        {!d.en_exercice && d.fin && (
          <span class="puce-fin">Mandat terminé le {dateLisible(d.fin)}{d.cause_fin ? ` (${d.cause_fin.toLowerCase()})` : ''}</span>
        )}
      </div>
      <p class="depuis">
        {elle ? 'Députée' : 'Député'} depuis le {dateLisible(d.mandats[0]?.debut ?? d.debut)}.
      </p>
    </div>
    <div class="identite-cote">
      <div class="anneau" data-anneau hidden>
        <span class="anneau-interieur">
          <span class="anneau-pct" data-anneau-pct></span>
          <span class="anneau-legende">comme toi</span>
        </span>
      </div>
      <p class="anneau-note" data-anneau-note hidden></p>
      {d.en_exercice && (
        <button type="button" class="mon-depute" data-mon-depute data-uid={uid} aria-pressed="false">
          <span data-libelle-off>C'est {elle ? 'ma députée' : 'mon député'}</span>
          <span data-libelle-on hidden>✓ {elle ? 'Ta députée' : 'Ton député'}</span>
        </button>
      )}
    </div>
  </section>

  <div class="stats">
    <p class="stat-sombre">
      <span class="sur-titre">Sur la législature</span>
      <span>
        A pris part à <strong>{pct(pris, t.scrutins)} %</strong> des {t.scrutins.toLocaleString('fr-FR')} scrutins
        de son mandat, amendements compris : la plupart ne réunissent qu'une partie des
        députés. Aux votes solennels, où tous sont appelés à voter : <strong>{pct(prisSol, sol.scrutins)} %</strong>.
      </span>
    </p>
    <div class="stat violet">
      <span class="stat-chiffre">{pct(pris, t.scrutins)}<span class="sur"> %</span></span>
      <span class="stat-legende">de participation</span>
      <span class="stat-repere">médiane des députés : {reperes.participation} %</span>
    </div>
    <div class="stat jaune">
      <span class="stat-chiffre">{pct(prisSol, sol.scrutins)}<span class="sur"> %</span></span>
      <span class="stat-legende">aux votes solennels ({prisSol} sur {sol.scrutins})</span>
      <span class="stat-repere">médiane des députés : {reperes.solennels} %</span>
    </div>
    <div class="stat orange">
      <span class="stat-chiffre">{t.contre_groupe}</span>
      <span class="stat-legende">votes contre son groupe</span>
      <span class="stat-repere">médiane des députés : {reperes.contreGroupe}</span>
    </div>
  </div>

  <div class="mise-en-page">
    <section class="ses-votes" aria-labelledby="titre-votes">
      <div class="titre-section">
        <h2 id="titre-votes">Ses votes face aux tiens</h2>
        <span>{votes.length} votes de son mandat</span>
      </div>
      <p class="aide" data-aide>
        Les votes qui ont une page sur le site : textes votés dans leur ensemble, budgets,
        résolutions, motions de censure. Tranche-les pour te comparer.
      </p>
      <div class="filtres" role="group" aria-label="Filtrer ses votes">
        <button type="button" data-filtre="" aria-pressed="true">Tous</button>
        <button type="button" data-filtre="solennel" aria-pressed="false">Solennels</button>
        {dissidences > 0 && <button type="button" data-filtre="dissident" aria-pressed="false">Contre son groupe ({dissidences})</button>}
        <button type="button" data-filtre="repondu" aria-pressed="false">Ceux que j'ai tranchés</button>
      </div>
      <div class="entetes" aria-hidden="true">
        <span>Vote</span><span>{elle ? 'Elle' : 'Lui'}</span><span>Son groupe</span><span>Toi</span>
      </div>
      <ul class="lignes" data-lignes>
        {votes.map((v) => {
          const f = famille(v.s);
          return (
            <li data-uid={v.uid} data-vote={v.vote} data-solennel={v.s.solennel ? '1' : undefined}
              data-dissident={v.dissident ? '1' : undefined} data-censure={v.s.motion_censure ? '1' : undefined}>
              <span class="vote-titre">
                <span class="meta">
                  <span class:list={['etiquette', { solennel: v.s.solennel && f !== 'censure', censure: f === 'censure' }]}>
                    {v.s.solennel && f !== 'censure' ? 'Solennel' : FAMILLES[f]}
                  </span>
                  {dateLisible(v.s.date)} · {verdict(v.s)}
                </span>
                <a href={lienVote(v.s)}>{majuscule(v.s.titre).replace(/\.$/, '')}</a>
              </span>
              <span class="cellule" data-l={elle ? 'Elle' : 'Lui'}>
                <span class:list={['pastille', `p-${v.vote}`]}>{libelleVote(v.vote, v.s.motion_censure)}</span>
                {v.dissident && <span class="contre-groupe" title="Vote contraire à la majorité de son groupe">contre son groupe</span>}
                {v.mise_au_point && <span class="mise-au-point">mise au point : {LIBELLES[v.mise_au_point as Position] ?? v.mise_au_point}</span>}
              </span>
              <span class="cellule" data-l="Son groupe">
                <span class="groupe">{v.groupe ?? '—'}{v.position_groupe && !v.s.motion_censure ? ` : ${LIBELLES[v.position_groupe as Position] ?? v.position_groupe}` : ''}</span>
              </span>
              <span class="cellule" data-l="Toi">
                <span class="toi" data-toi>
                  {v.s.motion_censure ? '—' : <a href={`${lienVote(v.s)}#qui-a-vote`}>Trancher</a>}
                </span>
              </span>
            </li>
          );
        })}
      </ul>
      <p class="vide" data-vide hidden>Aucun vote ne correspond à ce filtre.</p>
      <button type="button" class="bouton" data-plus hidden>Afficher plus de votes</button>
    </section>

    <aside class="cote">
      {siege >= 0 && (
        <section class="encadre gris" aria-labelledby="titre-siege">
          <h2 id="titre-siege">Où {elle ? 'elle' : 'il'} siège</h2>
          <MiniHemicycle couleurs={couleurs} marque={siege}
            titre={`Hémicycle : le siège de ${nom}, entouré, parmi les ${membres} membres de son groupe, en violet`} />
          <p>
            Entouré{e}, son siège ; en violet, les {membres} membres de son groupe
            {d.sigle ? ` (${d.sigle})` : ''}. Sur les votes de cette page, {elle ? 'elle' : 'il'} a voté
            contre la majorité de son groupe <strong>{dissidences} fois</strong>.
          </p>
        </section>
      )}
      <section class="encadre" aria-labelledby="titre-parcours">
        <h2 id="titre-parcours">Son parcours</h2>
        <ul class="parcours">
          {d.groupes.map((g) => (
            <li>
              <strong>{g.libelle}</strong>
              <span>{g.fin ? `du ${dateLisible(g.debut)} au ${dateLisible(g.fin)}` : `depuis le ${dateLisible(g.debut)}`}</span>
            </li>
          ))}
        </ul>
        {d.mandats.length > 1 && (
          <p class="note">{d.mandats.length} mandats dans cette législature (par exemple après un passage au Gouvernement).</p>
        )}
      </section>
      <section class="encadre" aria-labelledby="titre-lire">
        <h2 id="titre-lire">Comment lire ces chiffres</h2>
        <p>Participation : votes pour, contre ou abstention, rapportés à tous les scrutins de son
        mandat, hors motions de censure.</p>
        <p>Une absence n'est pas forcément un désintérêt : un député peut siéger en commission
        au même moment.</p>
        <p><a href={d.lien}>Sa fiche sur le site de l'Assemblée nationale</a></p>
      </section>
    </aside>
  </div>
  <script type="application/json" data-censures set:html={JSON.stringify(censures)}></script>
</Base>

<script>
  import { accord } from '../../lib/accord.ts';
  import { choisirDepute, deputeChoisi, reponses } from '../../lib/navigateur.ts';

  const PAR_PAGE = 25;
  const lignes = [...document.querySelectorAll<HTMLElement>('[data-lignes] > li')];
  const mesReponses = Object.fromEntries(Object.entries(reponses()).map(([k, r]) => [k, r.v]));
  const censures = new Set<string>(JSON.parse(
    document.querySelector('[data-censures]')?.textContent ?? '[]'));

  // Colonne « Toi » et marque d'accord.
  for (const l of lignes) {
    const r = mesReponses[l.dataset.uid!];
    if (!r || l.dataset.censure) continue;
    l.dataset.repondu = '1';
    const toi = l.querySelector<HTMLElement>('[data-toi]')!;
    toi.textContent = '';
    const p = document.createElement('span');
    p.className = `pastille p-${r}`;
    p.textContent = r;
    toi.append(p);
    const v = l.dataset.vote;
    if (v === 'pour' || v === 'contre' || v === 'abstention') {
      const m = document.createElement('span');
      const pareil = v === r;
      m.className = `marque ${pareil ? 'oui' : 'non'}`;
      m.textContent = pareil ? '=' : '≠';
      m.title = pareil ? 'Même vote que toi' : 'Vote différent du tien';
      toi.append(m);
    }
  }

  // Taux d'accord, s'il y a des votes en commun.
  const a = accord(lignes.map((l) => ({ uid: l.dataset.uid!, vote: l.dataset.vote! })),
    mesReponses, censures);
  if (a.taux !== null) {
    const anneau = document.querySelector<HTMLElement>('[data-anneau]')!;
    anneau.hidden = false;
    anneau.style.setProperty('--pct', `${a.taux}%`);
    document.querySelector('[data-anneau-pct]')!.textContent = `${a.taux} %`;
    const note = document.querySelector<HTMLElement>('[data-anneau-note]')!;
    note.hidden = false;
    note.textContent = `sur ${a.communs} vote${a.communs > 1 ? 's' : ''} en commun`;
    document.querySelector('[data-aide]')!.textContent =
      `Vous avez pris position tous les deux sur ${a.communs} vote${a.communs > 1 ? 's' : ''} : `
      + `même réponse ${a.identiques} fois. Une abstention de sa part compte comme une réponse différente.`;
  }

  // « C'est mon député ».
  const bouton = document.querySelector<HTMLButtonElement>('[data-mon-depute]');
  const bandeau = document.querySelector<HTMLElement>('[data-bandeau]')!;
  const majBouton = () => {
    const mien = deputeChoisi() === bouton?.dataset.uid;
    bandeau.hidden = !mien;
    if (!bouton) return;
    bouton.setAttribute('aria-pressed', String(mien));
    bouton.querySelector<HTMLElement>('[data-libelle-off]')!.hidden = mien;
    bouton.querySelector<HTMLElement>('[data-libelle-on]')!.hidden = !mien;
  };
  bouton?.addEventListener('click', () => {
    const mien = deputeChoisi() === bouton.dataset.uid;
    choisirDepute(mien ? null : bouton.dataset.uid!);
    majBouton();
  });
  majBouton();

  // Filtres et pagination de la liste.
  const boutons = [...document.querySelectorAll<HTMLButtonElement>('[data-filtre]')];
  const plus = document.querySelector<HTMLButtonElement>('[data-plus]')!;
  const vide = document.querySelector<HTMLElement>('[data-vide]')!;
  let filtre = '';
  let limite = PAR_PAGE;
  const appliquer = () => {
    const retenues = lignes.filter((l) => !filtre || l.dataset[filtre] === '1');
    for (const l of lignes) l.hidden = true;
    retenues.slice(0, limite).forEach((l) => { l.hidden = false; });
    vide.hidden = retenues.length > 0;
    plus.hidden = retenues.length <= limite;
    plus.textContent = `Afficher plus de votes (${retenues.length - limite} restants)`;
  };
  for (const b of boutons) {
    b.addEventListener('click', () => {
      filtre = b.dataset.filtre ?? '';
      for (const autre of boutons) autre.setAttribute('aria-pressed', String(autre === b));
      limite = PAR_PAGE;
      appliquer();
    });
  }
  plus.addEventListener('click', () => { limite += PAR_PAGE; appliquer(); });
  appliquer();
</script>

<style>
  .fil { display: flex; flex-wrap: wrap; gap: 8px; font-size: 15px; color: var(--gris-legende); }
  .fil a { text-decoration: none; font-weight: 700; }
  .fil a:hover { text-decoration: underline; }

  .bandeau-mien {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    padding: 14px 18px;
    border-radius: 20px;
    background: #F3EEFF;
    border: 2px solid #E3DAFF;
    font-size: 16px;
  }
  .bandeau-mien a { margin-left: auto; font-family: var(--police-titre); font-weight: 600; }
  .coche {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border-radius: 50%; background: #1CB37A; color: #fff; font-weight: 700;
  }

  .identite {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px 32px;
    padding: clamp(20px, 2.6vw, 28px);
    border: 2px solid var(--bord);
    border-radius: 28px;
    box-shadow: 0 6px 0 var(--bord);
  }
  .avatar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(80px, 9vw, 108px);
    height: clamp(80px, 9vw, 108px);
    border-radius: 30px;
    background: var(--violet-voile);
    color: var(--violet-fonce);
    box-shadow: 0 6px 0 var(--violet-pale);
    font-family: var(--police-titre);
    font-weight: 700;
    font-size: clamp(30px, 3.4vw, 38px);
  }
  .identite-texte { flex: 1 1 340px; min-width: 0; }
  .identite h1 { font-size: clamp(30px, 3.6vw, 42px); overflow-wrap: anywhere; }
  .puces { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .puces span {
    padding: 6px 14px;
    border-radius: 999px;
    font-family: var(--police-titre);
    font-weight: 600;
    font-size: 14px;
  }
  .puce-groupe { background: var(--violet-voile); color: var(--violet-fonce); }
  .puce-gris { background: var(--fond-doux); color: var(--texte-doux); }
  .puce-fin { background: #FFE6DA; color: #9C3207; }
  .depuis { margin: 10px 0 0; font-size: 15px; color: var(--gris); }
  .identite-cote { flex: none; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .anneau {
    --pct: 0%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 116px;
    height: 116px;
    border-radius: 50%;
    background: conic-gradient(var(--violet) 0 var(--pct), var(--bord-leger) var(--pct) 100%);
  }
  .anneau-interieur {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    width: 88px; height: 88px; border-radius: 50%; background: var(--fond);
  }
  .anneau-pct { font-family: var(--police-titre); font-weight: 700; font-size: 26px; line-height: 1; }
  .anneau-legende { font-size: 12px; color: var(--gris); }
  .anneau-note { margin: 0; font-size: 13px; color: var(--gris); }
  .mon-depute {
    min-height: 50px;
    padding: 0 20px;
    border: 2px solid #C9B8FF;
    border-radius: 16px;
    background: var(--fond);
    box-shadow: 0 4px 0 #E3DAFF;
    font-family: var(--police-titre);
    font-weight: 600;
    font-size: 15px;
    color: var(--violet-fonce);
    cursor: pointer;
  }
  .mon-depute[aria-pressed='true'] { background: #DFF7EC; border-color: #9BE3C4; color: #0C7F57; box-shadow: 0 4px 0 #BCEBD6; }

  .stats { display: grid; grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 1080px) { .stats { grid-template-columns: repeat(3, minmax(0, 1fr)); } .stat-sombre { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .stats { grid-template-columns: minmax(0, 1fr); } }
  .stat-sombre {
    display: flex; flex-direction: column; gap: 6px; margin: 0;
    padding: 18px 22px; border-radius: 22px; background: var(--texte); color: #fff; font-size: 16px;
  }
  .stat-sombre .sur-titre {
    font-family: var(--police-titre); font-weight: 600; font-size: 13px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--abstention);
  }
  .stat { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border-radius: 22px; }
  .stat-chiffre { font-family: var(--police-titre); font-weight: 700; font-size: 34px; line-height: 1; }
  .stat-chiffre .sur { font-size: 18px; opacity: 0.6; }
  .stat-legende { font-size: 14px; font-weight: 700; }
  .stat-repere { margin-top: auto; font-size: 13px; opacity: 0.8; }
  .violet { background: #EFE9FF; color: var(--violet-encre); }
  .jaune { background: #FFF8E1; color: #7A4A00; }
  .orange { background: #FFF1E0; color: #7A3F00; }

  .mise-en-page { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 32px; align-items: start; }
  @media (max-width: 1080px) { .mise-en-page { grid-template-columns: minmax(0, 1fr); } }
  .titre-section { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 12px; }
  .titre-section h2 { font-size: clamp(22px, 2.4vw, 26px); }
  .titre-section span { font-size: 14px; color: var(--gris); }
  .aide { margin: 6px 0 12px; font-size: 15px; color: var(--texte-doux); }
  .filtres { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .filtres button {
    min-height: 40px; padding: 0 14px; border: 2px solid var(--bord); border-radius: 999px;
    background: var(--fond); font-family: var(--police-titre); font-weight: 600; font-size: 14px;
    color: var(--texte-doux); cursor: pointer;
  }
  .filtres button[aria-pressed='true'] { background: var(--violet); border-color: var(--violet); color: #fff; }
  @media (max-width: 700px) {
    .filtres { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    .filtres button { flex: none; }
  }
  .entetes, .lignes li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px 120px 110px;
    gap: 12px;
    align-items: center;
  }
  .entetes {
    padding: 0 0 8px;
    font-family: var(--police-titre);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8A91A3;
