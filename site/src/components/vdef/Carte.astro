---
// Carte (VDEF § 7) : surface grise, petite étiquette grise en haut, chevron si elle mène quelque
// part. Variante noire pour la chose la plus importante de l'écran (une seule par écran) ;
// variante « bordee » (fond blanc, filet) pour un bloc posé sur la feuille sans le recouvrir.
interface Props {
  etiquette?: string;
  href?: string;
  variante?: 'grise' | 'noire' | 'bordee';
  class?: string;
  [attr: string]: unknown;
}
const { etiquette, href, variante = 'grise', class: classe, ...reste } = Astro.props;
const Balise = href ? 'a' : 'div';
---
<Balise href={href} class:list={['carte', variante, classe]} {...reste}>
  {(etiquette || href) && (
    <span class="haut">
      {etiquette && <span class="etiquette">{etiquette}</span>}
      {href && (
        <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      )}
    </span>
  )}
  <slot />
</Balise>

<style>
  .carte {
    display: flex; flex-direction: column; gap: 10px; min-width: 0;
    padding: 18px 20px; border-radius: var(--rayon-carte);
    color: var(--encre); text-decoration: none;
  }
  .grise { background: var(--surface); }
  .noire { background: var(--encre); color: var(--feuille); }
  .bordee { background: var(--feuille); border: 1px solid var(--filet); }
  .haut { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .etiquette { font: 600 14px/1.35 var(--police-texte); color: var(--texte-2); }
  .noire .etiquette { color: var(--sur-encre-2); }
  .chevron { flex: 0 0 auto; margin-left: auto; }
  a.carte:hover { box-shadow: inset 0 0 0 2px var(--encre); }
  a.noire:hover { box-shadow: inset 0 0 0 2px var(--sur-encre-2); }
</style>
