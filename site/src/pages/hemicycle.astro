---
// Mon hémicycle (frame V5 « ⑩ Mon hémicycle ») : tes réponses comparées une à une aux votes des
// députés et des groupes, dans ton navigateur (lib/profil.ts). Plus un siège est lumineux, plus ce
// député vote comme toi. Autour de l'arc, chaque groupe a sa part, bordée et étiquetée de la
// couleur que l'Assemblée lui associe ; l'étoile marque ta place, au-dessus du groupe qui vote
// le plus comme toi. Sans réponse : l'Assemblée du jour, chaque siège à la couleur de son
// groupe, et l'invitation au quiz d'entrée.
import Base from '../layouts/Base.astro';
import Salle from '../components/Salle.astro';
import Salle3D from '../components/Salle3D.astro';
import { composition, lienVote, majuscule, scrutins } from '../lib/donnees.ts';
import { NIVEAUX, SANS_VOTE_COMMUN } from '../lib/profil.ts';
import { COIFFURES, PEAUX, TENUES } from '../salle3d/apparence.ts';

const compo = composition();
const occupes = compo.sieges.filter((s) => !s.vacant).length;
// De quoi lister les réponses du visiteur : identifiant → [lien, titre, adopté].
const titres = Object.fromEntries(scrutins().map((s) => {
  const t = majuscule(s.titre).replace(/\.$/, '');
  return [s.uid, [lienVote(s), t.length > 110 ? `${t.slice(0, 108)}…` : t, s.sort === 'adopté']];
}));
const donnees = JSON.stringify(titres).replace(/</g, '\\u003c');
---
<Base titre="Mon hémicycle" onglet="hemicycle" theme="seance"
  description="Ton hémicycle : les députés et les groupes qui votent le plus comme toi, calculés dans ton navigateur à partir de vrais votes.">
  <Salle3D titre="La salle de l'Assemblée nationale : le voyant de chaque pupitre brille d'autant plus que ce député vote comme toi ; ta place, le siège de ton jumeau, est signalée."
    cameras={['travee', 'salle', 'tribune', 'plan']} planSurTelephone>
    <div class="bandeau">
      <div class="bandeau-ligne">
        <span class="bandeau-etiquette">Mon hémicycle</span>
        <span class="bandeau-titre" data-bandeau-place>Le 578<sup>e</sup> siège t'attend</span>
      </div>
    </div>
  </Salle3D>

  <div class="rangee">
    <section class="salle" aria-labelledby="titre-hemicycle">
      <div class="titre-section">
        <h1 id="titre-hemicycle">Ton hémicycle</h1>
        <span data-sous-titre>Les {occupes} députés du jour, à la couleur de leur groupe</span>
      </div>
      <div class="cadre-salle">
        <Salle sieges={compo.sieges} groupes={compo.groupes} titre="L'Assemblée nationale"
          couleursGroupes chiffre={String(occupes)} legende="députés en exercice" />
      </div>
      <p class="visuellement-cache" aria-live="polite" data-info></p>
      <ul class="legende" data-legende hidden>
        {NIVEAUX.map((t) => <li><span style={`background: ${t.couleur}`}></span>{t.libelle}</li>)}
        <li><span class="sans" style={`border-color: ${SANS_VOTE_COMMUN}`}></span>Aucun vote en commun</li>
      </ul>
      <p class="aide-survol">Survole un siège pour voir son député ; clique pour ouvrir sa fiche.</p>
    </section>

    <section class="cote" aria-label="Ta place">
      <div class="encadre place">
        <div class="sur-titre">Ta place</div>
        <div class="place-titre" data-place-titre>Le 578<sup>e</sup> siège t'attend</div>
        <p data-place-texte>
          Réponds à 10 vrais votes : on compare tes réponses, une à une, à celles des 577
          députés. Aucun axe gauche-droite : seulement des votes réels.
        </p>
        <a class="bouton-violet" href="/quiz/" data-cta-quiz>Faire le quiz · 2 min</a>
      </div>

      <div class="precision" data-bloc-precision hidden>
        <div class="titre-carte">
          <span class="precision-titre">Précision</span>
          <span class="grand" data-precision></span>
        </div>
        <div class="segments" aria-hidden="true" data-segments>
          {Array.from({ length: 10 }, () => <span></span>)}
        </div>
        <p data-precision-note></p>
        <a class="bouton-violet" href="/lots/">Trancher des votes passés</a>
      </div>

      <div class="tuiles" data-tuiles hidden>
        <div class="tuile orange">
          <div class="tuile-chiffre" data-tranches></div>
          <div class="tuile-legende">votes tranchés</div>
        </div>
        <div class="tuile jaune">
          <div class="tuile-chiffre"><span data-comme-final></span><small data-sur-final></small></div>
          <div class="tuile-legende">comme le vote final</div>
        </div>
      </div>

      <form class="encadre personnage" data-personnage>
        <div class="sur-titre">Ton personnage</div>
        <p>Il t'attend au pied de la tribune, puis s'assoit à ta place, le siège de ton jumeau. Ses choix restent dans ton navigateur.</p>
        <fieldset>
          <legend>Peau</legend>
          <div class="choix-perso">
            {PEAUX.map((x) => (
              <label class="pastille-choix" title={x.nom}>
                <input type="radio" name="peau" value={x.id} class="visuellement-cache" />
                <span style={`--teinte: ${x.c}`} aria-hidden="true"></span><span class="visuellement-cache">{x.nom}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend>Coiffure</legend>
          <div class="choix-perso">
            {COIFFURES.map((x) => (
              <label class="mot-choix"><input type="radio" name="coiffure" value={x.id} class="visuellement-cache" /><span>{x.nom}</span></label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend>Tenue</legend>
          <div class="choix-perso">
            {TENUES.map((x) => (
              <label class="pastille-choix" title={x.nom}>
                <input type="radio" name="tenue" value={x.id} class="visuellement-cache" />
                <span style={`--teinte: ${x.haut}`} aria-hidden="true"></span><span class="visuellement-cache">{x.nom}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </form>
    </section>
  </div>

  <div class="trio" data-trio hidden>
    <a class="personne jumeau carte-relief" data-personne="jumeau">
      <span class="sur-titre">Ton jumeau</span>
      <span class="personne-ligne">
        <span class="avatar" data-ini></span>
        <span class="personne-texte"><span class="nom" data-nom></span><span class="detail" data-detail></span></span>
        <span class="score" data-score></span>
      </span>
      <span class="phrase">Le député qui vote le plus souvent comme toi, parmi ceux en exercice.</span>
    </a>
    <a class="personne oppose" data-personne="oppose">
      <span class="sur-titre">Ton opposé</span>
      <span class="personne-ligne">
        <span class="avatar" data-ini></span>
        <span class="personne-texte"><span class="nom" data-nom></span><span class="detail" data-detail></span></span>
        <span class="score" data-score></span>
      </span>
      <span class="phrase">Le député qui vote le moins souvent comme toi.</span>
    </a>
    <a class="personne depute carte-relief" data-personne="depute" href="/deputes/">
      <span class="sur-titre" data-sur-titre-depute>Ton député</span>
      <span class="personne-ligne">
        <span class="avatar" data-ini>?</span>
        <span class="personne-texte"><span class="nom" data-nom>À choisir</span><span class="detail" data-detail>Avec ton code postal</span></span>
        <span class="score" data-score></span>
      </span>
      <span class="phrase" data-phrase>Retrouve qui te représente et compare ses votes aux tiens.</span>
    </a>
  </div>

  <div class="rangee">
    <section class="encadre groupes-bloc" aria-labelledby="titre-groupes" data-bloc-groupes hidden>
      <h2 id="titre-groupes">Les groupes, du plus proche au plus lointain</h2>
      <ul class="groupes" data-groupes></ul>
    </section>
    <section class="encadre reponses" aria-labelledby="titre-reponses">
      <div class="titre-carte">
        <h2 id="titre-reponses">Tes réponses</h2>
        <span class="compteur" data-compteur>0</span>
      </div>
      <p data-texte-reponses>
        Tu n'as encore tranché aucun vote. Commence par le quiz, ou par n'importe quelle page de
        vote : « Et toi, qu'aurais-tu voté ? »
      </p>
      <ul class="liste-reponses" data-liste-reponses hidden></ul>
      <p class="discret">Tes réponses restent dans ton navigateur : rien n'est envoyé.</p>
    </section>
  </div>
  <script type="application/json" data-donnees set:html={donnees}></script>
</Base>

<script>
  import { deputeChoisi, reponses } from '../lib/navigateur.ts';
  import { comparer, colonnes, initiales, niveau, profil, VOTES_FIABLES, type Classe,
    type LigneDepute, type Matrice } from '../lib/profil.ts';
  import { libelleCirco } from '../lib/geo.ts';
  import { pastille, Salle } from '../lib/salle.ts';
  import { NIVEAUX } from '../lib/profil.ts';
  import { salle3D } from '../salle3d/pilote.ts';
  import { CLE_PERSONNAGE, lireApparence, VOTES_POUR_SIEGER } from '../salle3d/apparence.ts';

  // Le personnage du visiteur (578e.personnage.v1) : son apparence, et le député dont il a pris
  // le siège (pour ne marcher qu'une fois jusqu'à une nouvelle place).
  const lirePerso = () => { try { return JSON.parse(localStorage.getItem(CLE_PERSONNAGE) ?? 'null') ?? {}; } catch { return {}; } };
  const sauverPerso = (x: object) => { try { localStorage.setItem(CLE_PERSONNAGE, JSON.stringify({ ...lirePerso(), ...x })); } catch { /* */ } };
  const sceneEl = document.querySelector<HTMLElement>('[data-salle3d]');
  const s3p = sceneEl ? salle3D(sceneEl) : null;
  const telephone = innerWidth < 640;
  let apparence = lireApparence(lirePerso());
  // Au départ, il attend au pied de la tribune ; CAM 3 n'existe qu'avec une place.
  s3p?.personnage(apparence);
  s3p?.asseoir(null);
  s3p?.camera('travee', false);
  // Il attend au pied de la tribune : la vue depuis le sol le montre (CAM 2).
  if (!telephone) s3p?.vue('tribune', { instant: true });
  const formulaire = document.querySelector<HTMLFormElement>('[data-personnage]')!;
  for (const [nom, v] of Object.entries(apparence)) {
    const r = formulaire.querySelector<HTMLInputElement>(`input[name="${nom}"][value="${v}"]`);
    if (r) r.checked = true;
  }
  formulaire.addEventListener('change', () => {
    const f = new FormData(formulaire);
    apparence = lireApparence({ peau: f.get('peau'), coiffure: f.get('coiffure'), tenue: f.get('tenue') });
    sauverPerso(apparence);
    s3p?.personnage(apparence);
  });

  const $ = <T extends Element = HTMLElement>(s: string, racine: ParentNode = document) =>
    racine.querySelector<T>(s)!;
  const titres = JSON.parse($('[data-donnees]').textContent!) as
    Record<string, [string, string, boolean]>;
  const salle = new Salle($('[data-salle]'));
  const { groupes } = salle.reglages;
  const pluriel = (n: number, mot: string) => `${n} ${mot}${n > 1 ? 's' : ''}`;
  const mes = Object.entries(reponses()).sort((a, b) => b[1].le.localeCompare(a[1].le));
  const reps = Object.fromEntries(mes.map(([k, r]) => [k, r.v]));

  // Tes réponses, les plus récentes d'abord ; combien vont dans le sens du vote final.
  const tranchees = mes.filter(([uid]) => titres[uid]);
  const n = tranchees.length;
  $('[data-compteur]').textContent = String(n);
  if (n > 0) {
    $('[data-texte-reponses]').textContent = `${pluriel(n, 'vote')} tranché${n > 1 ? 's' : ''}. Les plus récents :`;
    const ul = $('[data-liste-reponses]');
    for (const [uid, r] of tranchees.slice(0, 8)) {
      const li = document.createElement('li');
      const p = document.createElement('span');
      p.className = `pastille p-${r.v}`;
      p.textContent = r.v;
      const a = document.createElement('a');
      a.href = titres[uid][0];
      a.textContent = titres[uid][1];
      li.append(p, a);
      ul.append(li);
    }
    ul.hidden = false;
    const commeFinal = tranchees.filter(([uid, r]) => (r.v === 'pour') === titres[uid][2]).length;
    $('[data-tranches]').textContent = String(n);
    $('[data-comme-final]').textContent = String(commeFinal);
    $('[data-sur-final]').textContent = ` / ${n}`;
    $('[data-tuiles]').hidden = false;
  }

  const remplir = (cle: string, c: Classe<LigneDepute> | null, phrase?: string) => {
    const carte = $<HTMLAnchorElement>(`[data-personne="${cle}"]`);
    if (!c) { carte.hidden = cle !== 'depute'; return; }
    carte.hidden = false;
    carte.href = `/deputes/${c.ligne.u}/`;
    $('[data-ini]', carte).textContent = initiales(c.ligne.n);
    $('[data-nom]', carte).textContent = c.ligne.n;
    const p = document.createElement('span');
    pastille(p, groupes[c.ligne.g ?? '']);
    $('[data-detail]', carte).replaceChildren(p, `· ${pluriel(c.communs, 'vote')} en commun`);
    $('[data-score]', carte).textContent = c.taux !== null ? `${c.taux} %` : '';
    if (phrase) $('[data-phrase]', carte).textContent = phrase;
  };

  const dessiner = async () => {
    const m: Matrice = await (await fetch('/donnees/matrice.json')).json();
    const p = profil(m, reps);
    const parDepute = new Map(p.deputes.map((x) => [x.ligne.u, x]));
    const noms = new Map(m.deputes.map((d) => [d.u, d]));

    // La carte d'un siège, au survol ou au premier toucher ; un clic ouvre la fiche du député.
    const info = $('[data-info]');
    salle.surSiege((i) => {
      const [uid, g] = salle.reglages.sieges[i];
      const nom = noms.get(uid)?.n ?? uid;
      const x = parDepute.get(uid);
      const accord = !p.reponses ? 'Fais le quiz pour comparer ses votes aux tiens.'
        : x ? `${pluriel(x.identiques, 'vote')} comme toi sur ${x.communs} · ${niveau(x.lisse).libelle.toLowerCase()}`
        : 'Aucun vote en commun avec toi';
      salle.carte(i, nom, accord);
      info.textContent = `${nom}, ${groupes[g]?.s ?? ''} : ${accord}`;
    }, (i) => { location.href = `/deputes/${salle.reglages.sieges[i][0]}/`; });

    if (!p.reponses) return;

    salle.colorer((_, uid) => {
      const x = parDepute.get(uid);
      return x ? { fond: niveau(x.lisse).couleur } : { sansCommun: true };
    });
    $('[data-legende]').hidden = false;
    const proches = p.deputes.filter((x) => niveau(x.lisse).haut).length;
    salle.centre(String(proches), `député${proches > 1 ? 's' : ''} d'accord avec toi la plupart du temps`);
    // La salle 3D : le voyant de chaque pupitre prend l'intensité de l'accord (de l'éteint à la
    // lumière), sans réarranger la salle ni toucher à la couleur des sièges ; ta place est celle
    // de ton jumeau.
    const scene = document.querySelector<HTMLElement>('[data-salle3d]');
    if (scene) {
      const s3 = salle3D(scene);
      const INTENSITES = ['#4A3C28', '#6B5536', '#A9844F', '#F2C98A'];
      s3.voyants(salle.reglages.sieges.map(([u]) => {
        const x = parDepute.get(u);
        return x ? INTENSITES[NIVEAUX.indexOf(niveau(x.lisse))] : null;
      }));
      const k = p.jumeau ? salle.reglages.sieges.findIndex(([u]) => u === p.jumeau!.ligne.u) : -1;
      s3.jumeau(k >= 0 ? k : null);
      if (k >= 0 && p.reponses >= VOTES_POUR_SIEGER) {
        // Assez de votes : il prend sa place, le siège de son jumeau ; il n'y marche que si la
        // place a changé depuis sa dernière visite.
        const uidJumeau = p.jumeau!.ligne.u;
        const marcher = lirePerso().siege !== uidJumeau;
        sauverPerso({ siege: uidJumeau });
        s3.asseoir(k, { marcher });
        s3.camera('travee', true);
        if (!telephone) s3.vue('travee', { instant: true });
        s3.repere(k, 'Toi · le siège de ton jumeau');
        $('[data-bandeau-place]').textContent = `Ta place : le siège de ${p.jumeau!.ligne.n}`;
      } else {
        const reste = VOTES_POUR_SIEGER - p.reponses;
        s3.repere(null);
        $('[data-bandeau-place]').textContent = `Encore ${reste} vote${reste > 1 ? 's' : ''} avant de prendre ta place`;
      }
    }
    $('[data-sous-titre]').textContent = 'Plus un siège est lumineux, plus ce député vote comme toi';
    salle.jumeau(p.jumeau?.ligne.u ?? null);

    // Ta place : au-dessus du groupe (hors non-inscrits) qui vote le plus comme toi.
    const groupe = p.groupes.find((x) => !groupes[x.ligne.u]?.ni) ?? null;
    if (groupe) {
      salle.toi(groupe.ligne.u);
      $('[data-place-titre]').textContent = `Tu siègerais côté ${groupe.ligne.sigle}`;
      $('[data-place-texte]').textContent = `Calculé sur ${pluriel(p.reponses, 'vote')} tranché${p.reponses > 1 ? 's' : ''}, comparé${p.reponses > 1 ? 's' : ''} un par un aux 577 députés : le groupe ${groupe.ligne.libelle} a voté comme toi ${groupe.identiques} fois sur ${groupe.communs}. Aucun axe gauche-droite : seulement des votes réels.`;
      $('[data-cta-quiz]').hidden = true;
    }
    const prec = Math.round(100 * p.precision);
    $('[data-bloc-precision]').hidden = false;
    $('[data-precision]').textContent = `${prec} %`;
    document.querySelectorAll<HTMLElement>('[data-segments] span')
      .forEach((s, k) => s.classList.toggle('plein', k < Math.round(p.precision * 10)));
    const reste = Math.max(0, VOTES_FIABLES - p.reponses);
    $('[data-precision-note]').textContent = reste
      ? `Fiable à partir de ${VOTES_FIABLES} votes : encore ${reste} à trancher.`
      : `Ton résultat est fiable : ${prec} % de précision ; chaque vote l'affine encore.`;

    $('[data-trio]').hidden = false;
    remplir('jumeau', p.jumeau);
    remplir('oppose', p.oppose);
    const uid = deputeChoisi();
    const mien = uid ? noms.get(uid) : undefined;
    if (mien) {
      const c = comparer(mien.s, colonnes(m, reps));
      remplir('depute', { ligne: mien, ...c },
        c.communs ? `D'accord avec toi sur ${c.identiques} vote${c.identiques > 1 ? 's' : ''} sur ${c.communs}.`
          : 'Aucun vote en commun pour l\'instant.');
      const d = await fetch('/donnees/deputes.json').then((r) => r.json())
        .then((l: { u: string; c: string }[]) => l.find((x) => x.u === uid))
        .catch(() => null);
      if (d) $('[data-sur-titre-depute]').textContent = `Ton député · ${libelleCirco(d.c)}`;
    }

    $('[data-bloc-groupes]').hidden = false;
    $('[data-groupes]').replaceChildren(...p.groupes.map((x) => {
      const li = document.createElement('li');
      const s = document.createElement('abbr');
      pastille(s, groupes[x.ligne.u]);
      s.classList.add('sigle');
      const jauge = document.createElement('span');
      jauge.className = 'jauge';
      const plein = document.createElement('span');
      plein.style.width = `${x.taux ?? 0}%`;
      jauge.append(plein);
      const pct = document.createElement('span');
      pct.className = 'pct';
      pct.textContent = `${x.taux} %`;
      const detail = document.createElement('span');
      detail.className = 'visuellement-cache';
      detail.textContent = `${x.ligne.libelle} : ${x.identiques} sur ${x.communs}`;
      li.append(s, jauge, pct, detail);
      return li;
    }));
  };
  dessiner().catch(() => {
    $('[data-info]').textContent = 'Les données des votes n\'ont pas pu être chargées. Réessaie plus tard.';
  });
</script>

<style>
  /* Cotes reprises de la frame V5 « ⑩ Mon hémicycle ». */
  .rangee { display: flex; flex-wrap: wrap; gap: 22px; align-items: stretch; }
  .salle { flex: 1.35 1 620px; min-width: 0; padding: 24px; border-radius: var(--rayon); background: var(--panneau); border: 1px solid var(--filet); }
  .titre-section { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 6px 16px; }
  .titre-section h1 { font-size: 32px; text-transform: uppercase; }
  .titre-section span { font-size: 14px; color: var(--gris-legende); }
  .cadre-salle { margin-top: 12px; }
  .legende { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; margin: 16px 0 0; padding: 0;
    list-style: none; font-size: 14px; color: var(--texte-doux); }
  .legende li { display: inline-flex; align-items: center; gap: 7px; }
  .legende span { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
  .legende .sans { background: var(--panneau); border: 2px solid; }
  .aide-survol { margin: 10px 0 0; text-align: center; font-size: 13px; color: var(--gris-legende); }
  @media (hover: none) { .aide-survol { display: none; } }

  .cote { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .encadre { padding: 22px; border: 1px solid var(--filet); border-radius: var(--rayon); background: var(--panneau); }
  .encadre p { margin: 8px 0 0; font-size: 15px; line-height: 1.5; color: var(--gris); }
  .sur-titre { font: 600 var(--taille-puce)/16px var(--police-titre); letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--lumiere); }
  .place-titre { margin-top: 6px; font-family: var(--police-titre); font-weight: 600; font-size: 34px; line-height: 1.02; text-transform: uppercase; }
  .place-titre sup { font-size: 0.55em; }
  .precision { padding: 22px; border-radius: var(--rayon); background: var(--panneau-2); }
  .precision p { margin: 10px 0 0; font-size: 15px; line-height: 1.45; color: var(--ivoire-2); }
