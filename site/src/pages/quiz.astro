---
// Le quiz d'entrée (frames V5 « ① Première question », « ② Révélation », « ③ Résultat »,
// « ④ Partage ») : les 10 votes choisis par Julien (data/quiz.json). Pour chacun : la question,
// « Concrètement », Pour / Contre / Je ne sais pas, puis la révélation du vote réel. À droite,
// ton hémicycle se construit à chaque réponse. À la fin : ta place, ton jumeau, les groupes les
// plus proches, la précision, et trois stories à partager. Tout est calculé dans le
// navigateur ; les réponses y restent (lib/navigateur.ts).
import Base from '../layouts/Base.astro';
import Salle from '../components/Salle.astro';
import { composition, lienVote, questionsQuiz, scrutin } from '../lib/donnees.ts';
import { NIVEAUX, SANS_VOTE_COMMUN } from '../lib/profil.ts';
import { verdict } from '../lib/votes.ts';

const compo = composition();
// Le vote de chaque député d'aujourd'hui, siège par siège dans la salle du jour : P, C, A
// (abstention), N (non-votant), - (absent), en minuscule s'il a voté contre son groupe ;
// x s'il n'était pas député à la date du vote, V pour un siège vacant.
const LETTRES: Record<string, string> = { pour: 'P', contre: 'C', abstention: 'A',
  non_votant: 'N', absent: '-' };
// Les puces de thème de la maquette, dans l'ordre des questions.
const PUCES = ['#E8E1FF:#5B35E6', '#FFE1EF:#B5175A', '#E3F6D5:#3B7F12', '#FFF1CC:#9A5B00',
  '#DDF1FF:#0B6AAE', '#D9F7EA:#0C7F57', '#FFE6DA:#B83C0A', '#E6E9F0:#3A4256',
  '#FFF6C2:#7A6000', '#E2E5FF:#3443B0'];
const questions = questionsQuiz().map((q, k) => {
  const s = scrutin(q.uid);
  const votes = new Map(s.sieges.filter((x) => x.depute).map((x) => [x.depute!, x]));
  return {
    ...q, question: q.question.replace(/ ([?!:;])/g, ' $1'),
    lien: lienVote(s), verdict: verdict(s), adopte: s.sort === 'adopté', decompte: s.decompte,
    dissidents: s.dissidents, marge: s.voix_pour_inverser, puce: PUCES[k % PUCES.length],
    sieges: compo.sieges.map((c) => {
      if (c.vacant || !c.depute) return 'V';
      const x = votes.get(c.depute);
      if (!x) return 'x';
      const l = LETTRES[x.vote ?? 'absent'] ?? '-';
      return x.dissident ? l.toLowerCase() : l;
    }).join(''),
  };
});
const donnees = JSON.stringify({ questions }).replace(/</g, '\\u003c');
---
<Base titre="Le quiz d'entrée" focus
  description="Prends le 578e siège : 10 vrais votes de l'Assemblée, puis le groupe et le député qui votent le plus comme toi.">
  <div class="progression" slot="entete">
    <div class="barre-cadre">
      <div class="barre" role="progressbar" aria-label="Progression du quiz" aria-valuemin="0"
        aria-valuemax={questions.length} aria-valuenow="0" data-barre>
        <span data-barre-pleine></span>
      </div>
      <span class="compteur" data-compteur>Vote 1 sur {questions.length}</span>
    </div>
    <a class="quitter" href="/explorer/">Explorer tous les votes</a>
  </div>

  <div class="quiz" data-quiz>
    <section class="gauche" aria-live="polite">
      <div class="question" data-ecran="question">
        <div class="bulle" data-bulle>
          <span class="robot" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28"><rect x="6" y="12" width="16" height="9" rx="3" fill="#fff"></rect><rect x="9" y="5" width="10" height="8" rx="3" fill="#fff"></rect><rect x="8" y="20" width="3" height="5" rx="1.5" fill="#fff"></rect><rect x="17" y="20" width="3" height="5" rx="1.5" fill="#fff"></rect></svg>
          </span>
          <p>
            Il reste un siège libre à l'Assemblée : <strong>le tien</strong>.
            {` Réponds à ${questions.length} vrais votes, on te montre quels députés ont voté comme toi.`}
          </p>
        </div>
        <span class="puce-theme" data-theme></span>
        <h1 data-question tabindex="-1"></h1>
        <p class="concretement"><strong>Concrètement :</strong> <span data-concretement></span></p>
        <div class="choix">
          <button type="button" class="b-pour" data-reponse="pour">Pour</button>
          <button type="button" class="b-contre" data-reponse="contre">Contre</button>
        </div>
        <button type="button" class="b-passer" data-reponse="">Je ne sais pas</button>
      </div>

      <div class="resultat" data-ecran="resultat" hidden>
        <span class="confetti c1" aria-hidden="true"></span>
        <span class="confetti c2" aria-hidden="true"></span>
        <span class="confetti c3" aria-hidden="true"></span>
        <span class="puce-resultat" data-sur-titre-resultat></span>
        <h1 tabindex="-1" data-titre-resultat>Ta place est prête&nbsp;!</h1>
        <p class="phrase" data-phrase-groupe></p>
        <a class="jumeau" data-jumeau hidden>
          <span class="avatar" data-jumeau-ini></span>
          <span class="jumeau-texte">
            <span class="sur-titre">Ton jumeau à l'Assemblée</span>
            <span class="jumeau-nom" data-jumeau-nom></span>
            <span class="jumeau-detail" data-jumeau-detail></span>
          </span>
          <span class="jumeau-score">
            <span data-jumeau-score></span>
            <span class="petit">votes comme toi</span>
          </span>
        </a>
        <ul class="groupes" data-groupes aria-label="Les groupes qui votent le plus comme toi"></ul>
        <div class="precision">
          <span class="precision-titre">Précision</span>
          <span class="segments" data-segments aria-hidden="true">
            {Array.from({ length: 10 }, () => <span></span>)}
          </span>
          <span class="precision-pct" data-precision></span>
        </div>
        <p class="note" data-note-precision></p>
        <div class="actions">
          <a class="b-principal" href="/hemicycle/">
            <span>Voir mon hémicycle →</span>
            <span class="petit">Ton jumeau, ton opposé, tous les groupes</span>
          </a>
          <button type="button" class="b-partager" data-ouvrir-partage>
            <svg width="20" height="20" viewBox="0 0 22 22" aria-hidden="true"><rect x="3" y="3" width="16" height="16" rx="5" fill="none" stroke="currentColor" stroke-width="2.2"></rect><circle cx="11" cy="11" r="3.6" fill="none" stroke="currentColor" stroke-width="2.2"></circle><circle cx="15.6" cy="6.4" r="1.2" fill="currentColor"></circle></svg>
            Partager
          </button>
        </div>
        <p class="recommencer">
          <button type="button" data-recommencer>Recommencer le quiz</button>{' · '}<a
            href="/explorer/">Trancher d'autres votes</a> pour affiner ton résultat
        </p>
      </div>
    </section>

    <section class="panneau" aria-labelledby="titre-panneau">
      <div class="panneau-tete">
        <div>
          <h2 id="titre-panneau" data-panneau-titre>Ton hémicycle</h2>
          <p data-panneau-sous>Il se construit à chaque réponse</p>
        </div>
        <div class="precision-tete" data-precision-tete title="Plus tu tranches de votes, plus ton résultat est fiable">
          <span class="precision-tete-titre">Précision</span>
          <span class="precision-tete-segments" aria-hidden="true" data-segments-tete>
            {Array.from({ length: 10 }, () => <span></span>)}
          </span>
          <span class="precision-tete-pct" data-precision-tete-pct>0 %</span>
        </div>
      </div>
      <div class="cadre-salle">
        <Salle sieges={compo.sieges} groupes={compo.groupes} titre="L'Assemblée nationale" libre
          chiffre="577" legende="sièges… et le tien" />
      </div>
      <ul class="legende" data-legende-vote hidden>
        <li><span style="background: var(--pour)"></span>Pour</li>
        <li><span style="background: var(--contre)"></span>Contre</li>
        <li><span style="background: var(--abstention)"></span>Abstention</li>
        <li><span style="background: var(--non-votant)"></span>Non-votant</li>
        <li><span style="background: var(--absent)"></span>Absent</li>
        <li><span class="anneau"></span>Contre son groupe</li>
        <li data-legende-hors hidden><span class="sans" style={`border-color: ${SANS_VOTE_COMMUN}`}></span>Pas encore député</li>
      </ul>
      <ul class="legende" data-legende-accord>
        {NIVEAUX.map((t) => <li><span style={`background: ${t.couleur}`}></span>{t.libelle}</li>)}
        <li><span class="sans" style={`border-color: ${SANS_VOTE_COMMUN}`}></span>Aucun vote en commun</li>
      </ul>
    </section>
  </div>

  <div class="revelation" data-revelation hidden>
    <div class="revelation-dedans">
      <span class="revelation-icone" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 30 30"><circle cx="9" cy="10" r="3.5" fill="#7C4DFF"></circle><circle cx="21" cy="10" r="3.5" fill="#7C4DFF"></circle><circle cx="15" cy="20" r="4.5" fill="#7C4DFF"></circle></svg>
      </span>
      <div class="revelation-texte">
        <p class="revelation-titre" data-rv-titre></p>
        <p><span data-rv-ligne></span> <a data-lien-vote href="/explorer/">Tout savoir sur ce vote</a></p>
      </div>
      <div class="ta-voix">
        <p class="sur-titre">
          <svg width="22" height="14" viewBox="0 0 40 24" aria-hidden="true"><circle cx="5" cy="20" r="3.2" fill="#C9B8FF"></circle><circle cx="9" cy="11" r="3.2" fill="#C9B8FF"></circle><circle cx="17" cy="5" r="3.2" fill="#C9B8FF"></circle><circle cx="26" cy="5" r="3.2" fill="#C9B8FF"></circle><circle cx="33" cy="11" r="3.2" fill="#C9B8FF"></circle><circle cx="36" cy="20" r="3.8" fill="#7C4DFF"></circle></svg>
          <span>Ta voix de 578<sup>e</sup></span>
        </p>
        <p data-rv-voix></p>
      </div>
      <button type="button" class="b-continuer" data-continuer>Continuer</button>
    </div>
  </div>

  <dialog class="partage" data-partage aria-labelledby="titre-partage">
    <div class="partage-tete">
      <h2 id="titre-partage">Montre ta place</h2>
      <button type="button" class="fermer" data-fermer aria-label="Fermer">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <p>Trois stories prêtes pour Instagram ou Snapchat. Elles ne contiennent que ce que tu vois ici.</p>
    <div class="stories" data-stories>
      <figure><img alt="Story « J'ai pris le 578e siège »" data-story="place" /><figcaption><button type="button" data-envoyer="place">Partager</button></figcaption></figure>
      <figure><img alt="Story « Mon jumeau à l'Assemblée »" data-story="jumeau" /><figcaption><button type="button" data-envoyer="jumeau">Partager</button></figcaption></figure>
      <figure><img alt="Story « Mon vote le plus à contre-courant »" data-story="contre" /><figcaption><button type="button" data-envoyer="contre">Partager</button></figcaption></figure>
    </div>
  </dialog>

  <script type="application/json" data-donnees-quiz set:html={donnees}></script>
</Base>

<script>
  import { lireJSON, repondre, reponses as mesReponses } from '../lib/navigateur.ts';
  import { initiales, niveau, partCommeToi, precision, profil, teinte, type Matrice,
    type Profil, type Reponse } from '../lib/profil.ts';
  import { dessiner, enImage, type DonneesStories, type TypeStory } from '../lib/stories.ts';
  import { pastille, Salle } from '../lib/salle.ts';

  interface Question {
    uid: string; numero: number; theme: string; question: string; concretement: string;
    lien: string; verdict: string; adopte: boolean; dissidents: number; marge: number | null;
    puce: string; sieges: string;
    decompte: { pour: number; contre: number; abstention: number };
  }
  const { questions } = JSON.parse(
    document.querySelector('[data-donnees-quiz]')!.textContent!) as { questions: Question[] };
  const CLE = '578e.quiz.v1';
  const COULEURS: Record<string, string> = { P: '#2F7BFF', C: '#FF6A3D', A: '#FFC531',
    N: '#9AA1B2', '-': '#DFE3EB' };
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const salle = new Salle($('[data-salle]'));
  const { groupes, sieges } = salle.reglages;
  const deputes = sieges.map(([u]) => u);
  const etat = lireJSON<{ i: number; fini: boolean }>(CLE, { i: 0, fini: false });
  const pluriel = (n: number, mot: string) => `${n} ${mot}${n > 1 ? 's' : ''}`;
  let matrice: Matrice | null = null;
  const chargement = fetch('/donnees/matrice.json').then((r) => r.json())
    .then((m: Matrice) => { matrice = m; return m; });

  const sauver = () => { try { localStorage.setItem(CLE, JSON.stringify(etat)); } catch { /* */ } };
  const montrer = (ecran: string) => {
    for (const e of document.querySelectorAll<HTMLElement>('[data-ecran]')) {
      e.hidden = e.dataset.ecran !== ecran;
    }
  };
  const progression = (n: number) => {
    $('[data-barre]').setAttribute('aria-valuenow', String(n));
    $('[data-barre-pleine]').style.width = `${(100 * n) / questions.length}%`;
  };
  const mesReps = () => Object.fromEntries(Object.entries(mesReponses()).map(([k, r]) => [k, r.v]));
  const segments = (selecteur: string, p: number) => {
    document.querySelectorAll<HTMLElement>(`${selecteur} span`)
      .forEach((s, k) => s.classList.toggle('plein', k < Math.round(p * 10)));
  };

  /** Ton hémicycle tel qu'il est : plus un siège est foncé, plus ce député vote comme toi. */
  const tonHemicycle = (m: Matrice | null): Profil | null => {
    const p = m ? profil(m, mesReps()) : null;
    const n = p?.reponses ?? 0;
    $('[data-precision-tete-pct]').textContent = `${Math.round(100 * precision(n))} %`;
    segments('[data-segments-tete]', precision(n));
    if (!p || !n) {
      salle.colorer(() => ({ fond: '#D6DBE4' }));
      salle.centre('577', 'sièges… et le tien');
      salle.libre(true);
      return p;
    }
    const parDepute = new Map(p.deputes.map((x) => [x.ligne.u, x]));
    salle.colorer((_, uid) => {
      const x = parDepute.get(uid);
      return x ? { fond: niveau(x.lisse).couleur } : { sansCommun: true };
    });
    const proches = p.deputes.filter((x) => niveau(x.lisse).haut).length;
    salle.centre(String(proches), `député${proches > 1 ? 's' : ''} d'accord avec toi la plupart du temps`);
    salle.libre(false);
    return p;
  };

  // --- Une question ---
  const poser = (i: number) => {
    const q = questions[i];
    montrer('question');
    $('[data-revelation]').hidden = true;
    $('[data-pied-focus]').hidden = false;
    $('[data-bulle]').hidden = i > 0;
    const theme = $('[data-theme]');
    const [fond, encre] = q.puce.split(':');
    theme.textContent = q.theme;
    theme.style.background = fond;
    theme.style.color = encre;
    const titre = $('[data-question]');
    titre.textContent = q.question;
    titre.classList.toggle('longue', q.question.length > 95);
    $('[data-concretement]').textContent = q.concretement;
    $('[data-compteur]').textContent = `Vote ${i + 1} sur ${questions.length}`;
    progression(i);
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-reponse]')) {
      b.disabled = false;
      b.classList.remove('choisi', 'estompe');
    }
    $('[data-panneau-titre]').textContent = 'Ton hémicycle';
    $('[data-panneau-sous]').textContent = 'Il se construit à chaque réponse';
    $('[data-precision-tete]').hidden = false;
    $('[data-legende-vote]').hidden = true;
    $('[data-legende-accord]').hidden = false;
    salle.jumeau(null);
    salle.toi(null);
    tonHemicycle(matrice);
    if (!matrice) chargement.then((m) => { if (!$('[data-ecran="question"]').hidden) tonHemicycle(m); });
    if (i > 0) titre.focus();
  };

  // --- La révélation du vote réel ---
  const reveler = (i: number, v: Reponse | null) => {
    const q = questions[i];
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-reponse]')) {
      b.disabled = true;
      const choisi = (b.dataset.reponse || null) === v;
      b.classList.toggle('choisi', choisi);
      b.classList.toggle('estompe', !choisi);
    }
    // En couleur vive : les députés qui ont voté comme toi.
    const mienne = v === 'pour' ? 'P' : v === 'contre' ? 'C' : null;
    salle.colorer((k) => {
      const brut = q.sieges[k];
      if (brut === 'x') return { sansCommun: true };
      const l = brut.toUpperCase();
      return { fond: COULEURS[l] ?? '#DFE3EB', contreGroupe: brut !== l,
        estompe: !!mienne && l !== '-' && l !== mienne };
    });
    salle.libre(false);
    const d = q.decompte;
    salle.centre(`${d.pour} – ${d.contre}`, `${q.adopte ? 'Adopté' : 'Rejeté'} · pour – contre`);
    $('[data-panneau-titre]').textContent = 'Comment l\'Assemblée a voté';
    $('[data-panneau-sous]').textContent = v ? 'En couleur vive : ceux qui ont voté comme toi'
      : 'Tu n\'as pas répondu à ce vote';
    $('[data-precision-tete]').hidden = true;
    $('[data-legende-vote]').hidden = false;
    $('[data-legende-hors]').hidden = !q.sieges.includes('x');
    $('[data-legende-accord]').hidden = true;
    const gagnant = q.adopte ? 'pour' : 'contre';
    $('[data-rv-titre]').textContent = v
      ? `Tu es ${v === gagnant ? 'avec la majorité' : 'dans la minorité'} : ${v === 'pour' ? d.pour : d.contre} députés ont voté comme toi`
      : 'Voici ce qu\'a voté l\'Assemblée';
    $('[data-rv-ligne]').textContent = `Le texte a été ${q.adopte ? 'adopté' : 'rejeté'} par ${d.pour} voix contre ${d.contre}.`
      + (q.dissidents ? ` ${pluriel(q.dissidents, 'député')} ${q.dissidents > 1 ? 'ont' : 'a'} voté contre leur propre groupe.` : '');
    $<HTMLAnchorElement>('[data-lien-vote]').href = q.lien;
    $('[data-rv-voix]').textContent = (v
      ? `Avec ta voix : ${d.pour + (v === 'pour' ? 1 : 0)} pour, ${d.contre + (v === 'contre' ? 1 : 0)} contre. `
      : 'Tu n\'as pas tranché : ce vote ne compte pas dans ton résultat. ')
      + (q.marge ? `Pour inverser le résultat, il aurait fallu que ${pluriel(q.marge, 'député')} change${q.marge > 1 ? 'nt' : ''} d'avis.` : '');
    $('[data-revelation]').hidden = false;
    $('[data-pied-focus]').hidden = true;
    $('[data-continuer]').textContent = i + 1 < questions.length ? 'Continuer' : 'Voir ma place';
    $('[data-continuer]').focus({ preventScroll: true });
    if (window.matchMedia('(max-width: 1000px)').matches) {
      document.querySelector('.panneau')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  };

  // --- Le résultat ---
  const resultat = async () => {
    etat.fini = true;
    sauver();
    montrer('resultat');
    $('[data-revelation]').hidden = true;
    $('[data-pied-focus]').hidden = false;
    progression(questions.length);
    $('[data-compteur]').textContent = 'Terminé';
    const m = matrice ?? await chargement;
    const reps = mesReps();
    const p = tonHemicycle(m)!;
    $('[data-legende-vote]').hidden = true;
    $('[data-legende-accord]').hidden = false;
    $('[data-precision-tete]').hidden = true;
    $('[data-panneau-titre]').textContent = 'Ton hémicycle';
    $('[data-panneau-sous]').textContent = 'Plus un siège est foncé, plus ce député a voté comme toi';
    const dansQuiz = questions.filter((q) => reps[q.uid]).length;
    $('[data-sur-titre-resultat]').textContent = `${dansQuiz} vote${dansQuiz > 1 ? 's' : ''} sur `
      + `${questions.length} · ${p.reponses > dansQuiz ? `${p.reponses} en tout` : 'premier quiz'}`;
    const g = p.groupes.find((x) => !groupes[x.ligne.u]?.ni) ?? null;
    const j = p.jumeau;
    const phrase = $('[data-phrase-groupe]');
    if (!g) {
      $('[data-titre-resultat]').textContent = 'Pas encore de place';
      phrase.textContent = 'Tu n\'as tranché aucun vote : réponds « Pour » ou « Contre » à au moins une question pour voir qui vote comme toi.';
    } else {
      $('[data-titre-resultat]').textContent = 'Ta place est prête !';
      const b = document.createElement('b');
      b.textContent = `côté ${g.ligne.sigle}`;
      b.title = g.ligne.libelle;
      phrase.replaceChildren('Tu siègerais ', b, !j ? '.'
        : niveau(j.lisse).haut ? '. Et parmi les 577, un député vote presque toujours comme toi :'
        : '. Et parmi les 577, le député qui vote le plus souvent comme toi :');
    }
    salle.jumeau(j?.ligne.u ?? null);
    salle.toi(g?.ligne.u ?? null);
    const carte = $<HTMLAnchorElement>('[data-jumeau]');
    if (j) {
      carte.hidden = false;
      carte.href = `/deputes/${j.ligne.u}/`;
      $('[data-jumeau-ini]').textContent = initiales(j.ligne.n);
      $('[data-jumeau-nom]').textContent = j.ligne.n;
      const pg = document.createElement('span');
      pastille(pg, groupes[j.ligne.g ?? '']);
      $('[data-jumeau-detail]').replaceChildren(pg, ` · ${pluriel(j.communs, 'vote')} en commun`);
      $('[data-jumeau-score]').textContent = `${j.identiques}/${j.communs}`;
    } else {
      carte.hidden = true;
    }
    $('[data-groupes]').replaceChildren(...p.groupes.slice(0, 3).map((x) => {
      const li = document.createElement('li');
      const s = document.createElement('abbr');
      pastille(s, groupes[x.ligne.u]);
      s.classList.add('sigle');
      const barre = document.createElement('span');
      barre.className = 'jauge';
      const plein = document.createElement('span');
      plein.style.width = `${x.taux ?? 0}%`;
      barre.append(plein);
      const pct = document.createElement('span');
      pct.className = 'pct';
      pct.textContent = `${x.taux} %`;
      li.append(s, barre, pct);
      return li;
    }));
    $('[data-precision]').textContent = `${Math.round(100 * p.precision)} %`;
    segments('[data-segments]', p.precision);
    const reste = Math.max(0, 25 - p.reponses);
    $('[data-note-precision]').textContent = reste
      ? `Fiable à partir de 25 votes : encore ${reste} à trancher.`
      : 'Ton résultat est fiable. Chaque vote l\'affine encore.';
    $('[data-titre-resultat]').focus();
    // Les stories, prêtes à partager.
    const parDepute = new Map(p.deputes.map((x) => [x.ligne.u, x.lisse]));
    const couleurs = deputes.map((u) => (u ? teinte(parDepute.get(u) ?? null) : '#FFFFFF'));
    let contre: DonneesStories['contre'] = null;
    for (const q of questions) {
      const r = reps[q.uid];
      const k = m.votes.indexOf(q.uid);
      if (!r || k < 0) continue;
      const part = partCommeToi(m, k, r);
      if (part !== null && (!contre || part < contre.part)) contre = { question: q.question, reponse: r, part };
    }
    stories = {
      groupe: g ? { sigle: g.ligne.sigle, libelle: g.ligne.libelle } : null,
      jumeau: j ? { nom: j.ligne.n, initiales: initiales(j.ligne.n), identiques: j.identiques,
        communs: j.communs, groupe: groupes[j.ligne.g ?? '']?.s ?? 'non inscrit' } : null,
      contre, sieges: couleurs, etoile: j ? deputes.indexOf(j.ligne.u) : -1, votes: p.reponses,
    };
  };

  // --- Partage ---
  let stories: DonneesStories | null = null;
  const images = new Map<TypeStory, Blob>();
  const dialogue = $<HTMLDialogElement>('[data-partage]');
  $('[data-ouvrir-partage]').addEventListener('click', async () => {
    if (!stories) return;
    dialogue.showModal();
    for (const type of ['place', 'jumeau', 'contre'] as TypeStory[]) {
      const blob = await enImage(await dessiner(type, stories));
      images.set(type, blob);
      $<HTMLImageElement>(`[data-story="${type}"]`).src = URL.createObjectURL(blob);
    }
  });
  $('[data-fermer]').addEventListener('click', () => dialogue.close());
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-envoyer]')) {
    b.addEventListener('click', async () => {
      const type = b.dataset.envoyer as TypeStory;
      const blob = images.get(type);
      if (!blob) return;
      const fichier = new File([blob], `578e-siege-${type}.png`, { type: 'image/png' });
      if (navigator.canShare?.({ files: [fichier] })) {
        try { await navigator.share({ files: [fichier], title: 'Le 578e siège' }); return; } catch { /* annulé */ }
      }
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = fichier.name;
      a.click();
    });
  }

  // --- Déroulé ---
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-reponse]')) {
    b.addEventListener('click', () => {
      const q = questions[etat.i];
      const v = (b.dataset.reponse || null) as Reponse | null;
      repondre(q.uid, v);
      reveler(etat.i, v);
    });
  }
  $('[data-continuer]').addEventListener('click', () => {
    etat.i += 1;
    sauver();
    if (etat.i >= questions.length) resultat();
    else poser(etat.i);
  });
  $('[data-recommencer]').addEventListener('click', () => {
    etat.i = 0;
    etat.fini = false;
    sauver();
    poser(0);
    $('[data-question]').focus();
  });
  if (etat.fini || etat.i >= questions.length) resultat();
  else poser(Math.max(0, etat.i));
</script>

