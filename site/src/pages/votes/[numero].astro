---
// La page d'un vote (VDEF, captures 14a, 14b, 14c ; lot V7) : la question en titre (celle de sa
// carte, sinon le titre court), l'issue en pilule noire et « à N voix près », puis trois niveaux
// de lecture en vrais onglets (components/vdef/Onglets.astro, reflétés dans l'adresse) :
// - L'essentiel : la phrase-réponse, la barre et les pastilles, toi / ton jumeau / ton député,
//   ta réponse (« Et toi, qu'aurais-tu voté ? ») ;
// - Comprendre : « Concrètement » si le vote a une carte validée, qui a voté quoi groupe par
//   groupe, le parcours du texte ;
// - Fouiller : l'intitulé officiel, le type, la majorité requise, les votes contre leur groupe,
//   les sources, les 577 votes un par un et leur téléchargement (CSV fait dans le navigateur).
// Les 3 cartes « Ce que ça change » n'apparaissent que validées (docs/vulgarisation-controles.md) :
// aucune ne l'est encore. Un seul hémicycle par écran : « Voir le vote dans la salle » ouvre la
// salle 3D aux couleurs du vote (/salle/#vote=…).
import Base from '../../layouts/Base.astro';
import BarreVote from '../../components/vdef/BarreVote.astro';
import Bouton from '../../components/vdef/Bouton.astro';
import Onglets from '../../components/vdef/Onglets.astro';
import Pastille from '../../components/vdef/Pastille.astro';
import { cartesParVote, dateLisible, LIBELLES, lienVote, majuscule, scrutin, scrutins,
  type Position } from '../../lib/donnees.ts';
import { slugTheme, THEMES } from '../../lib/themes.ts';
import { avecSonGroupe, bascule, ligneGroupe, marge, nature, phraseGroupes, positionGroupe,
  verdict } from '../../lib/votes.ts';

export function getStaticPaths() {
  const liste = scrutins();
  return liste.map((r, i) => ({
    params: { numero: String(r.numero) },
    props: { uid: r.uid, plusRecent: liste[i - 1] ?? null, plusAncien: liste[i + 1] ?? null },
  }));
}

const { uid, plusRecent, plusAncien } = Astro.props;
const s = scrutin(uid);
const carte = cartesParVote().get(uid) ?? null;
const officiel = majuscule(s.titre).replace(/\.$/, '');
const censure = s.motion_censure;
const d = s.decompte;
const pluriel = (n: number, mot: string) => `${n.toLocaleString('fr-FR')} ${mot}${n > 1 ? 's' : ''}`;
const court = s.dossier?.titre ?? officiel;
const titre = carte?.question.replace(/ ([?!:;])/g, ' $1') ?? (court.length > 140 ? `${court.slice(0, 138)}…` : court);
const issue = verdict(s);
const adopte = issue.startsWith('Adopt');
const n = s.voix_pour_inverser;
// La phrase-réponse : la question de la carte appelle un oui ou un non ; sans carte, l'issue.
const phrase = censure
  ? `${issue} : ${d.pour} voix pour la censure, ${s.requis} étaient requises.`
  : `${carte ? `${adopte ? 'Oui' : 'Non'}. ` : ''}${issue} par ${d.pour.toLocaleString('fr-FR')} voix pour et ${d.contre.toLocaleString('fr-FR')} contre.`;
const suffit = !censure && n && n > 0
  ? `Il aurait suffi que ${pluriel(n, 'député')} change${n > 1 ? 'nt' : ''} d’avis pour que le résultat bascule.`
  : bascule(s);
const exprimes = d.pour + d.contre;
const parcours = s.dossier?.parcours ?? [];
const misesAuPoint = s.sieges.filter((x) => x.mise_au_point);
const parGroupe = new Map(s.groupes.map((g) => [g.uid, g]));
const groupesTries = [...s.groupes].filter((g) => g.membres > 0).sort((a, b) => b.membres - a.membres);
const dissidentsParGroupe = groupesTries.filter((g) => !g.non_inscrits && g.dissidents)
  .sort((a, b) => b.dissidents! - a.dissidents!);
// Les 577 votes, un par un : [député, nom, sigle, vote, avec son groupe ?].
const lignes = s.sieges.filter((x) => x.depute).map((x) => {
  const g = parGroupe.get(x.groupe ?? '');
  const position = g?.decompte ? positionGroupe(g.decompte) : null;
  return [x.depute, x.nom ?? '', g?.sigle ?? '', x.vote ?? 'absent',
    avecSonGroupe(x.vote, x.dissident, position, !!g?.non_inscrits)];
}).sort((a, b) => (a[1] as string).localeCompare(b[1] as string, 'fr'));
const donnees = JSON.stringify({ uid, numero: s.numero, censure, adopte, lignes,
  decompte: { pour: d.pour, contre: d.contre } }).replace(/</g, '\\u003c');
const titrePage = `Vote n° ${s.numero} : ${court.length > 70 ? `${court.slice(0, 68)}…` : court}`;
const description = censure
  ? `Motion de censure ${issue.toLowerCase()} le ${dateLisible(s.date)} : ${d.pour} voix pour, ${s.requis} requises. Le vote de chaque député.`
  : `${issue} le ${dateLisible(s.date)} par ${d.pour} voix pour et ${d.contre} contre. Le vote de chaque député, groupe par groupe.`;
---
<Base titre={titrePage} description={description} gabarit="lecture" vue="tribune" bas="galerie">
  <a class="retour" href="/explorer/">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
    La galerie
  </a>
  <header class="entete">
    <div class="pastilles">
      {carte && THEMES.includes(carte.theme as never)
        ? <Pastille href={`/dossiers/${slugTheme(carte.theme)}/`} class="pastille-theme">{carte.theme}</Pastille>
        : carte && <Pastille>{carte.theme}</Pastille>}
      <Pastille>{s.solennel && !censure ? 'Vote solennel' : nature(s)}</Pastille>
      <Pastille>{dateLisible(s.date)}</Pastille>
    </div>
    <h1 class="t-ecran titre-vote">{titre}</h1>
    <div class="issue-ligne">
      <span class="issue-pilule">{issue}</span>
      {!censure && marge(s) && <span class="t-interface">{marge(s)}</span>}
      {!censure && (
        <a class="voir-salle" href={`/salle/#vote=${uid}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 19a9 9 0 0 1 18 0"></path><path d="M7 19a5 5 0 0 1 10 0"></path></svg>
          Voir le vote dans la salle
        </a>
      )}
    </div>
  </header>

  <Onglets etiquette="Niveau de lecture du vote" />

  <section id="panneau-essentiel" role="tabpanel" aria-labelledby="onglet-essentiel" class="panneau">
    <p class="t-phrase phrase">{phrase}</p>
    <BarreVote pour={d.pour} contre={d.contre} abstention={d.abstention} absents={d.absent} hauteur={14} pastilles />
    {suffit && <p class="t-texte">{suffit}</p>}
    <ul class="lignes personnes" data-vote-lignes>
      <li data-ligne-toi><span>Toi</span><span data-toi-vote>{censure ? 'Hors de ta place : seules les voix pour sont publiées' : 'Pas encore tranché'}</span></li>
    </ul>
    {!censure && (
      <div class="repondre" data-repondre data-uid={uid}>
        <p class="t-interface" data-repondre-texte>Et toi, qu’aurais-tu voté ? Ta réponse reste dans ton navigateur.</p>
        <div class="choix" role="group" aria-label="Ta réponse">
          <button type="button" class="choix-bouton" data-v="pour" aria-pressed="false"><span class="point pour" aria-hidden="true"></span>Pour</button>
          <button type="button" class="choix-bouton" data-v="contre" aria-pressed="false"><span class="point contre" aria-hidden="true"></span>Contre</button>
          <button type="button" class="effacer" data-effacer hidden>Effacer ma réponse</button>
        </div>
      </div>
    )}
    <div class="actions">
      <Bouton href="#comprendre" data-vers-comprendre>Comprendre ce que ça change</Bouton>
      {!censure && <Bouton variante="contour" data-changer hidden>Changer ma réponse</Bouton>}
    </div>
  </section>

  <section id="panneau-comprendre" role="tabpanel" aria-labelledby="onglet-comprendre" class="panneau" hidden>
    {carte?.concretement && (
      <div class="bloc">
        <h2 class="t-section">Concrètement</h2>
        <p class="t-texte concret">{carte.concretement}</p>
      </div>
    )}
    <div class="bloc">
      <h2 class="t-section">Qui a voté quoi</h2>
      {phraseGroupes(groupesTries) && <p class="t-texte">{phraseGroupes(groupesTries)}</p>}
      <ul class="groupes">
        {groupesTries.map((g) => {
          const dg = g.decompte!;
          return (
            <li>
              <abbr class="sigle" title={g.libelle}>{g.sigle}</abbr>
              <span class="barre-groupe" aria-hidden="true">
                {dg.pour > 0 && <span class="point pour" style={`flex: ${dg.pour}`}></span>}
                {dg.contre > 0 && <span class="point contre" style={`flex: ${dg.contre}`}></span>}
                {dg.abstention > 0 && <span class="point abstention" style={`flex: ${dg.abstention}`}></span>}
                {dg.absent + dg.non_votant > 0 && <span class="point absent" style={`flex: ${dg.absent + dg.non_votant}`}></span>}
              </span>
              <span class="t-legende">
                {censure ? `${dg.pour} sur ${g.membres}` : ligneGroupe(dg)}
                {!g.non_inscrits && g.dissidents ? ` · ${g.dissidents} contre le groupe` : ''}
              </span>
              <span class="visuellement-cache">{`${g.libelle} : ${g.membres} membres, ${dg.pour} pour, ${dg.contre} contre, ${dg.abstention} abstentions, ${dg.non_votant} non-votants, ${dg.absent} absents.`}</span>
            </li>
          );
        })}
      </ul>
      <p class="t-legende">La partie grise de chaque barre : les membres du groupe qui n’ont pas pris part au vote (absents et non-votants).</p>
    </div>
    {s.dossier && parcours.length > 0 && (
      <div class="bloc">
        <h2 class="t-section">Le parcours du texte</h2>
        <ol class="etapes">
          {parcours.map((e) => (
            <li class:list={{ ce: e.ce_vote }}>
              <span class="etape-nom">{e.libelle}</span>
              <span class="etape-date">{e.ce_vote ? 'Ce vote' : ''}{e.ce_vote && e.debut ? ' · ' : ''}{e.debut ? dateLisible(e.debut) : ''}</span>
            </li>
          ))}
        </ol>
      </div>
    )}
    <Bouton href="#fouiller" variante="contour">Fouiller : texte officiel et décompte</Bouton>
  </section>

  <section id="panneau-fouiller" role="tabpanel" aria-labelledby="onglet-fouiller" class="panneau" hidden>
    <dl class="fiche">
      <div><dt>Intitulé officiel</dt><dd>{officiel}</dd></div>
      <div><dt>Type de vote</dt><dd>{nature(s)} · scrutin n° {s.numero.toLocaleString('fr-FR')} du {dateLisible(s.date)}</dd></div>
      <div><dt>Majorité requise</dt><dd>{censure ? `${s.requis} voix (la majorité des membres de l’Assemblée)` : s.requis ? `${s.requis} voix sur ${exprimes} exprimées` : 'Non publiée'}</dd></div>
      <div><dt>Contre leur groupe</dt><dd>{s.dissidents
        ? `${pluriel(s.dissidents, 'député')}${dissidentsParGroupe[0] ? `, dont ${dissidentsParGroupe[0].dissidents} du groupe ${dissidentsParGroupe[0].sigle}` : ''}`
        : 'Aucun'}</dd></div>
      <div><dt>Décompte</dt><dd>{d.pour} pour · {d.contre} contre · {pluriel(d.abstention, 'abstention')} · {pluriel(d.non_votant, 'non-votant')} · {pluriel(d.absent, 'absent')}</dd></div>
      {misesAuPoint.length > 0 && (
        <div><dt>Mises au point</dt><dd>
          {misesAuPoint.map((x, k) => (
            <>{k > 0 && ' · '}<a href={`/deputes/${x.depute}/`}>{x.nom}</a> a voté {LIBELLES[x.vote as Position]}, voulait voter {LIBELLES[x.mise_au_point as Position] ?? x.mise_au_point}</>
          ))}
          <span class="t-legende"> (le site compte le vote officiel)</span>
        </dd></div>
      )}
      <div><dt>Sources</dt><dd>
        <a href={s.lien}>Le scrutin sur le site de l’Assemblée</a>
        {s.dossier && <> · <a href={s.dossier.lien}>Le dossier législatif</a></>}
        {' · '}<a href="/calcul/">Comment c’est calculé</a>
      </dd></div>
    </dl>
    <div class="tableau-cadre">
      <table class="tableau">
        <caption>Les {lignes.length} votes, un par un</caption>
        <thead><tr><th scope="col">Député</th><th scope="col">Groupe</th><th scope="col">Vote</th><th scope="col">Avec son groupe ?</th></tr></thead>
        <tbody data-tableau></tbody>
      </table>
    </div>
    <Bouton variante="contour" data-csv>Télécharger le décompte (CSV)</Bouton>
    <p class="t-legende">« Avec son groupe ? » : « Non » pour un vote opposé à la position majoritaire de son groupe ; jamais pour les non-inscrits, et une abstention n’est jamais comptée contre son groupe.</p>
  </section>

  <nav class="voisins" aria-label="Autres votes">
    {plusRecent && <a href={lienVote(plusRecent)}>‹ Vote plus récent</a>}
    {plusAncien && <a href={lienVote(plusAncien)}>Vote plus ancien ›</a>}
  </nav>
  <script type="application/json" data-donnees-vote set:html={donnees}></script>
</Base>

<script>
  import { deputeChoisi, repondre, reponse, type Reponse } from '../../lib/navigateur.ts';
  import { profil, type Matrice } from '../../lib/profil.ts';
  import { donnee } from '../../lib/matrice-cache.ts';
  import { mesReps } from '../../lib/trancher.ts';

  type Ligne = [string, string, string, string, string];
  const MOTS: Record<string, string> = { pour: 'Pour', contre: 'Contre', abstention: 'Abstention',
    non_votant: 'Non-votant', absent: 'Absent' };
  const POINTS: Record<string, string> = { pour: 'pour', contre: 'contre', abstention: 'abstention',
    non_votant: 'non-votant', absent: 'absent' };

  document.addEventListener('astro:page-load', async () => {
    const brut = document.querySelector('[data-donnees-vote]')?.textContent;
    if (!brut) return;
    const d = JSON.parse(brut) as { uid: string; numero: number; censure: boolean; adopte: boolean; lignes: Ligne[];
      decompte: { pour: number; contre: number } };
    const parDepute = new Map(d.lignes.map((l) => [l[0], l]));
    const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s);
    const lignesUl = $('[data-vote-lignes]')!;
    const marques = new Map<string, string>();

    /** Une ligne « Ton jumeau, … » ou « Ton député, … » : son vote, avec sa pastille. */
    const ligne = (etiquette: string, vote: string | null, lien: string) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = lien;
      a.textContent = etiquette;
      const droite = document.createElement('span');
      if (vote) {
        const p = document.createElement('span');
        p.className = `point ${POINTS[vote]}`;
        p.setAttribute('aria-hidden', 'true');
        droite.append(p, MOTS[vote]);
      } else droite.textContent = 'Pas député lors de ce vote';
      li.append(a, droite);
      return li;
    };

    // --- Toi ---
    const toi = $('[data-toi-vote]')!;
    const bloc = $('[data-repondre]');
    const changer = $<HTMLButtonElement>('[data-changer]');
    const afficher = (v: Reponse | null, ouvrir = false) => {
      if (d.censure) return;
      if (v) {
        const p = document.createElement('span');
        p.className = `point ${v}`;
        p.setAttribute('aria-hidden', 'true');
        toi.replaceChildren(p, `${MOTS[v]} · ${(v === 'pour') === d.adopte ? 'avec la majorité' : 'à contre-courant'}`);
      } else toi.textContent = 'Pas encore tranché';
      for (const b of bloc!.querySelectorAll<HTMLButtonElement>('[data-v]')) b.setAttribute('aria-pressed', String(b.dataset.v === v));
      bloc!.querySelector<HTMLButtonElement>('[data-effacer]')!.hidden = !v;
      bloc!.hidden = !!v && !ouvrir;
      if (changer) changer.hidden = !v || ouvrir;
    };
    if (bloc) {
      for (const b of bloc.querySelectorAll<HTMLButtonElement>('[data-v]')) {
        b.addEventListener('click', () => {
          const v = b.dataset.v as Reponse;
          if (!repondre(d.uid, v)) $('[data-repondre-texte]')!.textContent = 'Ton navigateur bloque l’enregistrement : ta réponse ne sera pas gardée.';
          document.dispatchEvent(new Event('vdef:reponses'));
          afficher(v);
          changer?.focus();
        });
      }
      bloc.querySelector('[data-effacer]')!.addEventListener('click', () => {
        repondre(d.uid, null);
        document.dispatchEvent(new Event('vdef:reponses'));
        afficher(null, true);
        bloc.querySelector<HTMLButtonElement>('[data-v]')!.focus();
      });
      changer?.addEventListener('click', () => { afficher(reponse(d.uid), true); bloc.querySelector<HTMLButtonElement>('[data-v]')!.focus(); });
      afficher(reponse(d.uid));
    }

    // --- Ton député ---
    const monDepute = deputeChoisi();
    if (monDepute) {
      const l = parDepute.get(monDepute);
      marques.set(monDepute, 'ton député');
      lignesUl.append(ligne(`Ton député${l ? `, ${l[1]}` : ''}`, l?.[3] ?? null, `/deputes/${monDepute}/`));
    } else {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '/deputes/';
      a.textContent = 'Ton député';
      const s = document.createElement('span');
      s.textContent = 'À choisir avec ton code postal';
      li.append(a, s);
      lignesUl.append(li);
    }

    // --- Ton jumeau (calculé sur tes réponses, dans ton navigateur) ---
    const reps = mesReps();
    if (Object.keys(reps).length) {
      try {
        const m: Matrice = await donnee('matrice.json');
        const j = profil(m, reps).jumeau;
        if (j) {
          const l = parDepute.get(j.ligne.u);
          marques.set(j.ligne.u, marques.has(j.ligne.u) ? 'ton jumeau et ton député' : 'ton jumeau');
          lignesUl.querySelector('[data-ligne-toi]')!.after(ligne(`Ton jumeau, ${j.ligne.n}`, l?.[3] ?? null, `/deputes/${j.ligne.u}/`));
        }
      } catch { /* hors ligne : pas de jumeau */ }
    }

    // --- Fouiller : les 577 votes et le CSV ---
    const corps = $('[data-tableau]')!;
    const tries = [...d.lignes].sort((a, b) => (marques.has(b[0]) ? 1 : 0) - (marques.has(a[0]) ? 1 : 0));
    corps.replaceChildren(...tries.map((l) => {
      const tr = document.createElement('tr');
      const nom = document.createElement('td');
      const a = document.createElement('a');
      a.href = `/deputes/${l[0]}/`;
      a.textContent = l[1];
      nom.append(a, marques.has(l[0]) ? ` · ${marques.get(l[0])}` : '');
      const cellules = [l[2], MOTS[l[3]] ?? l[3], l[4]].map((t) => { const td = document.createElement('td'); td.textContent = t; return td; });
      tr.append(nom, ...cellules);
      return tr;
    }));
    $('[data-csv]')?.addEventListener('click', () => {
      const champ = (t: string) => `"${t.replace(/"/g, '""')}"`;
      const csv = ['depute_id;nom;groupe;vote;avec_son_groupe',
        ...d.lignes.map((l) => [l[0], l[1], l[2], l[3], l[4]].map(champ).join(';'))].join('\r\n');
      const url = URL.createObjectURL(new Blob([`﻿${csv}`], { type: 'text/csv;charset=utf-8' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = `scrutin-${d.numero}.csv`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });
  });
</script>

<style>
  .entete { display: flex; flex-direction: column; gap: 18px; }
  .pastilles { display: flex; flex-wrap: wrap; gap: 8px; }
  .entete :global(.pastille-theme) { min-height: 0; padding: 7px 12px; font-size: 13px; }
  .titre-vote { max-width: 900px; overflow-wrap: anywhere; }
  .issue-ligne { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .issue-pilule {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 18px; border-radius: var(--pilule);
    background: var(--encre); color: var(--feuille); font: 800 20px/1 var(--police-titre);
  }
  .voir-salle {
    margin-left: auto; display: inline-flex; align-items: center; gap: 8px; min-height: var(--cible);
    color: var(--encre); font: 700 15px/1 var(--police-texte);
  }
  .panneau { display: flex; flex-direction: column; gap: 22px; }
  .panneau > :global(.bouton) { align-self: flex-start; }
  .phrase { max-width: 760px; }
  .personnes { max-width: 620px; }
  .personnes :global(a) { color: var(--encre); text-decoration: none; }
  .personnes :global(a:hover) { text-decoration: underline; }
  .repondre { display: flex; flex-direction: column; gap: 10px; }
  .choix { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .choix-bouton {
    display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 22px;
    border: 1px solid var(--bord); border-radius: var(--pilule); background: var(--feuille);
    color: var(--encre); font: 700 16px/1 var(--police-texte); cursor: pointer;
  }
  .choix-bouton[aria-pressed='true'] { border: 2px solid var(--encre); padding: 0 21px; }
  .effacer { border: 0; background: none; color: var(--encre); font: 600 14px/1 var(--police-texte); text-decoration: underline; cursor: pointer; min-height: var(--cible); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .bloc { display: flex; flex-direction: column; gap: 12px; }
  .bloc > :global(.bouton) { align-self: flex-start; }
  .concret { max-width: 760px; }
  .groupes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .groupes li { display: grid; grid-template-columns: 110px minmax(0, 1fr) 230px; align-items: center; gap: 14px; }
  .sigle { font: 600 14px/1.3 var(--police-texte); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
