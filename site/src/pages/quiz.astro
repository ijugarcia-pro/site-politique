---
// Le quiz d'entrée (VDEF, lot V5 ; maquettes 02, 02b, 03, 04) : les 10 votes choisis par Julien
// (data/quiz.json), tranchés sur la tribune (components/vdef/Trancher.astro), révélés dans la
// salle. À la fin, « Ta place est prête » (palier 1, à 10 votes tranchés) : le personnage marche
// jusqu'au siège du jumeau, les 3 groupes les plus proches, « Voir depuis ton siège »,
// « Partager » (les stories, dessinées dans le navigateur) et « 3 votes de plus ». Tout est
// calculé dans le navigateur ; les réponses y restent (lib/navigateur.ts).
import Base from '../layouts/Base.astro';
import Bouton from '../components/vdef/Bouton.astro';
import Trancher from '../components/vdef/Trancher.astro';
import { composition, lotsDuParcours, questionsQuiz, scrutins } from '../lib/donnees.ts';

const cartes = questionsQuiz();
const donnees = JSON.stringify({
  // Le député de chaque siège de la salle, dans l'ordre de la composition (salle 3D, stories).
  sieges: composition().sieges.map((s) => s.depute ?? null),
  lots: lotsDuParcours(),
  horsMatrice: scrutins().filter((s) => s.motion_censure).map((s) => s.uid),
}).replace(/</g, '\\u003c');
---
<Base titre="Le quiz d'entrée" fond="tribune" vueSalle="tribune"
  focus={{ quitter: '/', total: cartes.length, libelle: `Question 1 sur ${cartes.length}` }}
  description="Prends le 578e siège : 10 vrais votes de l'Assemblée, puis le groupe et le député qui votent le plus comme toi.">
  <Trancher cartes={cartes}>
    <div class="ecran fin" slot="fin" data-ecran="resultat" hidden>
      <span class="annonce-palier" data-annonce-fin hidden></span>
      <h1 class="t-feuille" tabindex="-1" data-titre-resultat>Ta place est prête.</h1>
      <p class="t-texte" data-phrase-resultat></p>
      <div class="groupes" data-bloc-groupes hidden>
        <span class="t-etiquette">Les groupes qui votent le plus comme toi</span>
        <ol class="lignes-groupes" data-groupes></ol>
      </div>
      <p class="t-legende" data-note-resultat></p>
      <div class="actions">
        <Bouton href="/ta-place/" large data-voir-siege>Voir depuis ton siège</Bouton>
        <div class="deux">
          <Bouton variante="contour" data-ouvrir-partage>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"></path></svg>
            Partager
          </Bouton>
          <Bouton href="/lots/" variante="contour" data-votes-de-plus>3 votes de plus</Bouton>
        </div>
        <button type="button" class="recommencer" data-recommencer>Recommencer le quiz</button>
      </div>
    </div>
  </Trancher>

  <dialog class="partage" data-partage aria-labelledby="titre-partage">
    <div class="partage-tete">
      <h2 id="titre-partage" class="t-section">Montre ta place</h2>
      <button type="button" class="fermer" data-fermer aria-label="Fermer">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <p class="t-texte">Trois images prêtes pour une story. Elles ne contiennent que ce que tu vois ici, et ne partent que si tu les partages.</p>
    <div class="stories">
      <figure><img alt="Story « J'ai pris le 578e siège »" data-story="place" /><figcaption><button type="button" data-envoyer="place">Partager</button></figcaption></figure>
      <figure><img alt="Story « Mon jumeau à l'Assemblée »" data-story="jumeau" /><figcaption><button type="button" data-envoyer="jumeau">Partager</button></figcaption></figure>
      <figure><img alt="Story « Mon vote le plus à contre-courant »" data-story="contre" /><figcaption><button type="button" data-envoyer="contre">Partager</button></figcaption></figure>
    </div>
  </dialog>

  <script type="application/json" data-donnees-quiz set:html={donnees}></script>
</Base>

<script>
  import { lireJSON, repondre } from '../lib/navigateur.ts';
  import { etatLots, prochainLot } from '../lib/lots.ts';
  import { palierAtteint, prochainPalier } from '../lib/paliers.ts';
  import { initiales, partCommeToi, profil, teinte, VOTES_FIABLES, type Matrice, type Reponse } from '../lib/profil.ts';
  import { $, mesReps, pluriel, tranches, trancher } from '../lib/trancher.ts';
  import { CLE_PERSONNAGE, lireApparence } from '../salle3d/apparence.ts';
  // Les stories ne se chargent qu'au clic sur « Partager » : le quiz reste léger.
  import type { DonneesStories, TypeStory } from '../lib/stories.ts';

  const CLE = '578e.quiz.v1';

  document.addEventListener('astro:page-load', () => {
    const brut = document.querySelector('[data-donnees-quiz]')?.textContent;
    if (!brut) return;
    const { sieges, lots: nLots, horsMatrice } = JSON.parse(brut) as { sieges: (string | null)[]; lots: number; horsMatrice: string[] };
    const hors = new Set(horsMatrice);
    const t = trancher({ mot: 'Question', libelleSuivant: (i) => (i + 1 < t.questions.length ? 'Question suivante' : 'Voir ma place') });
    const { questions } = t;
    const etat = lireJSON<{ i: number; fini: boolean }>(CLE, { i: 0, fini: false });
    const sauver = () => { try { localStorage.setItem(CLE, JSON.stringify(etat)); } catch { /* stockage indisponible */ } };
    const matrice: Promise<Matrice> = fetch('/donnees/matrice.json').then((r) => r.json());
    let stories: DonneesStories | null = null;
    let reponse: Reponse | null = null;

    // --- Le résultat : ta place est prête (palier 1), ou ce qu'il manque pour la prendre ---
    const resultat = async () => {
      etat.fini = true;
      sauver();
      t.finir('resultat', 'Terminé', true);
      t.annoncer($('[data-annonce-fin]'), hors);
      const m = await matrice;
      const reps = mesReps();
      const p = profil(m, reps);
      const n = tranches(hors);
      const j = p.jumeau;
      const groupe = (uid: string | null) => m.groupes.find((g) => g.u === uid);
      const phrase = $('[data-phrase-resultat]');
      const titre = $('[data-titre-resultat]');
      const k = j ? sieges.indexOf(j.ligne.u) : -1;
      const assis = !!palierAtteint(n) && j && k >= 0;
      if (assis) {
        titre.textContent = 'Ta place est prête.';
        const b = document.createElement('strong');
        b.textContent = j.ligne.n;
        const g = groupe(j.ligne.g);
        phrase.replaceChildren('Tu sièges à la place de ', b, g ? `, ${g.libelle}. ` : ', non inscrit. ',
          `Sur tes ${pluriel(p.reponses, 'vote')} : ${pluriel(j.identiques, 'vote')} comme toi`
          + (p.egalites ? ` (et ${pluriel(p.egalites, 'autre député')} à égalité).` : '.'));
        t.salle?.vue('salle');
        // Il marche jusqu'au siège la première fois ; ensuite, il y est déjà assis.
        const deja = lireJSON<{ siege?: string }>(CLE_PERSONNAGE, {}).siege === j.ligne.u;
        t.salle?.personnage(lireApparence(lireJSON(CLE_PERSONNAGE, null)));
        t.salle?.asseoir(k, { marcher: !deja });
        t.salle?.reperes([{ i: k, libelle: `Toi · le siège de ${j.ligne.n}`, toi: true }]);
        try {
          localStorage.setItem(CLE_PERSONNAGE, JSON.stringify({ ...lireJSON<object>(CLE_PERSONNAGE, {}), siege: j.ligne.u }));
        } catch { /* stockage indisponible */ }
      } else {
        const reste = (prochainPalier(n)?.reste) ?? 0;
        titre.textContent = n ? `Encore ${pluriel(reste, 'vote')} pour prendre ta place` : 'Pas encore de place';
        phrase.textContent = n
          ? `Tu as tranché ${pluriel(n, 'vote')} : il en faut 10 pour savoir où tu siègerais. Les « Je ne sais pas » ne comptent pas.`
          : 'Tu n’as tranché aucun vote : réponds « Pour » ou « Contre » pour voir qui vote comme toi.';
        $('[data-voir-siege]').hidden = true;
        t.salle?.vue('salle');
        t.salle?.reperes([{ i: -1, libelle: 'Ta place t’attend', toi: true }]);
      }
      // Les 3 groupes les plus proches (hors non-inscrits), en votes comme toi.
      const top = p.groupes.slice(0, 3);
      $('[data-bloc-groupes]').hidden = !top.length;
      $('[data-groupes]').replaceChildren(...top.map((x, r) => {
        const li = document.createElement('li');
        const rang = document.createElement('span');
        rang.className = 'rang';
        rang.textContent = String(r + 1);
        const nom = document.createElement('span');
        nom.className = 'nom';
        nom.textContent = x.ligne.libelle;
        const sur = document.createElement('span');
        sur.className = 'sur';
        sur.textContent = r === 0 ? `${x.identiques} votes sur ${p.reponses}` : `${x.identiques} sur ${p.reponses}`;
        li.append(rang, nom, sur);
        return li;
      }));
      $('[data-note-resultat]').textContent = n >= VOTES_FIABLES
        ? `Avec ${pluriel(n, 'vote')}, ta place est fiable ; chaque vote l’affine encore.`
        : `Avec ${pluriel(n, 'vote')}, c’est une première esquisse. Ta place se précise à chaque vote ; elle est fiable à ${VOTES_FIABLES}.`;
      // La suite : 3 votes de plus (le prochain lot), ou trancher d'autres votes.
      if (prochainLot(etatLots().faits, nLots) === null) {
        const b = $<HTMLAnchorElement>('[data-votes-de-plus]');
        b.href = '/explorer/#a-trancher';
        b.textContent = 'D’autres votes';
      }
      titre.focus();
      // Les stories, prêtes à partager.
      const parDepute = new Map(p.deputes.map((x) => [x.ligne.u, x.part]));
      let contre: DonneesStories['contre'] = null;
      for (const q of questions) {
        const r = reps[q.uid];
        const kv = m.votes.indexOf(q.uid);
        if (!r || kv < 0) continue;
        const part = partCommeToi(m, kv, r);
        if (part !== null && (!contre || part < contre.part)) contre = { question: q.question, reponse: r, part };
      }
      const g0 = top[0] ?? null;
      stories = {
        groupe: g0 ? { sigle: g0.ligne.sigle, libelle: g0.ligne.libelle } : null,
        jumeau: j ? { nom: j.ligne.n, initiales: initiales(j.ligne.n), identiques: j.identiques,
          sur: p.reponses, groupe: groupe(j.ligne.g)?.sigle ?? 'non inscrit' } : null,
        contre, sieges: sieges.map((u) => (u ? teinte(parDepute.get(u) ?? null) : '#FFFFFF')),
        etoile: k, votes: p.reponses,
      };
    };

    // --- Partage ---
    const images = new Map<TypeStory, Blob>();
    const dialogue = $<HTMLDialogElement>('[data-partage]');
    $('[data-ouvrir-partage]').addEventListener('click', async () => {
      if (!stories) return;
      dialogue.showModal();
      const { dessiner, enImage } = await import('../lib/stories.ts');
      for (const type of ['place', 'jumeau', 'contre'] as TypeStory[]) {
        const blob = await enImage(await dessiner(type, stories));
        images.set(type, blob);
        $<HTMLImageElement>(`[data-story="${type}"]`).src = URL.createObjectURL(blob);
      }
    });
    $('[data-fermer]').addEventListener('click', () => dialogue.close());
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-envoyer]')) {
      b.addEventListener('click', async () => {
        const type = b.dataset.envoyer as TypeStory;
        const blob = images.get(type);
        if (!blob) return;
        const fichier = new File([blob], `578e-siege-${type}.png`, { type: 'image/png' });
        if (navigator.canShare?.({ files: [fichier] })) {
          try { await navigator.share({ files: [fichier], title: 'Le 578e siège' }); return; } catch { /* annulé */ }
        }
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = fichier.name;
        a.click();
      });
    }

    // --- Déroulé : la question, la réponse, « Voir la salle », la révélation ---
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-reponse]')) {
      b.addEventListener('click', () => {
        reponse = (b.dataset.reponse || null) as Reponse | null;
        repondre(questions[etat.i].uid, reponse);
        t.repondu(etat.i, reponse);
      });
    }
    // La dernière révélation n'annonce pas le palier : « Ta place est prête » le fait.
    $('[data-continuer]').addEventListener('click', () => t.reveler(etat.i, reponse, hors, etat.i + 1 < questions.length));
    $('[data-suivant]').addEventListener('click', () => {
      etat.i += 1;
      sauver();
      if (etat.i >= questions.length) void resultat();
      else t.poser(etat.i);
    });
    $('[data-recommencer]').addEventListener('click', () => {
      etat.i = 0;
      etat.fini = false;
      sauver();
      t.salle?.reperes([]);
      t.poser(0);
      $('[data-question]').focus();
    });
    if (etat.fini || etat.i >= questions.length) void resultat();
    else t.poser(Math.max(0, etat.i));
  });
</script>

<style>
  .fin { gap: 16px; }
  .annonce-palier {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px;
    border-radius: var(--pilule); background: var(--encre); color: var(--feuille); font: 700 13px/1 var(--police-texte);
  }
  .annonce-palier[hidden] { display: none; }
  .groupes { display: flex; flex-direction: column; gap: 6px; }
  .groupes[hidden] { display: none; }
  .lignes-groupes { list-style: none; margin: 0; padding: 0; }
  .lignes-groupes :global(li) { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-top: 1px solid var(--filet); }
  .lignes-groupes :global(.rang) {
    flex: 0 0 28px; height: 28px; border-radius: var(--pilule); background: var(--surface);
    display: flex; align-items: center; justify-content: center; font: 700 14px/1 var(--police-texte);
  }
  .lignes-groupes :global(.nom) { flex: 1; font: 700 15px/1.3 var(--police-texte); }
  .lignes-groupes :global(.sur) { font: 500 14px/1 var(--police-texte); color: var(--texte-2); white-space: nowrap; }
  .actions { margin-top: auto; display: flex; flex-direction: column; gap: 8px; }
  .deux { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .recommencer {
    align-self: center; min-height: var(--cible); border: 0; background: none; cursor: pointer;
    font: 600 14px/1 var(--police-texte); color: var(--texte-2); text-decoration: underline;
  }

  /* Le partage : les stories en grand, sur un voile. */
  .partage {
    width: min(1000px, calc(100% - 32px)); max-height: calc(100% - 32px); border: 0; padding: 28px;
    border-radius: var(--rayon-feuille); background: var(--feuille); color: var(--encre); box-shadow: var(--ombre-feuille);
  }
  .partage::backdrop { background: rgba(18, 18, 18, 0.6); }
  .partage-tete { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 8px; }
  .fermer {
    width: var(--cible); height: var(--cible); border: 0; border-radius: var(--pilule); background: var(--surface);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
  }
  .stories { margin-top: 20px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .stories figure { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .stories img { width: 100%; aspect-ratio: 9 / 16; border-radius: 16px; background: var(--surface); object-fit: cover; }
  .stories button {
    width: 100%; min-height: var(--cible); border-radius: var(--pilule); border: 1px solid var(--bord);
    background: var(--feuille); color: var(--encre); font: 700 15px/1 var(--police-texte); cursor: pointer;
  }
  @media (max-width: 720px) {
    .stories { grid-template-columns: 1fr; }
    .partage { padding: 20px 16px; }
  }
</style>
