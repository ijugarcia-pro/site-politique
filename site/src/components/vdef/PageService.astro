---
// Le gabarit des pages de service (VDEF, capture 18 ; lot V9) : « Comment c'est calculé »,
// « Tes données » (confidentialité), « État des données », « Mentions légales » et la 404. Une
// feuille pleine page (Base, gabarit « lecture »), le retour à la tribune, une sous-navigation
// en pastilles, le titre, le chapeau, puis des sections séparées par un filet (chaque <section>
// de la page). Les styles du texte (intertitres, paragraphes, listes, tableaux, exemples) sont
// posés ici pour toutes ces pages.
import Base from '../../layouts/Base.astro';

interface Props {
  titre: string;
  description: string;
  /** La pastille allumée (aucune pour la 404). */
  actif?: 'calcul' | 'donnees' | 'etat' | 'mentions';
  chapeau?: string;
  noindex?: boolean;
}
const { titre, description, actif, chapeau, noindex } = Astro.props;
const PAGES = [
  { id: 'calcul', href: '/calcul/', libelle: 'Comment c’est calculé' },
  { id: 'donnees', href: '/confidentialite/', libelle: 'Tes données' },
  { id: 'etat', href: '/etat/', libelle: 'État des données' },
  { id: 'mentions', href: '/mentions-legales/', libelle: 'Mentions légales' },
];
---
<Base titre={titre} description={description} gabarit="lecture" vue="tribune" noindex={noindex}>
  <a class="retour" href="/">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
    La tribune
  </a>
  <nav class="sous-nav" aria-label="Pages de service">
    {PAGES.map((p) => <a href={p.href} aria-current={p.id === actif ? 'page' : undefined}>{p.libelle}</a>)}
  </nav>
  <header class="entete">
    <h1 class="t-ecran">{titre}</h1>
    {chapeau && <p class="t-texte chapeau">{chapeau}</p>}
    <slot name="chapeau" />
  </header>
  <div class="service">
    <slot />
  </div>
</Base>

<style>
  .sous-nav { display: flex; flex-wrap: wrap; gap: 8px; }
  .sous-nav a {
    display: inline-flex; align-items: center; min-height: 36px; padding: 0 12px; border-radius: var(--pilule);
    background: var(--surface); color: var(--encre); text-decoration: none; font: 600 13px/1 var(--police-texte);
  }
  .sous-nav a[aria-current='page'] { background: var(--encre); color: var(--feuille); }
  .entete { display: flex; flex-direction: column; gap: 12px; }
  .chapeau, .entete :global(.chapeau) { max-width: 760px; }
  .service { display: flex; flex-direction: column; }
  .service > :global(section) { display: flex; flex-direction: column; gap: 12px; padding: 28px 0; border-top: 1px solid var(--filet); scroll-margin-top: 24px; }
  .service :global(h2) { font: 700 26px/1.2 var(--police-titre); }
  .service :global(h3) { font: 700 18px/1.3 var(--police-texte); }
  .service :global(p), .service :global(li), .service :global(td), .service :global(dd) { font: 500 16px/1.55 var(--police-texte); color: var(--texte); }
  .service :global(ul), .service :global(ol) { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  .service :global(a) { color: var(--encre); }
  .service :global(strong) { color: var(--encre); }
  .service :global(.exemple) { padding: 18px 20px; border-radius: 16px; background: var(--surface); }
  .service :global(.exemple-titre) { font: 700 15px/1.3 var(--police-texte); color: var(--encre); margin-bottom: 6px; }
  .service :global(table) { width: 100%; border-collapse: collapse; }
  .service :global(th) { padding: 10px 12px; text-align: left; vertical-align: top; font: 700 14px/1.3 var(--police-texte); background: var(--surface); }
  .service :global(td) { padding: 10px 12px; border-top: 1px solid var(--filet); text-align: left; vertical-align: top; }
  .service :global(code) { font-size: 14px; overflow-wrap: anywhere; }
  .service :global(.tableau-defile) { overflow-x: auto; border: 1px solid var(--filet); border-radius: 16px; }
  .service :global(.maj) { font: 500 14px/1.4 var(--police-texte); color: var(--texte-2); }
</style>
