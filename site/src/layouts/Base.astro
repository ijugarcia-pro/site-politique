---
// Gabarit de la VDEF « La salle est le menu » (docs/design-vdef/VDEF.md) : la salle en fond plein
// écran (image fixe de la vue, la 3D se pose dans le slot « salle » à partir du lot V3), la
// barre du haut flottante dessus, le contenu dans des feuilles. Deux gabarits :
// - « salle » : la salle nette, les feuilles posées dessus (Feuille droite, gauche ou bas) ;
// - « lecture » : la salle floutée, une feuille pleine page (pages de lecture et de service).
// Mode focus (quiz, lots, séance) : « Quitter » et la progression, pas de barre du bas.
// Sur téléphone : la salle sur 300 px en haut, la feuille qui monte, la barre du bas.
// La salle reste d'une page à l'autre (transitions d'Astro, components/vdef/Salle.astro) : les
// scripts des pages s'abonnent à « astro:page-load » (qui suit aussi le premier chargement) et
// vérifient qu'ils sont sur leur page ; une page de l'ancien gabarit (BaseSeance.astro) se charge
// en entier. Polices servies par le site (aucun appel à Google).
import '@fontsource-variable/bricolage-grotesque/index.css';
import '@fontsource-variable/figtree/index.css';
import '../styles/global.css';
import '../styles/motion.css';
import { ClientRouter } from 'astro:transitions';
import BarreBas from '../components/vdef/BarreBas.astro';
import BarreHaut from '../components/vdef/BarreHaut.astro';
import Feuille from '../components/vdef/Feuille.astro';
import PiedFeuille from '../components/vdef/PiedFeuille.astro';
import Salle from '../components/vdef/Salle.astro';
import { scrutins, semaine } from '../lib/donnees.ts';

type Vue = 'tribune' | 'salle' | 'place';

interface Props {
  titre: string;
  description: string;
  gabarit?: 'salle' | 'lecture';
  /** La vue allumée dans les barres (aucune pour une page de lecture hors des trois vues). */
  vue?: Vue;
  /** L'entrée allumée dans la barre du bas du téléphone (« galerie » pour la galerie). */
  bas?: Vue | 'galerie';
  /** L'image fixe de la salle : la tribune ou la salle vue du perchoir. */
  fond?: 'tribune' | 'salle';
  /** La vue de la salle 3D (par défaut, celle de la barre, sinon celle de l'image fixe). */
  vueSalle?: Vue;
  focus?: { quitter: string; total: number; fait?: number; libelle?: string };
  /** Données structurées schema.org de la page (JSON-LD). */
  jsonld?: Record<string, unknown>;
  /** Page interne (démonstration) : jamais indexée. */
  noindex?: boolean;
}

const { titre, description, gabarit = 'salle', vue, fond = gabarit === 'lecture' ? 'salle' : 'tribune',
  focus, jsonld, noindex = false } = Astro.props;
const bas = Astro.props.bas ?? vue;
const vueSalle = Astro.props.vueSalle ?? vue ?? fond;
const canonique = new URL(Astro.url.pathname, Astro.site).href;
const titreComplet = titre === 'Le 578e siège' ? titre : `${titre} · Le 578e siège`;
// Les votes tranchés comptent les réponses aux votes de la matrice : tous les votes à page, sauf
// les motions de censure (lib/profil.ts).
const horsMatrice = JSON.stringify(scrutins().filter((s) => s.motion_censure).map((s) => s.uid));
// Les votes de séance devenus scrutins (t24) : la réponse donnée avant le vote rejoint les
// autres réponses du visiteur, sur n'importe quelle page.
const sem = semaine();
const tranches = JSON.stringify({
  ...Object.fromEntries(sem.historique.map((h) => [h.lundi, h.tranches ?? {}])),
  [sem.lundi]: Object.fromEntries(sem.votes.filter((v) => v.type === 'annonce' && v.scrutin)
    .map((v) => [v.cle, v.scrutin!.uid])),
});
const ALT = { tribune: 'La tribune de l’Assemblée nationale en 3D, vue depuis l’hémicycle.',
  salle: 'La salle de l’Assemblée nationale en 3D, vue depuis le perchoir.' };
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonique} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Le 578e siège" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta name="twitter:card" content="summary" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld).replace(/</g, '\\u003c')}></script>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
  </head>
  <body class:list={['vdef', `gabarit-${gabarit}`, { focus: !!focus }]}>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <div class="cadre">
      <div class="scene" data-scene={fond}>
        <picture>
          <source media="(max-width: 720px)" srcset={`/salle3d/fond-${fond}-telephone.webp`} />
          <img class="fond" src={`/salle3d/fond-${fond}.webp`} alt={gabarit === 'lecture' ? '' : ALT[fond]}
            aria-hidden={gabarit === 'lecture' ? 'true' : undefined} decoding="async" />
        </picture>
        <Salle />
      </div>
      {focus && <BarreHaut focus={focus} data-barre-focus />}
      <!-- En mode focus, la barre normale attend la fin (lib/trancher.ts, finir) : cachée. -->
      <BarreHaut vue={vue} data-barre-normale hidden={!!focus} />
      {gabarit === 'lecture' ? (
        <main id="contenu" class="page-lecture" data-vue-salle={vueSalle}>
          <Feuille position="lecture" balise="div">
            <slot />
            <PiedFeuille />
          </Feuille>
        </main>
      ) : (
        <main id="contenu" class="sur-salle" data-vue-salle={vueSalle}>
          <slot />
        </main>
      )}
    </div>
    <BarreBas actif={bas} />
    <script type="application/json" data-hors-matrice set:html={horsMatrice}></script>
    <script type="application/json" data-tranches-seance set:html={tranches}></script>
    <script>
      import { reponses } from '../lib/navigateur.ts';
      import { palierAtteint, PALIERS, prochainPalier, votesTranches } from '../lib/paliers.ts';
      import { reporterReponses } from '../lib/seances.ts';

      // L'anneau de progression et le cadenas de « Ta place » (VDEF § 3 et § 5) : calculés sur
      // place à partir des votes tranchés, comme tout le profil ; recalculés quand une page
      // enregistre une réponse (événement « vdef:reponses », lib/trancher.ts).
      const majAnneau = () => {
        const hors = new Set(JSON.parse(
          document.querySelector('[data-hors-matrice]')?.textContent ?? '[]') as string[]);
        const n = votesTranches(Object.fromEntries(
          Object.entries(reponses()).filter(([uid]) => !hors.has(uid))));
        const atteint = palierAtteint(n);
        const prochain = prochainPalier(n);
        const votes = `${n} vote${n > 1 ? 's' : ''}`;
        for (const a of document.querySelectorAll<HTMLElement>('[data-anneau]')) {
          const part = prochain ? n / prochain.palier.seuil : 1;
          a.style.setProperty('--angle', `${Math.round(360 * part)}deg`);
          a.querySelector('[data-anneau-texte]')!.textContent = atteint
            ? `${votes} · Palier ${atteint.rang} sur ${PALIERS.length}` : `Ton parcours · ${votes}`;
          a.setAttribute('aria-label', `Ton parcours : ${votes} tranché${n > 1 ? 's' : ''}`
            + (prochain ? `, encore ${prochain.reste} pour « ${prochain.palier.libelle} »` : ', tous les paliers débloqués'));
        }
        if (atteint) {
          for (const lien of document.querySelectorAll<HTMLElement>('[data-verrou]')) {
            lien.removeAttribute('data-verrou');
            lien.querySelector('[data-verrou-texte]')?.remove();
          }
        }
      };
      document.addEventListener('vdef:reponses', majAnneau);

      document.addEventListener('astro:page-load', () => {
      reporterReponses(JSON.parse(
        document.querySelector('[data-tranches-seance]')?.textContent ?? '{}') as Record<string, Record<string, string>>);

      majAnneau();

      // Les formulaires « code postal » mènent à /deputes/#cp=… : le fragment n'est jamais
      // envoyé au serveur. Sans JavaScript, ils passent par ?cp=, que la page efface.
      for (const form of document.querySelectorAll<HTMLFormElement>('form[action="/deputes/"]')) {
        form.addEventListener('submit', (ev) => {
          ev.preventDefault();
          const cp = String(new FormData(form).get('cp') ?? '').trim();
          location.href = `/deputes/#cp=${encodeURIComponent(cp)}`;
        });
      }
      });
    </script>
  </body>
</html>

<style>
  .evitement {
    position: absolute; z-index: 30; left: 12px; top: -80px;
    padding: 12px 18px; border-radius: var(--pilule);
    background: var(--encre); color: var(--feuille); font: 700 15px/1 var(--police-texte);
  }
  .evitement:focus { top: 12px; }
  /* Mode focus : pas de barre du bas (maquette T2). */
  :global(body.focus .barre-bas) { display: none !important; }

  .cadre { position: relative; }
  .scene { position: absolute; inset: 0; z-index: 0; overflow: hidden; background: var(--fond-salle); }
  .fond { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }

  /* La salle nette, les feuilles posées dessus : un écran, sans défilement de la page. */
  .gabarit-salle .cadre { height: 100vh; height: 100dvh; min-height: 760px; overflow: hidden; }
  .sur-salle { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .sur-salle > :global(*) { pointer-events: auto; }
  /* La tribune vue d'en bas : le pupitre dans le tiers haut (la feuille du bas couvre la moitié
     basse, maquette 05). */
  .gabarit-salle .scene[data-scene='tribune'] .fond {
    position: absolute; left: 0; top: -36.7%; height: 126.7%; object-position: 50% 50%;
  }

  /* Lecture : la salle floutée et fixe, une feuille pleine page qui défile. */
  .gabarit-lecture .scene { position: fixed; }
  .gabarit-lecture .fond { transform: scale(1.08); filter: blur(18px) brightness(0.72); }
  .page-lecture { position: relative; z-index: 3; padding: 92px var(--marge) 0; }

  @media (max-width: 720px) {
    body:not(.focus) { padding-bottom: 74px; }
    .gabarit-salle .cadre { height: auto; min-height: 0; overflow: visible; }
    .gabarit-salle .scene { position: relative; inset: auto; height: 300px; }
    .gabarit-salle .scene[data-scene='tribune'] .fond { position: static; height: 100%; object-position: 50% 45%; }
    .sur-salle { position: relative; inset: auto; pointer-events: auto; }
    .page-lecture { padding: 72px 0 0; }
  }
</style>
