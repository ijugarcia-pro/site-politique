---
// Un palier (VDEF § 5 et § 7) : rond plein coché (débloqué), anneau de progression (en cours),
// cadenas en pointillé (verrouillé). Le libellé et le détail sont des phrases (« 12 / 25 votes »,
// « Débloquée à 10 votes ») ; l'état est aussi dit aux lecteurs d'écran. Les attributs data-*
// permettent à la page de le mettre à jour dans le navigateur (lib/paliers.ts).
interface Props {
  etat: 'fait' | 'en-cours' | 'verrouille';
  libelle: string;
  detail?: string;
  /** Pour « en-cours » : la part faite, entre 0 et 1. */
  progression?: number;
  class?: string;
  [attr: string]: unknown;
}
const { etat, libelle, detail, progression = 0, class: classe, ...reste } = Astro.props;
const ETATS = { fait: 'débloqué', 'en-cours': 'en cours', verrouille: 'verrouillé' };
const angle = Math.round(360 * Math.min(1, Math.max(0, progression)));
---
<span class:list={['palier', etat, classe]} style={`--angle: ${angle}deg`} {...reste}>
  <span class="marque" aria-hidden="true">
    <svg class="coche" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
    <svg class="cadenas" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
  </span>
  <span class="textes">
    <span class="libelle">{libelle}<span class="visuellement-cache" data-palier-etat> · {ETATS[etat]}</span></span>
    {detail && <span class="detail" data-palier-detail>{detail}</span>}
  </span>
</span>

<style>
  .palier { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .marque {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border-radius: var(--pilule);
  }
  .marque svg { display: none; }
  .fait .marque { background: var(--encre); color: var(--feuille); }
  .fait .coche { display: block; }
  .en-cours .marque {
    background: conic-gradient(var(--encre) var(--angle), var(--bord) 0);
    -webkit-mask: radial-gradient(circle, transparent 9px, #000 9.5px);
    mask: radial-gradient(circle, transparent 9px, #000 9.5px);
  }
  .verrouille .marque { border: 1.5px dashed var(--pointille); color: var(--inactif); }
  .verrouille .cadenas { display: block; }
  .textes { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .libelle { font: 700 15px/1.2 var(--police-texte); }
  .detail { font: 500 13px/1.3 var(--police-texte); color: var(--texte-2); }
</style>
