---
// La séance de la semaine (t24 ; VDEF, lot V5 ; maquettes 06, 06b, 07) : les 3 votes choisis par
// pipeline/semaine.py, tranchés sur la tribune (components/vdef/Trancher.astro). Un vote annoncé
// se tranche avant les députés (« Vote avant eux »), avec un pronostic facultatif ; un vote déjà
// tenu est révélé dans la salle, comme dans le quiz. Fin de séance : « A voté. », tes réponses,
// le rendez-vous du verdict et « Ajouter le verdict à mon agenda » (un fichier .ics créé dans le
// navigateur : rien n'est envoyé ; les comptes et les e-mails viendront avec t30 à t32). Tout
// reste dans le navigateur (lib/seances.ts).
import Base from '../layouts/Base.astro';
import Bouton from '../components/vdef/Bouton.astro';
import Feuille from '../components/vdef/Feuille.astro';
import Trancher from '../components/vdef/Trancher.astro';
import { dateLisible, lotsDuParcours, quandVote, questionSeance, scrutins, semaine } from '../lib/donnees.ts';

const sem = semaine();
const votes = sem.vacances ? [] : sem.votes.filter((v) => v.statut !== 'retiré');
const JOURS = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
const jourHeure = (v: (typeof votes)[number]) => {
  const jour = JOURS[new Date(`${v.date}T12:00:00Z`).getUTCDay()];
  return v.debut ? `${jour} à ${Number(v.debut.slice(11, 13))} h${v.debut.slice(14, 16) !== '00' ? ` ${v.debut.slice(14, 16)}` : ''}` : jour;
};
const cartes = votes.map((v) => {
  const q = questionSeance(v);
  return { uid: v.statut === 'voté' ? v.scrutin?.uid ?? '' : '', numero: v.scrutin?.numero ?? 0,
    theme: v.carte?.theme ?? 'Vote solennel', question: q.question, concretement: q.concretement, titre: q.titre,
    quand: quandVote(v), quandCourt: jourHeure(v) };
});
// Les rendez-vous du verdict : les votes annoncés pas encore tenus ; le verdict le lendemain matin.
const attendus = votes.filter((v) => v.type === 'annonce' && v.statut === 'à venir');
const dernier = attendus.map((v) => v.date).sort().at(-1) ?? null;
const lendemainIso = dernier ? new Date(Date.parse(`${dernier}T12:00:00Z`) + 86400000).toISOString().slice(0, 10) : null;
const MOIS = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];
const seanceDu = `Séance du ${Number(sem.lundi.slice(8, 10))} ${MOIS[Number(sem.lundi.slice(5, 7)) - 1]}`;
const donnees = JSON.stringify({
  lundi: sem.lundi, cles: votes.map((v) => v.cle),
  premier: attendus[0] ? { quand: jourHeure(attendus[0]) } : null,
  verdict: lendemainIso ? { date: lendemainIso, jour: JOURS[new Date(`${lendemainIso}T12:00:00Z`).getUTCDay()] } : null,
  site: Astro.site?.href ?? 'https://le578esiege.pages.dev/',
  horsMatrice: scrutins().filter((s) => s.motion_censure).map((s) => s.uid),
  parcours: lotsDuParcours(),
}).replace(/</g, '\\u003c');
---
{votes.length === 0 ? (
  <Base titre="La séance de la semaine" vue="tribune" fond="tribune"
    description="3 vrais votes de l'Assemblée à trancher avant les députés, puis le verdict.">
    <Feuille position="droite" titre="titre-vacances">
      <span class="t-etiquette">Semaine du {dateLisible(sem.lundi)}</span>
      <h1 id="titre-vacances" class="t-feuille">Pas de séance cette semaine</h1>
      <p class="t-texte">{sem.vacances
        ? 'L’Assemblée ne siège pas : ce sont les vacances parlementaires. Ta série attend la reprise.'
        : 'Aucun vote n’est prévu cette semaine.'}</p>
      <div class="actions">
        <Bouton href="/lots/" large>Trancher des votes passés</Bouton>
        <Bouton href="/" variante="contour" large>Retour à la tribune</Bouton>
      </div>
    </Feuille>
  </Base>
) : (
  <Base titre="La séance de la semaine" fond="tribune" vueSalle="tribune" focus={{ quitter: '/', total: votes.length }}
    description="3 vrais votes de l'Assemblée à trancher avant les députés, puis le verdict.">
    <Trancher cartes={cartes} pronostic>
      <div class="ecran fin" slot="fin" data-ecran="fin" hidden>
        <span class="annonce-palier" data-annonce-fin hidden></span>
        <span class="t-etiquette">{seanceDu} · terminée pour toi</span>
        <h1 class="t-ecran titre-fin" tabindex="-1" data-fin-titre>A voté.</h1>
        <p class="t-texte" data-fin-texte></p>
        <ul class="lignes" data-fin-reponses></ul>
        {lendemainIso && (
          <div class="agenda" data-agenda>
            <span class="agenda-titre">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
              Le rendez-vous du verdict
            </span>
            <p class="t-legende">Un rappel dans ton agenda, le matin du verdict. Le fichier est créé sur ton appareil : rien n’est envoyé, aucun compte n’est nécessaire.</p>
            <Bouton variante="contour" data-ajouter-agenda>Ajouter le verdict à mon agenda</Bouton>
          </div>
        )}
        <p class="t-legende attente" data-fin-attente></p>
        <div class="actions">
          <Bouton href="/lots/" large data-fin-principal>Trancher des votes passés</Bouton>
          <Bouton href="/" variante="contour" large>Retour à la tribune</Bouton>
        </div>
      </div>
    </Trancher>
    <script type="application/json" data-donnees-semaine set:html={donnees}></script>
  </Base>
)}

<script>
  import { repondre } from '../lib/navigateur.ts';
  import { etatLots, prochainLot } from '../lib/lots.ts';
  import { prochainPalier } from '../lib/paliers.ts';
  import type { Reponse } from '../lib/profil.ts';
  import { etatSeance, sauverSeance, type Pronostic } from '../lib/seances.ts';
  import { $, pluriel, tranches, trancher } from '../lib/trancher.ts';

  /** Le fichier d'agenda du verdict (iCalendar), créé dans le navigateur. */
  const fichierAgenda = (date: string, site: string) => {
    const jour = date.replaceAll('-', '');
    const suivant = new Date(Date.parse(`${date}T12:00:00Z`) + 86400000).toISOString().slice(0, 10).replaceAll('-', '');
    const maintenant = new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d+/, '');
    return ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Le 578e siège//Verdict//FR', 'CALSCALE:GREGORIAN',
      'BEGIN:VEVENT', `UID:verdict-${jour}@le578esiege`, `DTSTAMP:${maintenant}`,
      `DTSTART;VALUE=DATE:${jour}`, `DTEND;VALUE=DATE:${suivant}`,
      'SUMMARY:Le verdict de la séance · Le 578e siège',
      `DESCRIPTION:Les députés ont voté : découvre le verdict et compare-le à tes réponses. ${site}verdict/`,
      `URL:${site}verdict/`, 'END:VEVENT', 'END:VCALENDAR', ''].join('\r\n');
  };

  document.addEventListener('astro:page-load', () => {
    const brut = document.querySelector('[data-donnees-semaine]')?.textContent;
    if (!brut) return;
    const { lundi, cles, premier, verdict, site, horsMatrice, parcours } = JSON.parse(brut) as {
      lundi: string; cles: string[]; premier: { quand: string } | null;
      verdict: { date: string; jour: string } | null; site: string; horsMatrice: string[]; parcours: number };
    const hors = new Set(horsMatrice);
    const etat = etatSeance(lundi);
    const t = trancher({ libelleSuivant: (i) => (i + 1 < cles.length ? 'Vote suivant' : 'Fin de la séance') });
    const { questions } = t;
    const sauver = () => sauverSeance(lundi, etat);

    const fin = () => {
      etat.fini = true;
      sauver();
      t.finir('fin');
      t.annoncer($('[data-annonce-fin]'), hors);
      t.salle?.vue('tribune');
      const enAttente = questions.some((q, k) => q.attente && cles[k] in etat.reponses);
      $('[data-fin-texte]').textContent = enAttente && premier && verdict
        ? `${premier.quand.charAt(0).toUpperCase()}${premier.quand.slice(1)}, les 577 députés votent à leur tour. Le verdict arrive ${verdict.jour} matin, dès que l’Assemblée publie le scrutin.`
        : 'Tes réponses comptent dans ta place.';
      $('[data-fin-reponses]').replaceChildren(...questions.map((q, k) => {
        const li = document.createElement('li');
        const r = etat.reponses[cles[k]];
        const titre = document.createElement('span');
        titre.textContent = q.titre;
        const droite = document.createElement('span');
        const pt = document.createElement('span');
        pt.className = `point ${r ?? 'non-votant'}`;
        pt.setAttribute('aria-hidden', 'true');
        droite.append(pt, r === undefined ? 'Pas tranché' : r === 'pour' ? 'Pour' : r === 'contre' ? 'Contre' : 'Je ne sais pas');
        li.append(titre, droite);
        return li;
      }));
      const prochain = prochainPalier(tranches(hors));
      $('[data-fin-attente]').textContent = prochain
        ? `En attendant : ${pluriel(prochain.reste, 'vote')} avant ${prochain.palier.libelle.toLowerCase()}.` : '';
      // L'action principale : le verdict s'il y en a un, sinon des votes passés.
      const principal = $<HTMLAnchorElement>('[data-fin-principal]');
      if (questions.some((q) => !q.attente)) { principal.href = '/verdict/'; principal.textContent = 'Voir le verdict'; }
      else if (prochainLot(etatLots().faits, parcours) === null) { principal.href = '/explorer/#a-trancher'; principal.textContent = 'Trancher d’autres votes'; }
      $('[data-fin-titre]').focus();
    };

    const suivant = () => {
      etat.i += 1;
      sauver();
      if (etat.i < questions.length) t.poser(etat.i);
      else fin();
    };
    let reponse: Reponse | null = null;
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-reponse]')) {
      b.addEventListener('click', () => {
        const q = questions[etat.i];
        reponse = (b.dataset.reponse || null) as Reponse | null;
        etat.reponses[cles[etat.i]] = reponse;
        sauver();
        if (!q.attente) repondre(q.uid, reponse);
        t.repondu(etat.i, reponse, { lendemain: q.attente && verdict ? verdict.jour : null,
          pronostic: etat.pronostics[cles[etat.i]] });
      });
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-prono]')) {
      b.addEventListener('click', () => {
        const cle = cles[etat.i];
        const choix = b.dataset.prono as Pronostic;
        if (etat.pronostics[cle] === choix) delete etat.pronostics[cle];
        else etat.pronostics[cle] = choix;
        sauver();
        for (const x of document.querySelectorAll<HTMLButtonElement>('[data-prono]')) {
          x.setAttribute('aria-pressed', String(etat.pronostics[cle] === x.dataset.prono));
        }
      });
    }
    $('[data-continuer]').addEventListener('click', () => {
      if (questions[etat.i].attente) suivant(); else t.reveler(etat.i, reponse, hors);
    });
    $('[data-suivant]').addEventListener('click', suivant);
    document.querySelector('[data-ajouter-agenda]')?.addEventListener('click', () => {
      if (!verdict) return;
      const blob = new Blob([fichierAgenda(verdict.date, site)], { type: 'text/calendar;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `verdict-${verdict.date}.ics`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 10000);
    });
    if (etat.fini || etat.i >= questions.length) fin();
    else t.poser(etat.i);
  });
</script>

<style>
  .fin { gap: 16px; }
  .titre-fin { font-size: 56px; }
  .annonce-palier {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px;
    border-radius: var(--pilule); background: var(--encre); color: var(--feuille); font: 700 13px/1 var(--police-texte);
  }
  .annonce-palier[hidden] { display: none; }
  .lignes :global(li > span:first-child) { flex: 1; min-width: 0; }
  .lignes :global(li > span:last-child) { white-space: nowrap; }
  .agenda { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px; border-radius: var(--rayon-carte); background: var(--surface); }
  .agenda-titre { display: inline-flex; align-items: center; gap: 8px; font: 700 16px/1.2 var(--police-texte); }
  .attente { margin-top: auto; }
  .actions { display: flex; flex-direction: column; gap: 8px; }
  @media (max-width: 720px) { .titre-fin { font-size: 34px; } }
</style>
