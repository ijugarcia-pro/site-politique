---
// Les lots de votes (t44) : après le quiz, des lots de 3 votes passés (data/lots.json, choix de
// Julien), à trancher comme une séance (frame V5 « ⑥ Séance », sans pronostic ni série tant que
// la séance de la semaine n'existe pas), avec la révélation du vrai vote après chaque réponse.
// Fin de lot (frame « ⑦ Séance terminée ») : le tampon, la précision gagnée, ton carnet de lots
// et « Lot suivant » ; jamais plus de 3 votes d'affilée. Après les lots du parcours viennent les
// lots facultatifs (t47) : la fin de lot propose « Affiner encore », rien ne les impose, et un
// lot facultatif ne démarre jamais seul. Où en est le visiteur : lib/lots.ts, dans son
// navigateur.
import Base from '../layouts/Base.astro';
import EnteteSeance from '../components/EnteteSeance.astro';
import JaugePrecision from '../components/JaugePrecision.astro';
import Seance from '../components/Seance.astro';
import { lotsDeVotes, lotsDuParcours } from '../lib/donnees.ts';
import { puceTheme } from '../lib/themes.ts';

const lots = lotsDeVotes();
const cartes = lots.flat();
const parLot = lots[0].length;
const parcours = lotsDuParcours();
---
<Base titre="Votes passés" focus
  description="Tranche de vrais votes de l'Assemblée, 3 par 3, et regarde ta place se préciser dans l'hémicycle.">
  <EnteteSeance slot="entete" total={parLot} libelle="Progression du lot" titre="Votes passés"
    sortie={{ href: '/hemicycle/', texte: 'Mon hémicycle' }} />

  <Seance cartes={cartes} puces={cartes.map((c) => puceTheme(c.theme))} dates>
    <div class="fin" slot="fin" data-ecran="fin" hidden>
      <div class="tampon" data-tampon>
        <span class="tampon-haut">Votes passés</span>
        <span class="tampon-grand" data-tampon-lot></span>
        <span class="tampon-a-vote">A voté</span>
        <span class="tampon-bas" data-tampon-bas></span>
      </div>
      <h1 tabindex="-1" data-fin-titre>Lot terminé&nbsp;!</h1>
      <p class="fin-texte" data-fin-texte></p>
      <div class="carte-precision">
        <JaugePrecision grand />
        <span class="libelle">de précision</span>
        <span class="petit" data-fin-gain></span>
      </div>
      <div class="carnet">
        <div class="carnet-tete">
          <span class="carnet-titre">Ton carnet · votes passés</span>
          <span class="carnet-compte" data-carnet-compte></span>
        </div>
        <ol class="tampons" data-tampons aria-label="Tes lots de votes">
          {lots.slice(0, parcours).map((_, k) => <li data-case={k}><span class="mini">lot</span>{k + 1}</li>)}
        </ol>
        {lots.length > parcours && (
          <div data-carnet-facultatifs hidden>
            <p class="carnet-suite">Pour affiner · facultatif</p>
            <ol class="tampons" aria-label="Les lots facultatifs">
              {lots.slice(parcours).map((_, k) => <li data-case={parcours + k}><span class="mini">lot</span>{parcours + k + 1}</li>)}
            </ol>
          </div>
        )}
      </div>
      <div class="actions">
        <button type="button" class="b-principal" data-lot-suivant>Lot suivant →</button>
        <a class="b-second" href="/hemicycle/" data-fin-second>Mon hémicycle</a>
      </div>
    </div>
  </Seance>

  <script type="application/json" data-par-lot set:html={JSON.stringify({ parLot, parcours })}></script>
</Base>

<script>
  import { repondre } from '../lib/navigateur.ts';
  import { ANCRE_AFFINER, etatLots, sauverLots, suiteDesLots } from '../lib/lots.ts';
  import { precision, VOTES_FIABLES, type Reponse } from '../lib/profil.ts';
  import { jauge } from '../lib/jauge.ts';
  import { $, mesReps, pluriel, seance } from '../lib/seance.ts';

  const { parLot, parcours } = JSON.parse($('[data-par-lot]').textContent!) as {
    parLot: number; parcours: number };
  const etat = etatLots();
  const s = seance({
    libelleContinuer: (i) => (i % parLot + 1 < parLot ? 'Continuer' : 'Fin du lot'),
    rang: (i) => ({ n: i % parLot, total: parLot }),
  });
  const nLots = s.questions.length / parLot;
  const titre = (k: number) => {
    $('[data-titre-seance]').textContent = k < parcours
      ? `Votes passés · lot ${k + 1} sur ${parcours}` : `Pour affiner · lot ${k + 1} sur ${nLots}`;
  };

  const commencer = (k: number) => {
    etat.lot = k;
    etat.i = 0;
    sauverLots(etat);
    titre(k);
    s.poser(k * parLot);
    $('[data-question]').focus();
  };

  /** La fin d'un lot (k), ou, quand on arrive sans lot du parcours à faire, l'écran « tout est
   *  fait » : il propose les lots facultatifs tant qu'il en reste. */
  const fin = async (k: number | null) => {
    s.finir('fin');
    const m = s.matrice() ?? await s.chargement;
    const reps = mesReps();
    const p = s.tonHemicycle(m)!;
    s.panneauHemicycle('Plus un siège est foncé, plus ce député a voté comme toi');
    const n = p.reponses;
    const dansLot = k === null ? 0
      : s.questions.slice(k * parLot, (k + 1) * parLot).filter((q) => reps[q.uid]).length;
    const gain = Math.round(100 * precision(n)) - Math.round(100 * precision(n - dansLot));
    const suite = suiteDesLots(etat.faits, parcours, nLots);
    const suivant = suite.lot;
    const faits = etat.faits.length;
    const manque = VOTES_FIABLES - n;
    const facultatifs = `${pluriel(suite.resteFacultatifs, 'lot')} `
      + `facultatif${suite.resteFacultatifs > 1 ? 's' : ''} de ${parLot} votes`;
    $('[data-tampon-lot]').textContent = k === null ? `${faits} lots` : `Lot ${k + 1}`;
    $('[data-tampon-bas]').textContent = k === null ? `${pluriel(faits * parLot, 'vote')} tranchés`
      : `${pluriel(dansLot, 'vote')} · 578e siège`;
    $('[data-fin-titre]').textContent = k !== null ? 'Lot terminé !'
      : suivant === null ? 'Tous les lots sont faits !'
      : faits === parcours ? `Les ${parcours} lots sont faits !` : `${faits} lots sur ${nLots} sont faits`;
    $('[data-fin-texte]').textContent = (k === null || dansLot
      ? 'Tes réponses comptent dans ton hémicycle. '
      : 'Tu n\'as tranché aucun de ces votes : ton hémicycle ne change pas. ')
      + (suivant === null
        ? (manque <= 0 ? `Ta place est fiable : ${Math.round(100 * p.precision)} % de précision ; chaque vote l'affine encore.`
          : `Pour une place fiable, il faut ${VOTES_FIABLES} votes : encore ${manque} à trancher dans Explorer.`)
        : suite.facultatif
          ? (manque <= 0 ? `Ta place est fiable : ${Math.round(100 * p.precision)} % de précision. Pour l'affiner encore, si tu veux : ${facultatifs}.`
            : `Pour une place fiable, il faut ${VOTES_FIABLES} votes : encore ${manque} à trancher. Il reste ${facultatifs}.`)
          : `Encore ${pluriel(suite.resteParcours, 'lot')} de ${parLot} votes.`);
    jauge($('.carte-precision [data-jauge]'), n - dansLot, n);
    $('[data-fin-gain]').textContent = k === null ? pluriel(n, 'vote')
      : `+${gain} point${gain > 1 ? 's' : ''} · ${pluriel(n, 'vote')}`;
    // Le carnet : les lots du parcours ; les facultatifs s'y ajoutent une fois le parcours fait.
    $('[data-carnet-compte]').textContent = faits > parcours ? `${faits} sur ${nLots}`
      : `${parcours - suite.resteParcours} sur ${parcours}`;
    const rang = document.querySelector<HTMLElement>('[data-carnet-facultatifs]');
    if (rang) rang.hidden = suite.resteParcours > 0;
    for (const li of document.querySelectorAll<HTMLElement>('[data-case]')) {
      const c = Number(li.dataset.case);
      li.className = c === k ? 'vient' : etat.faits.includes(c) ? 'fait'
        : c === suivant ? 'prochain' : 'a-venir';
    }
    const bouton = $<HTMLButtonElement>('[data-lot-suivant]');
    const second = $<HTMLAnchorElement>('[data-fin-second]');
    bouton.hidden = suivant === null;
    bouton.textContent = suite.facultatif ? `Affiner encore · lot ${suivant! + 1} →`
      : `Lot suivant · ${parLot} votes →`;
    bouton.onclick = () => commencer(suivant!);
    // Tout est fait : après le dernier lot, voir sa place ; en arrivant, trancher d'autres votes.
    second.href = suivant === null && k === null ? '/explorer/#a-trancher' : '/hemicycle/';
    second.textContent = suivant !== null ? 'Mon hémicycle'
      : k === null ? 'Trancher d\'autres votes →' : 'Voir mon hémicycle →';
    second.classList.toggle('b-principal', suivant === null);
    second.classList.toggle('b-second', suivant !== null);
    $('[data-tampon]').classList.remove('anime');
    void $('[data-tampon]').offsetWidth;
    $('[data-tampon]').classList.add('anime');
    $('[data-fin-titre]').focus();
  };

  // --- Déroulé ---
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-reponse]')) {
    b.addEventListener('click', () => {
      const i = etat.lot! * parLot + etat.i;
      const v = (b.dataset.reponse || null) as Reponse | null;
      repondre(s.questions[i].uid, v);
      s.reveler(i, v);
    });
  }
  $('[data-continuer]').addEventListener('click', () => {
    etat.i += 1;
    if (etat.i < parLot) {
      sauverLots(etat);
      s.poser(etat.lot! * parLot + etat.i);
      return;
    }
    const k = etat.lot!;
    if (!etat.faits.includes(k)) etat.faits.push(k);
    etat.lot = null;
    etat.i = 0;
    sauverLots(etat);
    fin(k);
  });

  // Reprendre le lot en cours, sinon le prochain lot du parcours. Le parcours fait : l'écran de
  // fin, qui propose la suite ; un lot facultatif ne démarre que par un lien « Affiner encore ».
  if (etat.lot !== null && etat.lot < nLots && etat.i < parLot) {
    titre(etat.lot);
    s.poser(etat.lot * parLot + etat.i);
  } else {
    const suite = suiteDesLots(etat.faits, parcours, nLots);
    if (suite.lot === null || (suite.facultatif && location.hash !== ANCRE_AFFINER)) {
      $('[data-titre-seance]').textContent = 'Votes passés';
      fin(null);
    } else {
      // L'ancre a servi : un rechargement ne doit pas lancer le lot facultatif suivant.
      if (location.hash) history.replaceState(null, '', location.pathname);
      etat.lot = suite.lot;
      etat.i = 0;
      sauverLots(etat);
      titre(suite.lot);
      s.poser(suite.lot * parLot);
    }
  }
</script>

<style>
  /* Cotes reprises de la frame V5 « ⑦ Séance terminée » ; sans série, pronostics, rendez-vous du
     verdict ni duel, qui n'existent pas encore : l'écran se resserre sur le tampon, la précision
     et le carnet, à gauche de ton hémicycle. */
  .fin { display: flex; flex-direction: column; align-items: flex-start; }
  .tampon { align-self: center; display: flex; flex-direction: column; align-items: center; justify-content: center;
    width: 220px; height: 220px; border-radius: 50%; border: 6px solid var(--violet); color: var(--violet-fonce);
    background: #FFFFFF; box-shadow: inset 0 0 0 7px #FFFFFF, inset 0 0 0 10px var(--filet), 0 10px 0 var(--panneau-2);
    transform: rotate(-8deg); }
  .tampon:global(.anime) { animation: tampon .6s cubic-bezier(.2,.8,.2,1) both; }
  @media (prefers-reduced-motion: reduce) { .tampon:global(.anime) { animation: none; } }
  .tampon-haut { font-family: var(--police-titre); font-weight: 600; font-size: 13px; letter-spacing: 0.14em;
    text-transform: uppercase; }
  .tampon-grand { font-family: var(--police-titre); font-weight: 700; font-size: 44px; line-height: 1.05; }
  .tampon-a-vote { margin-top: 8px; padding: 4px 16px; border: 3px solid var(--violet); border-radius: var(--rayon);
    font-family: var(--police-titre); font-weight: 700; font-size: 22px; letter-spacing: 0.1em; text-transform: uppercase; }
  .tampon-bas { margin-top: 10px; font-size: 13px; font-weight: 700; }
  .fin h1 { margin: 28px 0 0; font-weight: 700; font-size: clamp(36px, 3.4vw, 46px); line-height: 1; outline: none; }
  .fin-texte { margin: 12px 0 0; font-size: 18px; line-height: 1.5; color: var(--gris); }
  .carte-precision { display: flex; flex-direction: column; margin-top: 20px; padding: 18px; border-radius: var(--rayon);
    background: var(--panneau-2); box-shadow: 0 5px 0 var(--filet); }
  .carte-precision .libelle { margin-top: 6px; font-family: var(--police-titre); font-weight: 600; font-size: 16px; color: var(--ivoire); }
  .carte-precision .petit { font-size: 13px; color: var(--violet-fonce); }
  .carnet { align-self: stretch; margin-top: 18px; padding: 18px 20px; border-radius: var(--rayon); border: 2px solid var(--bord); }
  .carnet-tete { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .carnet-titre { font-family: var(--police-titre); font-weight: 700; font-size: 19px; }
  .carnet-compte { font-size: 14px; color: var(--gris-legende); }
  .tampons { display: flex; gap: 10px; margin: 14px 0 0; padding: 0; list-style: none; }
  .carnet-suite { margin: 16px 0 0; font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--gris-legende); }
  .carnet-suite + .tampons { margin-top: 8px; }
  .tampons li { flex: 1; max-width: 72px; display: flex; flex-direction: column; align-items: center; justify-content: center;
    aspect-ratio: 1 / 1; border-radius: 50%; font-family: var(--police-titre); font-weight: 700; font-size: 18px; line-height: 1.05;
    border: 2px dashed #DCE0E8; color: var(--gris-legende); }
  .tampons .mini { font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; opacity: .8; }
  .tampons :global(li.fait) { border: 3px solid var(--violet); color: var(--violet-fonce); background: #FFFFFF; transform: rotate(-8deg); }
  .tampons :global(li.vient) { border: 3px solid var(--violet); color: #FFFFFF; background: var(--violet);
    transform: rotate(-8deg); box-shadow: 0 0 0 4px var(--filet); }
  .tampons :global(li.prochain) { border: 2px dashed var(--filet); color: var(--violet); background: var(--panneau-2); }
  .actions { align-self: stretch; display: flex; flex-wrap: wrap; gap: 14px; margin-top: 22px; }
  .b-principal { flex: 1 1 260px; min-height: 62px; display: flex; align-items: center; justify-content: center;
    padding: 0 22px; border: 0; border-radius: var(--rayon); background: var(--violet); color: #fff; box-shadow: 0 6px 0 var(--violet-fonce);
    font-family: var(--police-titre); font-weight: 600; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase;
    text-decoration: none; cursor: pointer; }
  .b-principal:hover { color: #fff; background: var(--violet-fonce); }
  .b-principal[hidden] { display: none; }
  .b-second { flex: 0 1 220px; min-height: 62px; display: flex; align-items: center; justify-content: center; padding: 0 18px;
    border: 2px solid var(--bord); border-radius: var(--rayon); background: var(--fond); box-shadow: 0 4px 0 var(--bord);
    font-family: var(--police-titre); font-weight: 600; font-size: 16px; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--violet-fonce); text-decoration: none; }
  @media (max-width: 640px) { .b-second { flex: 1 1 100%; } }
</style>
