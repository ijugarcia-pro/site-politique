---
// Le quiz d'entrée (frames V5 « Question », « Révélation », « Résultat », « Partage ») : les 10
// votes choisis par Julien (data/quiz.json). Pour chacun : la question, « Concrètement », Pour /
// Contre / Je ne sais pas, puis la révélation du vote réel. À la fin : le groupe qui vote le plus
// comme toi, ton jumeau, la précision, et trois stories à partager. Tout est calculé dans le
// navigateur ; les réponses y restent (lib/navigateur.ts).
import Base from '../layouts/Base.astro';
import { composition, lienVote, questionsQuiz, scrutin } from '../lib/donnees.ts';
import { HAUTEUR, LARGEUR, places, RAYON_SIEGE } from '../lib/hemicycle.ts';
import { TEINTES, SANS_VOTE_COMMUN } from '../lib/profil.ts';
import { verdict } from '../lib/votes.ts';

const LETTRES: Record<string, string> = { pour: 'P', contre: 'C', abstention: 'A',
  non_votant: 'N', absent: '-' };
const questions = questionsQuiz().map((q) => {
  const s = scrutin(q.uid);
  return {
    ...q, question: q.question.replace(/ ([?!:;])/g, '\u202f$1'),
    lien: lienVote(s), verdict: verdict(s), decompte: s.decompte,
    dissidents: s.dissidents, marge: s.voix_pour_inverser,
    sieges: s.sieges.map((x) => (x.vacant ? 'V' : LETTRES[x.vote ?? 'absent'] ?? '-')).join(''),
  };
});
const compo = composition();
const deputesCompo = compo.sieges.map((s) => s.depute ?? '');
const liste = places();
const donnees = JSON.stringify({ questions, deputes: deputesCompo }).replace(/</g, '\\u003c');
---
<Base titre="Le quiz d'entrée" focus
  description="Prends le 578e siège : 10 vrais votes de l'Assemblée, puis le groupe et le député qui votent le plus comme toi.">
  <div class="progression" slot="entete">
    <div class="barre" role="progressbar" aria-label="Progression du quiz" aria-valuemin="0"
      aria-valuemax={questions.length} aria-valuenow="0" data-barre>
      <span data-barre-pleine></span>
    </div>
    <span class="compteur" data-compteur>Question 1 sur {questions.length}</span>
    <a class="quitter" href="/explorer/">Explorer tous les votes</a>
  </div>

  <div class="quiz" data-quiz>
    <section class="gauche" aria-live="polite">
      <div class="question" data-ecran="question">
        <div class="bulle" data-bulle>
          <span class="robot" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28"><rect x="6" y="12" width="16" height="9" rx="3" fill="#fff"></rect><rect x="9" y="5" width="10" height="8" rx="3" fill="#fff"></rect><rect x="8" y="20" width="3" height="5" rx="1.5" fill="#fff"></rect><rect x="17" y="20" width="3" height="5" rx="1.5" fill="#fff"></rect></svg>
          </span>
          <p>
            Il reste un siège libre à l'Assemblée : <strong>le tien</strong>. Réponds à
            {questions.length} vrais votes, on te montre quels députés ont voté comme toi. Tu
            peux toujours répondre « Je ne sais pas » ; tes réponses restent dans ton navigateur.
          </p>
        </div>
        <span class="puce" data-theme></span>
        <h1 data-question tabindex="-1"></h1>
        <p class="concretement"><strong>Concrètement :</strong> <span data-concretement></span></p>
        <div class="choix">
          <button type="button" class="b-pour" data-reponse="pour">Pour</button>
          <button type="button" class="b-contre" data-reponse="contre">Contre</button>
        </div>
        <button type="button" class="b-passer" data-reponse="">Je ne sais pas</button>
        <p class="lien-vote"><a data-lien-vote href="/explorer/">Tout savoir sur ce vote</a></p>
      </div>

      <div class="resultat" data-ecran="resultat" hidden>
        <span class="puce" data-sur-titre-resultat></span>
        <h1 tabindex="-1" data-titre-resultat>Ta place est prête&nbsp;!</h1>
        <p class="phrase" data-phrase-groupe></p>
        <a class="jumeau" data-jumeau hidden>
          <span class="avatar" data-jumeau-ini></span>
          <span class="jumeau-texte">
            <span class="sur-titre">Ton jumeau à l'Assemblée</span>
            <span class="jumeau-nom" data-jumeau-nom></span>
            <span class="jumeau-detail" data-jumeau-detail></span>
          </span>
          <span class="jumeau-score">
            <span data-jumeau-score></span>
            <span class="petit">votes comme toi</span>
          </span>
        </a>
        <ul class="groupes" data-groupes aria-label="Les groupes qui votent le plus comme toi"></ul>
        <div class="precision">
          <span class="precision-titre">Précision</span>
          <span class="segments" data-segments aria-hidden="true">
            {Array.from({ length: 10 }, () => <span></span>)}
          </span>
          <span class="precision-pct" data-precision></span>
        </div>
        <p class="note" data-note-precision></p>
        <div class="actions">
          <a class="b-principal" href="/hemicycle/">
            <span>Voir mon hémicycle →</span>
            <span class="petit">Groupes, jumeau, opposé : tout le détail</span>
          </a>
          <button type="button" class="b-partager" data-ouvrir-partage>Partager</button>
        </div>
        <p class="recommencer">
          <button type="button" data-recommencer>Recommencer le quiz</button>
          · <a href="/explorer/">Trancher d'autres votes</a> pour affiner ton résultat
        </p>
      </div>
    </section>

    <section class="panneau" aria-labelledby="titre-panneau">
      <div class="panneau-tete">
        <div>
          <h2 id="titre-panneau" data-panneau-titre>L'Assemblée nationale</h2>
          <p data-panneau-sous>577 sièges. Le 578<sup>e</sup> est libre.</p>
        </div>
      </div>
      <div class="dessin">
        <svg viewBox={`0 -60 ${LARGEUR} ${HAUTEUR + 60}`} role="img" data-svg
          aria-label="Hémicycle de l'Assemblée nationale">
          {liste.map((p, i) => (
            <circle data-i={i} cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r={RAYON_SIEGE}
              fill={compo.sieges[i].vacant ? '#FFFFFF' : '#D6DBE4'}></circle>
          ))}
          <g data-libre>
            <circle cx="500" cy="-26" r="16" fill="none" stroke="#B9A4FF" stroke-width="3" stroke-dasharray="5 4"></circle>
          </g>
          <g data-etoile hidden>
            <path d="M17 2l4.4 9.2 10 1.3-7.3 7 1.9 10L17 24.6 8 29.5l1.9-10-7.3-7 10-1.3z"
              fill="#FFC531" stroke="#1F2433" stroke-width="2" stroke-linejoin="round"></path>
          </g>
          <text x="500" y="440" text-anchor="middle" class="centre-chiffres" data-centre></text>
          <text x="500" y="478" text-anchor="middle" class="centre-legende" data-centre-legende></text>
        </svg>
      </div>
      <ul class="legende" data-legende-vote hidden>
        <li><span style="background: var(--pour)"></span>Pour</li>
        <li><span style="background: var(--contre)"></span>Contre</li>
        <li><span style="background: var(--abstention)"></span>Abstention</li>
        <li><span style="background: var(--non-votant)"></span>Non-votant</li>
        <li><span style="background: var(--absent)"></span>Absent</li>
      </ul>
      <ul class="legende" data-legende-accord hidden>
        {TEINTES.map((t) => <li><span style={`background: ${t.couleur}`}></span>{t.libelle}</li>)}
        <li><span style={`background: ${SANS_VOTE_COMMUN}`}></span>Aucun vote en commun</li>
      </ul>
    </section>
  </div>

  <div class="revelation" data-revelation hidden>
    <div class="revelation-dedans">
      <div class="revelation-texte">
        <p class="revelation-titre" data-rv-titre></p>
        <p data-rv-ligne></p>
      </div>
      <div class="ta-voix">
        <p class="sur-titre">Ta voix de 578<sup>e</sup></p>
        <p data-rv-voix></p>
      </div>
      <button type="button" class="b-continuer" data-continuer>Continuer</button>
    </div>
  </div>

  <dialog class="partage" data-partage aria-labelledby="titre-partage">
    <div class="partage-tete">
      <h2 id="titre-partage">Montre ta place</h2>
      <button type="button" class="fermer" data-fermer aria-label="Fermer">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <p>Trois stories prêtes pour Instagram ou Snapchat. Elles ne contiennent que ce que tu vois ici.</p>
    <div class="stories" data-stories>
      <figure><img alt="Story « J'ai pris le 578e siège »" data-story="place" /><figcaption><button type="button" data-envoyer="place">Partager</button></figcaption></figure>
      <figure><img alt="Story « Mon jumeau à l'Assemblée »" data-story="jumeau" /><figcaption><button type="button" data-envoyer="jumeau">Partager</button></figcaption></figure>
      <figure><img alt="Story « Mon vote le plus à contre-courant »" data-story="contre" /><figcaption><button type="button" data-envoyer="contre">Partager</button></figcaption></figure>
    </div>
  </dialog>

  <script type="application/json" data-donnees-quiz set:html={donnees}></script>
</Base>

<script>
  import { lireJSON, repondre, reponses as mesReponses } from '../lib/navigateur.ts';
  import { initiales, partCommeToi, profil, teinte, type Matrice,
    type Reponse } from '../lib/profil.ts';
  import { dessiner, enImage, type DonneesStories, type TypeStory } from '../lib/stories.ts';
  import { places } from '../lib/hemicycle.ts';

  interface Question {
    uid: string; numero: number; theme: string; question: string; concretement: string;
    lien: string; verdict: string; dissidents: number; marge: number | null; sieges: string;
    decompte: { pour: number; contre: number; abstention: number };
  }
  const { questions, deputes } = JSON.parse(
    document.querySelector('[data-donnees-quiz]')!.textContent!) as
    { questions: Question[]; deputes: string[] };
  const CLE = '578e.quiz.v1';
  const COULEURS: Record<string, string> = { P: '#2F7BFF', C: '#FF6A3D', A: '#FFC531',
    N: '#9AA1B2', '-': '#DFE3EB', V: '#FFFFFF' };
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const cercles = [...document.querySelectorAll<SVGCircleElement>('[data-svg] circle[data-i]')];
  const liste = places();
  const etat = lireJSON<{ i: number; fini: boolean }>(CLE, { i: 0, fini: false });
  let matrice: Matrice | null = null;
  const chargement = fetch('/donnees/matrice.json').then((r) => r.json())
    .then((m: Matrice) => { matrice = m; return m; });

  const sauver = () => { try { localStorage.setItem(CLE, JSON.stringify(etat)); } catch { /* */ } };
  const montrer = (ecran: string) => {
    for (const e of document.querySelectorAll<HTMLElement>('[data-ecran]')) {
      e.hidden = e.dataset.ecran !== ecran;
    }
  };
  const progression = (n: number) => {
    const barre = $('[data-barre]');
    barre.setAttribute('aria-valuenow', String(n));
    $('[data-barre-pleine]').style.width = `${(100 * n) / questions.length}%`;
  };
  const etoileSur = (indice: number) => {
    const g = $<SVGGElement>('[data-etoile]');
    if (indice < 0) { g.setAttribute('hidden', ''); return; }
    const p = liste[indice];
    g.setAttribute('transform', `translate(${(p.x - 17).toFixed(1)} ${(p.y - 52).toFixed(1)})`);
    g.removeAttribute('hidden');
  };

  // --- Une question ---
  const poser = (i: number) => {
    const q = questions[i];
    montrer('question');
    $('[data-revelation]').hidden = true;
    $('[data-bulle]').hidden = i > 0;
    $('[data-theme]').textContent = q.theme;
    $('[data-question]').textContent = q.question;
    $('[data-concretement]').textContent = q.concretement;
    $<HTMLAnchorElement>('[data-lien-vote]').href = q.lien;
    $('[data-compteur]').textContent = `Question ${i + 1} sur ${questions.length}`;
    progression(i);
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-reponse]')) {
      b.disabled = false;
      b.removeAttribute('aria-pressed');
    }
    // L'hémicycle attend ton vote : gris, le 578e siège libre.
    cercles.forEach((c, k) => c.setAttribute('fill', q.sieges[k] === 'V' ? '#FFFFFF' : '#D6DBE4'));
    $('[data-libre]').removeAttribute('hidden');
    etoileSur(-1);
    $('[data-panneau-titre]').textContent = "Qu'a voté l'Assemblée ?";
    $('[data-panneau-sous]').textContent = 'Réponds pour le découvrir.';
    $('[data-centre]').textContent = '?';
    $('[data-centre-legende]').textContent = '';
    $('[data-legende-vote]').hidden = true;
    $('[data-legende-accord]').hidden = true;
    if (i > 0) $('[data-question]').focus();
  };

  // --- La révélation du vote réel ---
  const reveler = (i: number, v: Reponse | null) => {
    const q = questions[i];
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-reponse]')) {
      b.disabled = true;
      if ((b.dataset.reponse || null) === v) b.setAttribute('aria-pressed', 'true');
    }
    cercles.forEach((c, k) => c.setAttribute('fill', COULEURS[q.sieges[k]] ?? '#DFE3EB'));
    $('[data-libre]').setAttribute('hidden', '');
    const d = q.decompte;
    $('[data-panneau-titre]').textContent = 'Comment l\'Assemblée a voté';
    $('[data-panneau-sous]').textContent = `Scrutin n° ${q.numero}`;
    $('[data-centre]').textContent = `${d.pour} – ${d.contre}`;
    $('[data-centre-legende]').textContent = 'pour – contre';
    $('[data-legende-vote]').hidden = false;
    const exprimes = d.pour + d.contre;
    const part = v && exprimes ? Math.round((100 * (v === 'pour' ? d.pour : d.contre)) / exprimes) : null;
    $('[data-rv-titre]').textContent = `${q.verdict} · ${d.pour} pour, ${d.contre} contre`;
    $('[data-rv-ligne]').textContent = (part === null
      ? `${exprimes ? Math.round((100 * d.pour) / exprimes) : 0} % des députés qui se sont exprimés ont voté pour.`
      : `${part} % des députés qui se sont exprimés ont voté comme toi.`)
      + (q.dissidents ? ` ${q.dissidents} député${q.dissidents > 1 ? 's ont' : ' a'} voté contre leur propre groupe.` : '');
    $('[data-rv-voix]').textContent = v
      ? `Avec ta voix : ${d.pour + (v === 'pour' ? 1 : 0)} pour, ${d.contre + (v === 'contre' ? 1 : 0)} contre.`
        + (q.marge && q.marge > 1 ? ` Le résultat s'est joué à ${q.marge} voix.` : '')
      : 'Tu n\'as pas tranché : ce vote ne compte pas dans ton résultat.';
    $('[data-revelation]').hidden = false;
    $('[data-continuer]').textContent = i + 1 < questions.length ? 'Continuer' : 'Voir ma place';
    $('[data-continuer]').focus({ preventScroll: true });
    if (window.matchMedia('(max-width: 1000px)').matches) {
      document.querySelector('.panneau')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  };

  // --- Le résultat ---
  const resultat = async () => {
    etat.fini = true;
    sauver();
    montrer('resultat');
    $('[data-revelation]').hidden = true;
    progression(questions.length);
    $('[data-compteur]').textContent = 'Terminé';
    const m = matrice ?? await chargement;
    const reps = Object.fromEntries(Object.entries(mesReponses()).map(([k, r]) => [k, r.v]));
    const p = profil(m, reps);
    const dansQuiz = questions.filter((q) => reps[q.uid]).length;
    $('[data-sur-titre-resultat]').textContent = `${dansQuiz} vote${dansQuiz > 1 ? 's' : ''} sur `
      + `${questions.length} tranché${dansQuiz > 1 ? 's' : ''}`
      + (p.reponses > dansQuiz ? ` · ${p.reponses} en tout` : '');
    const g = p.groupes[0];
    if (!g) {
      $('[data-titre-resultat]').textContent = 'Pas encore de place';
      $('[data-phrase-groupe]').textContent = 'Tu n\'as tranché aucun vote : réponds « Pour » ou « Contre » à au moins une question pour voir qui vote comme toi.';
    } else {
      $('[data-titre-resultat]').textContent = 'Ta place est prête !';
      $('[data-phrase-groupe]').innerHTML = '';
      const b = document.createElement('strong');
      b.textContent = `${g.ligne.libelle} (${g.ligne.sigle})`;
      $('[data-phrase-groupe]').append('Le groupe qui vote le plus comme toi : ', b,
        `, d'accord avec toi sur ${g.identiques} vote${g.identiques > 1 ? 's' : ''} sur ${g.communs}.`);
    }
    const j = p.jumeau;
    const carte = $<HTMLAnchorElement>('[data-jumeau]');
    if (j) {
      carte.hidden = false;
      carte.href = `/deputes/${j.ligne.u}/`;
      $('[data-jumeau-ini]').textContent = initiales(j.ligne.n);
      $('[data-jumeau-nom]').textContent = j.ligne.n;
      const sigle = m.groupes.find((x) => x.u === j.ligne.g)?.sigle ?? 'non inscrit';
      $('[data-jumeau-detail]').textContent = `${sigle} · ${j.communs} vote${j.communs > 1 ? 's' : ''} en commun`;
      $('[data-jumeau-score]').textContent = `${j.identiques}/${j.communs}`;
    } else {
      carte.hidden = true;
    }
    const ul = $('[data-groupes]');
    ul.replaceChildren(...p.groupes.slice(0, 3).map((x) => {
      const li = document.createElement('li');
      const s = document.createElement('span');
      s.className = 'sigle';
      s.textContent = x.ligne.sigle;
      s.title = x.ligne.libelle;
      const barre = document.createElement('span');
      barre.className = 'jauge';
      const plein = document.createElement('span');
      plein.style.width = `${x.taux ?? 0}%`;
      barre.append(plein);
      const pct = document.createElement('span');
      pct.className = 'pct';
      pct.textContent = `${x.taux} %`;
      li.append(s, barre, pct);
      return li;
    }));
    const prec = Math.round(100 * p.precision);
    $('[data-precision]').textContent = `${prec} %`;
    document.querySelectorAll<HTMLElement>('[data-segments] span').forEach((s, k) => {
      s.classList.toggle('plein', k < Math.round(p.precision * 10));
    });
    $('[data-note-precision]').textContent = `Calculé sur ${p.reponses} vote${p.reponses > 1 ? 's' : ''}. `
      + 'Plus tu tranches de votes, plus ton résultat est fiable : il le devient vers 25 votes.';
    // L'hémicycle se colore : plus un siège est foncé, plus ce député vote comme toi.
    const parDepute = new Map(p.deputes.map((x) => [x.ligne.u, x.lisse]));
    const couleurs = deputes.map((u) => (u ? teinte(parDepute.get(u) ?? null) : '#FFFFFF'));
    cercles.forEach((c, k) => c.setAttribute('fill', couleurs[k]));
    $('[data-libre]').setAttribute('hidden', '');
    const siegeJumeau = j ? deputes.indexOf(j.ligne.u) : -1;
    etoileSur(siegeJumeau);
    $('[data-panneau-titre]').textContent = 'Ton hémicycle';
    $('[data-panneau-sous]').textContent = j ? 'L\'étoile : ta place, près de ton jumeau.' : 'Tranche des votes pour te placer.';
    const proches = p.deputes.filter((x) => (x.taux ?? 0) >= 50).length;
    $('[data-centre]').textContent = String(proches);
    $('[data-centre-legende]').textContent = 'votent souvent comme toi';
    $('[data-legende-vote]').hidden = true;
    $('[data-legende-accord]').hidden = false;
    $('[data-titre-resultat]').focus();
    // Les stories, prêtes à partager.
    let contre: DonneesStories['contre'] = null;
    for (const q of questions) {
      const r = reps[q.uid];
      const k = m.votes.indexOf(q.uid);
      if (!r || k < 0) continue;
      const part = partCommeToi(m, k, r);
      if (part !== null && (!contre || part < contre.part)) contre = { question: q.question, reponse: r, part };
    }
    stories = {
      groupe: g ? { sigle: g.ligne.sigle, libelle: g.ligne.libelle } : null,
      jumeau: j ? { nom: j.ligne.n, initiales: initiales(j.ligne.n), identiques: j.identiques,
        communs: j.communs, groupe: m.groupes.find((x) => x.u === j.ligne.g)?.sigle ?? 'non inscrit' } : null,
      contre, sieges: couleurs, etoile: siegeJumeau, votes: p.reponses,
    };
  };

  // --- Partage ---
  let stories: DonneesStories | null = null;
  const images = new Map<TypeStory, Blob>();
  const dialogue = $<HTMLDialogElement>('[data-partage]');
  $('[data-ouvrir-partage]').addEventListener('click', async () => {
    if (!stories) return;
    dialogue.showModal();
    for (const type of ['place', 'jumeau', 'contre'] as TypeStory[]) {
      const blob = await enImage(await dessiner(type, stories));
      images.set(type, blob);
      $<HTMLImageElement>(`[data-story="${type}"]`).src = URL.createObjectURL(blob);
    }
  });
  $('[data-fermer]').addEventListener('click', () => dialogue.close());
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-envoyer]')) {
    b.addEventListener('click', async () => {
      const type = b.dataset.envoyer as TypeStory;
      const blob = images.get(type);
      if (!blob) return;
      const fichier = new File([blob], `578e-siege-${type}.png`, { type: 'image/png' });
      if (navigator.canShare?.({ files: [fichier] })) {
        try { await navigator.share({ files: [fichier], title: 'Le 578e siège' }); return; } catch { /* annulé */ }
      }
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = fichier.name;
      a.click();
    });
  }

  // --- Déroulé ---
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-reponse]')) {
    b.addEventListener('click', () => {
      const q = questions[etat.i];
      const v = (b.dataset.reponse || null) as Reponse | null;
      if (v) repondre(q.uid, v);
      else repondre(q.uid, null);
      reveler(etat.i, v);
    });
  }
  $('[data-continuer]').addEventListener('click', () => {
    etat.i += 1;
    sauver();
    if (etat.i >= questions.length) resultat();
    else poser(etat.i);
  });
  $('[data-recommencer]').addEventListener('click', () => {
    etat.i = 0;
    etat.fini = false;
    sauver();
    poser(0);
