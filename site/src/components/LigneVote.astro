---
// Un vote dans une liste (Explorer, accueil) : étiquette, titre officiel, date, barre pour /
// contre et verdict. Toute la ligne mène à la page du vote.
import { dateLisible, lienVote, majuscule, type ResumeScrutin } from '../lib/donnees.ts';
import { FAMILLES, famille, normaliser, verdict } from '../lib/votes.ts';

interface Props {
  vote: ResumeScrutin;
  /** Ce que la ligne met en avant à droite : le verdict (par défaut), les votes contre leur
   *  groupe, ou la marge. */
  accent?: 'verdict' | 'dissidents' | 'marge';
  niveau?: 'h2' | 'h3';
}

const { vote: v, accent = 'verdict', niveau = 'h3' } = Astro.props;
const Titre = niveau;
const f = famille(v);
const d = v.decompte;
const recherche = normaliser(`${v.titre} ${v.dossier ?? ''} ${v.numero}`);
---
<li class="ligne" data-uid={v.uid} data-famille={f} data-solennel={v.solennel ? '1' : undefined}
  data-recherche={recherche}>
  <a href={lienVote(v)}>
    <span class="haut">
      <span class:list={['etiquette', `e-${f}`, { solennel: v.solennel }]}>
        {v.solennel && f !== 'censure' ? 'Solennel' : FAMILLES[f]}
      </span>
      <span class="date">{dateLisible(v.date)}</span>
      <span class="tranche" data-tranche hidden></span>
    </span>
    <Titre class="titre">{majuscule(v.titre).replace(/\.$/, '')}</Titre>
    <span class="bas">
      {v.motion_censure ? (
        <span class="mini mini-censure" aria-hidden="true">
          <span style={`width: ${(100 * d.pour) / (v.requis ?? 289)}%`}></span>
        </span>
      ) : (
        <span class="mini" aria-hidden="true">
          {d.pour > 0 && <span class="m-pour" style={`flex: ${d.pour}`}></span>}
          {d.contre > 0 && <span class="m-contre" style={`flex: ${d.contre}`}></span>}
          {d.abstention > 0 && <span class="m-abstention" style={`flex: ${d.abstention}`}></span>}
        </span>
      )}
      {accent === 'dissidents' ? (
        <span class="accent violet">{v.dissidents} contre leur groupe</span>
      ) : accent === 'marge' && v.voix_pour_inverser ? (
        <span class="accent violet">à {v.voix_pour_inverser} voix près</span>
      ) : (
        <span class="accent sombre">
          <span class="mot">{verdict(v)}</span>
          <span class="score">{v.motion_censure ? `${d.pour} / ${v.requis}` : `${d.pour}–${d.contre}`}</span>
        </span>
      )}
    </span>
  </a>
</li>

<style>
  /* Un vote dans une liste (DESIGN-FINAL.md, § 6) : étiquette et date en puce de régie, intitulé
     en Literata, verdict en capitales (le même pour les deux issues), barre de totaux aux
     couleurs des votes, segments séparés de 2 px. */
  .ligne { border-top: 1px solid var(--filet); }
  .ligne a {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr) 132px 168px;
    grid-template-areas: 'haut titre mini accent';
    gap: 6px 16px;
    align-items: center;
    min-height: 64px;
    padding: 12px 10px;
    color: inherit;
    text-decoration: none;
  }
  .ligne a:hover { background: var(--panneau-2); }
  .ligne a:hover .titre { text-decoration: underline; text-underline-offset: 3px; }
  .haut { grid-area: haut; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  .bas { display: contents; }
  .etiquette {
    padding: 5px 7px;
    background: var(--panneau-2);
    border: 1px solid var(--filet);
    color: var(--ivoire-2);
    font: 600 12px/1 var(--police-titre);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  /* Un vote solennel : l'étiquette rouge de régie. */
  .etiquette.solennel { background: var(--direct); border-color: var(--direct); color: var(--sur-direct); }
  .date { font: 600 13px/16px var(--police-titre); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ivoire-2); }
  /* Ta réponse, quand tu as déjà tranché ce vote (remplie dans le navigateur, Explorer) : une
     puce ivoire, la lumière restant à ta place dans la salle. */
  .tranche { color: var(--ivoire);
    font: 600 12px/1.2 var(--police-titre); letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap; }
  .titre {
    grid-area: titre;
    margin: 0;
    font: 500 16px/1.4 var(--police-question);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .mini {
    grid-area: mini;
    display: flex;
    gap: 2px;
    height: 6px;
    overflow: hidden;
  }
  .m-pour { background: var(--pour); }
  .m-contre { background: var(--contre); }
  .m-abstention { background: var(--abstention); }
  .mini-censure { background: var(--absent); }
  .mini-censure span { background: var(--pour); }
  .accent {
    grid-area: accent;
    justify-self: end;
    display: flex;
    align-items: baseline;
    gap: 8px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .mot { font: 700 17px/1 var(--police-titre); text-transform: uppercase; color: var(--ivoire); }
  .score, .violet { font: 600 13px/16px var(--police-titre); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ivoire-2); }
  @media (max-width: 760px) {
    .ligne a {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'haut haut' 'titre titre' 'mini accent';
      gap: 8px 12px;
      padding: 12px 6px;
    }
    .haut { flex-direction: row; align-items: center; gap: 10px; }
  }
</style>
