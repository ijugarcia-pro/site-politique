---
// Trouver ton député (VDEF, capture 16 ; lot V8) : le code postal mène à la circonscription ;
// quand il en couvre plusieurs, le visiteur choisit la sienne (boutons radio), ou, s'il ne sait
// pas laquelle, situe son adresse. « C'est ma circonscription » garde le député dans le
// navigateur (578e.depute.v1). Puis la recherche par nom parmi les 577, et les groupes, qui
// s'allument dans la salle. Le code postal reste dans le navigateur (fragment #cp=, jamais envoyé
// au serveur) ; seule une adresse à préciser est envoyée au service public de géocodage de l'IGN,
// au moment où le visiteur la demande.
import Base from '../../layouts/Base.astro';
import Bouton from '../../components/vdef/Bouton.astro';
import Pastille from '../../components/vdef/Pastille.astro';
import { composition, deputes, lienDepute, nomComplet } from '../../lib/donnees.ts';
import { libelleCirco } from '../../lib/geo.ts';
import { normaliser } from '../../lib/votes.ts';

const tous = deputes();
const enExercice = tous.filter((d) => d.en_exercice);
const groupes = composition().groupes.filter((g) => g.membres > 0).sort((a, b) => b.membres - a.membres);
---
<Base titre="Trouver ton député" gabarit="lecture" vue="tribune" bas="galerie"
  description="Qui te représente à l'Assemblée nationale ? Retrouve ton député avec ton code postal, et les 577 députés de la 17e législature.">
  <a class="retour" href="/">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
    La tribune
  </a>
  <header class="entete">
    <span class="t-etiquette">Ton député</span>
    <h1 class="t-ecran">Qui te représente ?</h1>
    <p class="t-texte">Ton code postal suffit. Ton choix reste dans ton navigateur.</p>
  </header>

  <form class="cp" data-form-cp-local>
    <label for="cp" class="champ-libelle">Code postal</label>
    <div class="cp-ligne">
      <input id="cp" name="cp" class="champ" inputmode="numeric" pattern="[0-9]{5}" maxlength="5"
        autocomplete="postal-code" required />
      <Bouton type="submit">Trouver</Bouton>
    </div>
  </form>
  <div class="resultat" data-resultat aria-live="polite" hidden></div>

  <section class="annuaire-bloc" aria-labelledby="titre-annuaire">
    <h2 id="titre-annuaire" class="t-section">Ou parcours les {enExercice.length}</h2>
    <label class="recherche">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
      <span class="visuellement-cache">Chercher un député par son nom, son groupe ou son département</span>
      <input type="search" data-recherche-depute placeholder="Le nom d’un député" autocomplete="off" />
    </label>
    <div class="groupes">
      {groupes.map((g) => <Pastille href={`/salle/#groupe=${g.uid}`} class="pastille-groupe">{g.libelle} · {g.membres}</Pastille>)}
    </div>
    <p class="t-legende">Un groupe choisi s’allume dans la salle.</p>
    <div class="outils">
      <span class="t-legende" aria-live="polite" data-compte-deputes></span>
      <label class="anciens t-legende"><input type="checkbox" data-anciens /> Aussi les {tous.length - enExercice.length} anciens députés de la législature</label>
      <button type="button" class="tout-voir" data-tout-voir>Voir les {enExercice.length} députés</button>
    </div>
    <ul class="annuaire" data-annuaire hidden>
      {tous.map((d) => (
        <li data-uid={d.uid} data-circo={d.circo} data-en-exercice={d.en_exercice ? '1' : undefined}
          data-recherche={normaliser(`${nomComplet(d)} ${d.sigle ?? ''} ${d.groupe_libelle ?? ''} ${d.departement} ${d.num_departement}`)}
          data-nom={nomComplet(d)} data-groupe={d.groupe_libelle ?? ''} data-civ={d.civilite ?? ''}
          data-libelle={`${libelleCirco(d.circo)} · ${d.departement}`} hidden={!d.en_exercice}>
          <a href={lienDepute(d)}>
            <span class="a-nom">{nomComplet(d)}</span>
            <span class="t-legende">{d.groupe_libelle ?? 'Sans groupe'} · {libelleCirco(d.circo)} · {d.departement}{!d.en_exercice && ' · mandat terminé'}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="t-texte" data-vide-annuaire hidden>Aucun député ne correspond.</p>
  </section>
</Base>

<script>
  import { choisirDepute, deputeChoisi } from '../../lib/navigateur.ts';
  import { circoDuPoint, codePostalValide, conclure, conclureCommune, departementDe,
    libelleCirco, prefixe, type Commune, type Geometrie, type Issue } from '../../lib/geo.ts';
  import { normaliser } from '../../lib/votes.ts';

  const GEOCODAGE = 'https://data.geopf.fr/geocodage/search';

  document.addEventListener('astro:page-load', () => {
    const zone = document.querySelector<HTMLElement>('[data-resultat]');
    const champ = document.querySelector<HTMLInputElement>('#cp');
    if (!zone || !champ) return;
    const fiches = [...document.querySelectorAll<HTMLElement>('[data-annuaire] > li')];
    let cpCourant = '';

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, texte = '', classe = '') => {
      const e = document.createElement(tag);
      if (texte) e.textContent = texte;
      if (classe) e.className = classe;
      return e;
    };
    const afficher = (...enfants: Node[]) => { zone.hidden = false; zone.replaceChildren(...enfants); };
    const json = async <T,>(url: string): Promise<T | null> => {
      try { const r = await fetch(url); return r.ok ? ((await r.json()) as T) : null; } catch { return null; }
    };
    const deputeDe = (circo: string) => fiches.find((f) => f.dataset.circo === circo && f.dataset.enExercice === '1');
    const lieu = (circo: string) => `${libelleCirco(circo)}${circo.startsWith('099') ? ' des Français de l’étranger' : ''}`;

    /** La carte d'une circonscription (radio) : son député, son groupe. */
    const carte = (circo: string, nom: string, coche: boolean) => {
      const li = deputeDe(circo);
      const label = el('label', '', 'circo');
      const radio = el('input');
      radio.type = 'radio';
      radio.name = 'circo';
      radio.value = circo;
      radio.checked = coche;
      radio.className = 'visuellement-cache';
      const texte = el('span', '', 'circo-texte');
      texte.append(el('span', `${lieu(circo)}${nom ? ` · ${nom}` : ''}`, 'circo-lieu'),
        el('span', li?.dataset.nom ?? 'Siège vacant', 'circo-nom'),
        el('span', li ? li.dataset.groupe || 'Sans groupe' : 'La circonscription n’a pas de député en ce moment.', 'circo-groupe'));
      label.append(radio, texte);
      return label;
    };
    /** Le choix d'une circonscription parmi `candidates`, et « C'est ma circonscription ». */
    const choisir = (candidates: string[], intro: string, commune: string) => {
      const form = el('form', '', 'choix-circo');
      const fieldset = el('fieldset');
      const legende = el('legend', intro, 't-texte');
      const grille = el('div', '', 'circos');
      const mien = deputeChoisi();
      const deja = candidates.find((c) => deputeDe(c)?.dataset.uid === mien) ?? candidates[0];
      for (const c of candidates) grille.append(carte(c, '', c === deja));
      fieldset.append(legende, grille);
      const actions = el('div', '', 'actions');
      const ok = el('button', candidates.length > 1 ? 'C’est ma circonscription' : 'C’est mon député', 'bouton-plein');
      ok.type = 'submit';
      actions.append(ok);
      const sortie = el('p', '', 't-texte confirme');
      if (candidates.length > 1) {
        const nsp = el('button', 'Je ne sais pas laquelle', 'bouton-contour');
        nsp.type = 'button';
        nsp.addEventListener('click', () => demanderAdresse(candidates, commune));
        actions.append(nsp);
      }
      form.append(fieldset, actions, sortie);
      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const circo = new FormData(form).get('circo') as string;
        const li = deputeDe(circo);
        if (!li) { sortie.textContent = 'Cette circonscription n’a pas de député en ce moment.'; return; }
        choisirDepute(li.dataset.uid!);
        const elle = li.dataset.civ === 'Mme';
        const a = el('a', 'Voir sa fiche');
        a.setAttribute('href', `/deputes/${li.dataset.uid}/`);
        sortie.replaceChildren(`C’est noté : ${li.dataset.nom} est ${elle ? 'ta députée' : 'ton député'}. `, a);
      });
      afficher(form);
    };

    // Situer une adresse : géocodage public (IGN), puis contours des circonscriptions.
    const demanderAdresse = (candidates: string[], commune: string) => {
      const form = el('form', '', 'adresse');
      const intro = el('p', `Indique ta rue à ${commune} pour trouver ta circonscription :`, 't-texte');
      const ligne = el('div', '', 'cp-ligne');
      const label = el('label', 'Numéro et rue', 'visuellement-cache');
      label.setAttribute('for', 'adresse');
      const input = el('input', '', 'champ');
      input.id = 'adresse';
      input.placeholder = 'Numéro et rue';
      input.autocomplete = 'address-line1';
      input.required = true;
      const bouton = el('button', 'Situer', 'bouton-plein');
      bouton.type = 'submit';
      ligne.append(label, input, bouton);
      const note = el('p', 'Ton adresse est envoyée au service public de géocodage de l’IGN pour la situer ; le site ne la garde pas.', 't-legende');
      const sortie = el('div');
      form.append(intro, ligne, note, sortie);
      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        sortie.replaceChildren(el('p', 'Recherche de l’adresse…', 't-legende'));
        const url = `${GEOCODAGE}?index=address&limit=1&q=${encodeURIComponent(input.value)}&postcode=${cpCourant}`;
        const r = await json<{ features: { geometry: { coordinates: [number, number] }; properties: { label: string; score: number } }[] }>(url);
        const f = r?.features?.[0];
        if (!f || f.properties.score < 0.4) {
          sortie.replaceChildren(el('p', r ? 'Adresse introuvable dans ce code postal : vérifie le numéro et la rue.' : 'Le service de géocodage ne répond pas. Réessaie, ou choisis toi-même.', 't-texte'));
          return;
        }
        let trouvee: string | null = null;
        for (const dep of [...new Set(candidates.map(departementDe))]) {
          const contours = await json<Record<string, Geometrie>>(`/donnees/contours/${dep}.json`);
          if (contours) trouvee = circoDuPoint(contours, f.geometry.coordinates, candidates) ?? circoDuPoint(contours, f.geometry.coordinates);
          if (trouvee) break;
        }
        if (!trouvee) { sortie.replaceChildren(el('p', 'Impossible de situer cette adresse dans une circonscription. Choisis toi-même.', 't-texte')); return; }
        choisir([trouvee], `Adresse retenue : ${f.properties.label}.`, commune);
      });
      afficher(form);
      input.focus();
    };

    const suivre = (issue: Issue, commune = '') => {
      if (issue.type === 'inconnu') {
        afficher(el('p', 'Ce code postal n’existe pas dans la base de La Poste. Vérifie-le.', 't-texte'));
      } else if (issue.type === 'trouve') {
        choisir([issue.circo], `${cpCourant}${commune ? ` · ${commune}` : ''} : ta circonscription.`, commune);
      } else if (issue.type === 'adresse') {
        const n = issue.candidates.length;
        if (n > 12) demanderAdresse(issue.candidates, commune || 'ta commune');
        else choisir(issue.candidates, `${cpCourant}${commune ? ` · ${commune}` : ''} est partagé entre ${n} circonscriptions. Laquelle est la tienne ?`, commune || 'ta commune');
      } else {
        const liste = el('div', '', 'communes');
        for (const c of issue.communes) {
          const b = el('button', c.n, 'bouton-contour');
          b.type = 'button';
          b.addEventListener('click', () => suivre(conclureCommune(c), c.n));
          liste.append(b);
        }
        afficher(el('p', 'Ce code postal couvre plusieurs communes. Laquelle est la tienne ?', 't-texte'), liste);
        liste.querySelector('button')?.focus();
      }
    };

    const chercher = async (cp: string) => {
      if (!codePostalValide(cp)) { afficher(el('p', 'Un code postal compte 5 chiffres.', 't-texte')); return; }
      cpCourant = cp;
      history.replaceState(null, '', `#cp=${cp}`);
      afficher(el('p', 'Recherche…', 't-legende'));
      const fichier = await json<Record<string, Commune[]>>(`/donnees/cp/${prefixe(cp)}.json`);
      if (!fichier) { afficher(el('p', 'La recherche par code postal est indisponible pour le moment. Cherche ton député par son nom ci-dessous.', 't-texte')); return; }
      const communes = fichier[cp];
      suivre(conclure(communes), communes?.[0]?.n);
    };
    document.querySelector('[data-form-cp-local]')!.addEventListener('submit', (ev) => { ev.preventDefault(); void chercher(champ.value.trim()); });
    // Au chargement (#cp= ou ?cp=), et quand le fragment change.
    const depuisAdresse = () => {
      const cp = new URLSearchParams(location.hash.slice(1)).get('cp') ?? new URLSearchParams(location.search).get('cp');
      if (!cp || cp === cpCourant) return;
      champ.value = cp;
      if (location.search) history.replaceState(null, '', `${location.pathname}#cp=${cp}`);
      void chercher(cp);
    };
    window.addEventListener('hashchange', depuisAdresse);
    depuisAdresse();

    // L'annuaire : caché tant qu'on ne cherche pas ; recherche par nom, groupe ou département.
    const annuaire = document.querySelector<HTMLElement>('[data-annuaire]')!;
    const recherche = document.querySelector<HTMLInputElement>('[data-recherche-depute]')!;
    const anciens = document.querySelector<HTMLInputElement>('[data-anciens]')!;
    const compte = document.querySelector<HTMLElement>('[data-compte-deputes]')!;
    const vide = document.querySelector<HTMLElement>('[data-vide-annuaire]')!;
    const toutVoir = document.querySelector<HTMLButtonElement>('[data-tout-voir]')!;
    let ouvert = false;
    const filtrer = () => {
      const mots = normaliser(recherche.value).split(' ').filter(Boolean);
      annuaire.hidden = !ouvert && !mots.length;
      let n = 0;
      for (const f of fiches) {
        const ok = (anciens.checked || f.dataset.enExercice === '1') && mots.every((m) => (f.dataset.recherche ?? '').includes(m));
        f.hidden = !ok;
        if (ok) n += 1;
      }
      compte.textContent = annuaire.hidden ? '' : `${n} député${n > 1 ? 's' : ''}`;
      vide.hidden = annuaire.hidden || n > 0;
      toutVoir.hidden = ouvert;
    };
    recherche.addEventListener('input', filtrer);
    anciens.addEventListener('change', () => { ouvert = true; filtrer(); });
    toutVoir.addEventListener('click', () => { ouvert = true; filtrer(); annuaire.querySelector('a')?.focus(); });
    filtrer();
  });
</script>

<style>
  .entete { display: flex; flex-direction: column; gap: 8px; }
  .champ-libelle { font: 600 14px/1.3 var(--police-texte); }
  .cp { display: flex; flex-direction: column; gap: 8px; }
  .cp-ligne, .resultat :global(.cp-ligne) { display: flex; gap: 8px; align-items: center; }
  .champ, .resultat :global(.champ) {
    flex: 1; min-width: 0; min-height: 60px; padding: 0 22px; border: 0; border-radius: var(--pilule);
    background: var(--surface); color: var(--encre); font: 500 20px/1 var(--police-texte);
  }
  .champ:focus, .resultat :global(.champ:focus) { outline: 2px solid var(--encre); }
  .resultat { display: flex; flex-direction: column; gap: 14px; }
  .resultat :global(fieldset) { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .resultat :global(.circos) { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 10px; }
  .resultat :global(.circo) { display: block; cursor: pointer; }
  .resultat :global(.circo-texte) {
    display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border-radius: 18px;
    background: var(--surface); box-shadow: inset 0 0 0 2px transparent;
  }
  .resultat :global(.circo input:checked + .circo-texte) { background: var(--feuille); box-shadow: inset 0 0 0 2px var(--encre); }
  .resultat :global(.circo input:focus-visible + .circo-texte) { outline: 3px solid var(--encre); outline-offset: 2px; }
  .resultat :global(.circo-lieu) { font: 500 13px/1.3 var(--police-texte); color: var(--texte-2); }
  .resultat :global(.circo-nom) { font: 700 24px/1.15 var(--police-titre); }
  .resultat :global(.circo-groupe) { font: 600 14px/1.3 var(--police-texte); }
  .resultat :global(.actions), .resultat :global(.communes) { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .resultat :global(.bouton-plein), .resultat :global(.bouton-contour) {
    min-height: 52px; padding: 0 24px; border-radius: var(--pilule); cursor: pointer; font: 700 16px/1 var(--police-texte);
  }
  .resultat :global(.bouton-plein) { border: 0; background: var(--encre); color: var(--feuille); }
  .resultat :global(.bouton-contour) { border: 1px solid var(--bord); background: var(--feuille); color: var(--encre); }
  .resultat :global(.confirme a) { color: var(--encre); font-weight: 700; }
  .annuaire-bloc { display: flex; flex-direction: column; gap: 12px; padding-top: 24px; border-top: 1px solid var(--filet); }
  .recherche {
    display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 0 20px;
    border-radius: var(--pilule); background: var(--surface); color: var(--texte-2);
  }
  .recherche:focus-within { box-shadow: inset 0 0 0 2px var(--encre); }
  .recherche input { flex: 1; min-width: 0; border: 0; outline: none; background: transparent; font: 500 17px/1 var(--police-texte); color: var(--encre); }
  .groupes { display: flex; flex-wrap: wrap; gap: 8px; }
  .groupes :global(.pastille-groupe) { min-height: 36px; padding: 0 12px; font-size: 13px; }
  .outils { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
  .anciens { display: inline-flex; align-items: center; gap: 8px; min-height: var(--cible); }
  .tout-voir { border: 0; background: none; color: var(--encre); font: 600 14px/1 var(--police-texte); text-decoration: underline; cursor: pointer; min-height: var(--cible); }
  .annuaire { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0 20px; }
  .annuaire li { border-top: 1px solid var(--filet); }
  .annuaire a { display: flex; flex-direction: column; gap: 4px; padding: 12px 0; color: var(--encre); text-decoration: none; }
  .annuaire a:hover .a-nom { text-decoration: underline; }
  .a-nom { font: 600 15px/1.3 var(--police-texte); }
</style>
