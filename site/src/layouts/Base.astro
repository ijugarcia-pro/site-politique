---
// Mise en page commune : en-tête de régie avec les 3 onglets (Cette semaine · Mon hémicycle ·
// Explorer), contenu, pied de page avec les sources. Charte « La Séance »
// (docs/refonte-la-seance.md). Polices servies par le site (aucun appel à Google).
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource-variable/literata/opsz.css';
import '../styles/global.css';
import '../styles/motion.css';
import { scrutins, semaine } from '../lib/donnees.ts';

interface Props {
  titre: string;
  description: string;
  onglet?: 'semaine' | 'hemicycle' | 'explorer';
  /** Mode focus (quiz, séance) : pas d'onglets ; l'en-tête reçoit le contenu du slot
   *  « entete » (barre de progression…). */
  focus?: boolean;
  /** Données structurées schema.org de la page (JSON-LD), pour les moteurs de recherche. */
  jsonld?: Record<string, unknown>;
  /** « seance » (sombre : la salle, le vote, le verdict) ou « jour » (lecture longue). Pendant
   *  la refonte, une page garde « jour » tant que ses styles n'ont pas été repris (lots 2 à 4). */
  theme?: 'seance' | 'jour';
  /** La page s'ouvre sur une scène plein cadre (slot « scene ») : l'en-tête se pose dessus, sur
   *  un voile, et le reste de la page suit en pleine largeur (DESIGN-FINAL.md, § 5.1). */
  scene?: boolean;
}

const { titre, description, onglet, focus = false, jsonld, theme = 'jour', scene = false } = Astro.props;
const canonique = new URL(Astro.url.pathname, Astro.site).href;
const ONGLETS = [
  { id: 'semaine', href: '/', label: 'Cette semaine', icone: 'M3 5h14v12H3zM3 9h14M7 3v4M13 3v4' },
  { id: 'hemicycle', href: '/hemicycle/', label: 'Mon hémicycle',
    icone: 'M2 16a8 8 0 0 1 16 0M6 16a4 4 0 0 1 8 0' },
  { id: 'explorer', href: '/explorer/', label: 'Explorer',
    icone: 'M9 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12zM13.5 13.5L18 18' },
];
const titreComplet = titre === 'Le 578e siège' ? titre : `${titre} · Le 578e siège`;
// La précision compte les réponses aux votes de la matrice : tous les votes à page, sauf les
// motions de censure (lib/profil.ts).
const horsMatrice = JSON.stringify(scrutins().filter((s) => s.motion_censure).map((s) => s.uid));
// Les votes de séance devenus scrutins (t24) : la réponse donnée avant le vote rejoint les
// autres réponses du visiteur, sur n'importe quelle page.
const sem = semaine();
const tranches = JSON.stringify({
  ...Object.fromEntries(sem.historique.map((h) => [h.lundi, h.tranches ?? {}])),
  [sem.lundi]: Object.fromEntries(sem.votes.filter((v) => v.type === 'annonce' && v.scrutin)
    .map((v) => [v.cle, v.scrutin!.uid])),
});
---
<!doctype html>
<html lang="fr" class={`theme-${theme}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Le 578e siège" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta name="twitter:card" content="summary" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld).replace(/</g, '\\u003c')}></script>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class:list={[{ focus }]}>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <header class:list={['entete', 'theme-seance', { focus, 'sur-scene': scene && !focus }]}>
      <a class="logo" href="/" aria-label="Le 578e siège, accueil">
        <svg width="46" height="28" viewBox="0 0 160 96" aria-hidden="true">
          <path d="M 22 70 A 58 58 0 0 1 138 70 L 116 70 A 36 36 0 0 0 44 70 Z" fill="#F2EEE6"></path>
          <rect x="0" y="76" width="160" height="12" fill="#B3132F"></rect>
          <circle cx="80" cy="56" r="8" fill="#F2C98A"></circle>
        </svg>
        <span>Le 578<sup>e</sup> siège</span>
      </a>
      {focus ? <slot name="entete" /> : (
      <>
      <nav aria-label="Navigation principale">
        <ul>
          {ONGLETS.map((o) => (
            <li>
              <a href={o.href} aria-current={o.id === onglet ? 'page' : undefined}
                aria-label={o.label}>
                <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                  <path d={o.icone} fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span class="texte-onglet">{o.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="outils">
        <span class="mention">Site indépendant, non officiel</span>
        <a class="rond" href="/explorer/#recherche" aria-label="Rechercher un vote ou un député">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <path d="M12.5 12.5l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </a>
        <a class="anneau-precision" href="/hemicycle/" data-precision-entete hidden
          title="Précision de ton hémicycle : plus tu tranches de votes, plus elle monte">
          <span data-precision-entete-pct></span>
        </a>
      </div>
      </>
      )}
    </header>
    {scene ? (
    <main id="contenu" class="avec-scene">
      <slot name="scene" />
      <div class="page sous-scene"><slot /></div>
    </main>
    ) : (
    <main id="contenu" class:list={['page', { focus }]}>
      <slot />
    </main>
    )}
    {focus ? (
    <footer class="pied-focus" data-pied-focus>
      <span>Votes issus des données ouvertes de l'Assemblée nationale. Tes réponses restent dans ton navigateur.</span>
      <span><a href="/etat/">État des données</a> · <a href="/confidentialite/">Confidentialité</a></span>
    </footer>
    ) : (
    <footer class:list={['pied', { 'sous-scene': scene }]}>
      <p>
        Données : <a href="https://data.assemblee-nationale.fr/">open data de l'Assemblée
        nationale</a> (17<sup>e</sup> législature, Licence ouverte), retraitées chaque
        nuit. <a href="/etat/">État des données</a> · <a href="/calcul/">Comment c'est calculé</a> · <a href="/mentions-legales/">Mentions légales</a> · <a href="/confidentialite/">Confidentialité</a>.
      </p>
      <p>Aucun commentaire politique : seulement des votes réels et leurs décomptes.</p>
    </footer>
    )}
    <script type="application/json" data-hors-matrice set:html={horsMatrice}></script>
    <script type="application/json" data-tranches-seance set:html={tranches}></script>
    <script>
      import { reponses } from '../lib/navigateur.ts';
      import { precision } from '../lib/profil.ts';
      import { reporterReponses } from '../lib/seances.ts';

      reporterReponses(JSON.parse(
        document.querySelector('[data-tranches-seance]')?.textContent ?? '{}') as Record<string, Record<string, string>>);

      // L'anneau de précision de l'en-tête (frame V5) : calculé sur place, comme tout le profil.
      const anneau = document.querySelector<HTMLElement>('[data-precision-entete]');
      if (anneau) {
        const hors = new Set(JSON.parse(
          document.querySelector('[data-hors-matrice]')?.textContent ?? '[]') as string[]);
        const n = Object.keys(reponses()).filter((uid) => !hors.has(uid)).length;
        if (n > 0) {
          const pct = Math.round(100 * precision(n));
          anneau.style.setProperty('--pct', `${pct}%`);
          anneau.querySelector('[data-precision-entete-pct]')!.textContent = `${pct}%`;
          anneau.setAttribute('aria-label', `Précision de ton hémicycle : ${pct} %`);
          anneau.hidden = false;
        }
      }

      // Les formulaires « code postal » mènent à /deputes/#cp=… : le fragment n'est jamais
      // envoyé au serveur. Sans JavaScript, ils passent par ?cp=, que la page efface.
      for (const form of document.querySelectorAll<HTMLFormElement>('form[action="/deputes/"]')) {
        form.addEventListener('submit', (ev) => {
          ev.preventDefault();
          const cp = String(new FormData(form).get('cp') ?? '').trim();
          location.href = `/deputes/#cp=${encodeURIComponent(cp)}`;
        });
      }
    </script>
  </body>
</html>

<style>
  .evitement {
    position: absolute;
    left: 12px;
    top: -60px;
    padding: 10px 16px;
    background: var(--direct);
    color: var(--sur-direct);
    font: 600 15px/1 var(--police-titre);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    z-index: 30;
  }
  .evitement:focus { top: 12px; }

  /* L'en-tête de régie : toujours sombre (classe theme-seance), quel que soit le thème de la page. */
  .entete {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 36px;
    padding: 14px var(--gouttiere);
    background: var(--nuit);
    color: var(--ivoire);
    border-bottom: 1px solid var(--filet);
  }
  .logo {
    flex: none;
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ivoire);
    font: 700 22px/1 var(--police-titre);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .logo:hover { color: var(--ivoire); }
  .logo sup { font-size: 12px; }
  /* Posé sur la scène plein cadre : un voile, sans filet (maquette V6C-01). */
  .entete.sur-scene { position: absolute; left: 0; right: 0; padding: 16px 32px; background: var(--voile); border-bottom: 0; }
  nav ul { display: flex; gap: 28px; margin: 0; padding: 0; list-style: none; }
  nav a {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 0;
    border-bottom: 2px solid transparent;
    font: 600 15px/1 var(--police-titre);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ivoire-2);
    text-decoration: none;
  }
  nav a svg { display: none; }
  nav a:hover { color: var(--ivoire); }
  nav a[aria-current='page'] { color: var(--ivoire); border-bottom-color: var(--direct); }
  .outils { flex: none; display: flex; align-items: center; gap: 18px; margin-left: auto; }
  .mention {
    font: 600 13px/16px var(--police-titre);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ivoire-2);
  }
  .rond {
    display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: 50%;
    border: 1px solid var(--filet); color: var(--ivoire-2);
  }
  .rond:hover { color: var(--ivoire); border-color: var(--ivoire-2); }
  /* L'anneau de précision : ta précision, en lumière (elle te désigne). */
  .anneau-precision {
    display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: 50%;
    background: conic-gradient(var(--lumiere) 0 var(--pct, 0%), var(--filet) var(--pct, 0%) 100%);
    text-decoration: none; color: var(--ivoire);
  }
  .anneau-precision span {
    display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 50%; background: var(--nuit);
    font: 600 11px/1 var(--police-titre); font-variant-numeric: tabular-nums;
  }
  @media (max-width: 1000px) {
    .mention { display: none; }
  }
  /* Téléphone : la navigation passe en bas de l'écran, en barre de régie. */
  @media (max-width: 640px) {
    .entete, .entete.sur-scene { gap: 12px; padding: 12px 16px; }
    .logo { font-size: 19px; }
    /* La navigation fixée en bas, sans icônes (maquettes V6C-05 et V6C-06). */
    nav {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
      background: var(--nuit); border-top: 1px solid var(--filet);
      padding: 0 0 env(safe-area-inset-bottom);
    }
    nav ul { gap: 0; justify-content: space-around; }
    nav li { flex: 1; }
    nav a { justify-content: center; min-height: 56px; padding: 6px 4px;
      font-size: 13px; letter-spacing: 0.12em; text-align: center;
      border-bottom: 0; border-top: 2px solid transparent; }
    nav a[aria-current='page'] { border-top-color: var(--direct); }
    .rond, .anneau-precision { width: 44px; height: 44px; }
    .anneau-precision span { width: 36px; height: 36px; font-size: 12px; }
    .outils { gap: 10px; }
    body:not(.focus) { padding-bottom: calc(60px + env(safe-area-inset-bottom)); }
  }

  /* Mode focus (quiz, lots, séance) : pas d'onglets ; l'en-tête reçoit la progression. */
  body.focus { min-height: 100vh; display: flex; flex-direction: column; }
  .entete.focus { position: static; gap: 16px 32px; }
  .pied-focus { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; width: 100%;
    max-width: 1320px; margin: 0 auto; padding: 18px var(--gouttiere) 28px;
    font: 400 13px/1.5 var(--police-texte); color: var(--ivoire-2); }
  .pied-focus a { color: inherit; }

  .pied {
    max-width: 1320px;
    margin: 0 auto;
    padding: 24px var(--gouttiere) 40px;
    border-top: 1px solid var(--filet);
    color: var(--ivoire-2);
    font: 400 14px/1.6 var(--police-texte);
  }
  .pied p { margin: 0 0 6px; }
  .pied a { color: inherit; }
  /* Sous une scène : une ligne de légende, les sources à gauche, la neutralité à droite (V6C-01). */
  .pied.sous-scene { max-width: none; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 32px;
    padding: 24px 32px 32px; border-top: 0; font: 400 13px/1.5 var(--police-texte); }
  .pied.sous-scene p { margin: 0; }
  .pied.sous-scene p:first-child { flex: 1 1 520px; max-width: 900px; }
  /* Une page à scène : la salle bord à bord, puis les sections en pleine largeur, gouttière de 32 px. */
  .avec-scene { display: block; }
  .page.sous-scene { max-width: none; padding: 40px 32px 24px; }
  @media (max-width: 640px) {
    .page.sous-scene { padding: 24px 16px 16px; }
    .pied.sous-scene { padding: 20px 16px 28px; }
  }
</style>
