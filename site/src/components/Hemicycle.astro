---
// L'hémicycle : 577 sièges, groupes dans l'ordre de leurs places (pipeline/export_site.py),
// dessiné au build en SVG. Deux modes :
// - « vote » : chaque siège prend la couleur de son vote ; les votes contre leur groupe sont
//   cerclés ;
// - « composition » : les groupes en deux gris alternés, sans couleur partisane.
// Accessibilité : un résumé et le détail par groupe dans un tableau ; au clavier, la zone se
// parcourt avec les flèches (← → siège, ↑ ↓ groupe, Début, Fin) et chaque siège est annoncé.
import { etiquette, HAUTEUR, LARGEUR, places, RAYON_SIEGE, SIEGES } from '../lib/hemicycle.ts';
import { LIBELLES, type Groupe, type Position, type Siege } from '../lib/donnees.ts';

interface Props {
  sieges: Siege[];
  groupes: Groupe[];
  mode: 'vote' | 'composition';
  titre: string;
  etiquettes?: boolean;
}

const { sieges, groupes, mode, titre, etiquettes = true } = Astro.props;
if (sieges.length !== SIEGES) {
  throw new Error(`Hémicycle « ${titre} » : ${sieges.length} sièges au lieu de ${SIEGES}`);
}

const liste = places();
const rang = new Map(groupes.map((g, i) => [g.uid, i]));
const sigle = new Map(groupes.map((g) => [g.uid, g.sigle]));
const COULEURS: Record<Position, string> = {
  pour: 'var(--pour)', contre: 'var(--contre)', abstention: 'var(--abstention)',
  absent: 'var(--absent)', non_votant: 'var(--non-votant)',
};
const GRIS = ['#B9C0CE', '#D6DBE4'];

function remplissage(s: Siege): string {
  if (s.vacant) return '#FFFFFF';
  if (mode === 'vote' && s.vote) return COULEURS[s.vote];
  return GRIS[(rang.get(s.groupe ?? '') ?? 0) % 2];
}

// Étendue de chaque groupe (ses sièges sont contigus) pour placer son étiquette. Les petits
// groupes voisins sont décalés vers l'extérieur un sur deux pour ne pas se chevaucher.
const etendues = groupes.map((g) => {
  const indices = sieges.flatMap((s, i) => (s.groupe === g.uid ? [i] : []));
  return { g, debut: indices[0], fin: indices[indices.length - 1] };
}).filter((e) => e.debut !== undefined);
let decale = false;
const libelles = etendues.map(({ g, debut, fin }) => {
  const arc = (liste[fin].angle - liste[debut].angle + Math.PI / SIEGES) * 460;
  const etroit = arc < g.sigle.length * 8.4;
  decale = etroit ? !decale : false;
  return { texte: g.sigle, ...etiquette(liste, debut, fin, decale ? 20 : 0) };
});

// Ce que la zone annonce pour chaque siège : [texte, indice du groupe].
const annonces = sieges.map((s, i) => {
  const numero = `Siège ${i + 1} sur ${SIEGES}`;
  if (s.vacant) return [`${numero} : vacant`, -1];
  const morceaux = [`${numero} : ${s.nom}`, sigle.get(s.groupe ?? '') ?? ''];
  if (mode === 'vote' && s.vote) {
    morceaux.push(LIBELLES[s.vote]);
    if (s.dissident) morceaux.push('vote contraire à la majorité de son groupe');
    if (s.mise_au_point) {
      morceaux.push(`mise au point : ${LIBELLES[s.mise_au_point as Position] ?? s.mise_au_point}`);
    }
  }
  return [morceaux.join(' · '), rang.get(s.groupe ?? '') ?? -1];
});

const decompte = (cle: Position) => sieges.filter((s) => s.vote === cle).length;
const occupes = sieges.filter((s) => !s.vacant).length;
const dissidents = sieges.filter((s) => s.dissident).length;
const nombre = (n: number, mot: string) => `${n} ${mot}${n > 1 ? 's' : ''}`;
const resume = mode === 'vote'
  ? `${decompte('pour')} pour, ${decompte('contre')} contre, `
    + `${nombre(decompte('abstention'), 'abstention')}, `
    + `${nombre(decompte('non_votant'), 'non-votant')}, ${nombre(decompte('absent'), 'absent')}`
    + (dissidents ? `, dont ${nombre(dissidents, 'vote')} contre la majorité du groupe` : '')
  : `${occupes} députés en exercice dans ${groupes.length} groupes`
    + (SIEGES - occupes ? `, ${nombre(SIEGES - occupes, 'siège')} vacant${SIEGES - occupes > 1 ? 's' : ''}` : '');
---
<figure class="hemicycle" data-hemicycle>
  <div
    class="zone"
    tabindex="0"
    role="application"
    aria-roledescription="hémicycle"
    aria-label={`${titre}. ${resume}. Flèches gauche et droite : siège par siège ; haut et bas : groupe par groupe.`}
  >
    <svg viewBox={`0 -24 ${LARGEUR} ${HAUTEUR + 24}`} aria-hidden="true">
      {etiquettes && (
        <g class="etiquettes">
          {libelles.map((l) => (
            <text x={l.x.toFixed(1)} y={l.y.toFixed(1)}
              transform={`rotate(${l.rotation.toFixed(1)} ${l.x.toFixed(1)} ${l.y.toFixed(1)})`}
              text-anchor="middle" dominant-baseline="middle">{l.texte}</text>
          ))}
        </g>
      )}
      <g class="sieges">
        {sieges.map((s, i) => (
          <>
            {s.dissident && mode === 'vote' && (
              <circle class="cercle-dissident" cx={liste[i].x.toFixed(1)} cy={liste[i].y.toFixed(1)}
                r={(RAYON_SIEGE + 2.6).toFixed(1)}></circle>
            )}
            <circle
              class:list={['siege', { vacant: s.vacant }]}
              data-i={i}
              cx={liste[i].x.toFixed(1)}
              cy={liste[i].y.toFixed(1)}
              r={s.dissident && mode === 'vote' ? RAYON_SIEGE - 1 : RAYON_SIEGE}
              fill={remplissage(s)}
            ></circle>
          </>
        ))}
      </g>
      <circle class="curseur" r={RAYON_SIEGE + 5} cx="-50" cy="-50"></circle>
      <g class="centre">
        {mode === 'vote' ? (
          <>
            <text x="500" y="440" text-anchor="middle" class="centre-chiffres">
              {decompte('pour')} – {decompte('contre')}
            </text>
            <text x="500" y="478" text-anchor="middle" class="centre-legende">pour – contre</text>
          </>
        ) : (
          <>
            <text x="500" y="440" text-anchor="middle" class="centre-chiffres">{SIEGES}</text>
            <text x="500" y="478" text-anchor="middle" class="centre-legende">sièges</text>
          </>
        )}
      </g>
    </svg>
  </div>
  <p class="info" aria-live="polite">
    Survole ou touche un siège, ou sélectionne l'hémicycle et utilise les flèches du clavier.
  </p>
  {mode === 'vote' ? (
    <ul class="legende" aria-label="Légende">
      <li><span style="background: var(--pour)"></span>Pour</li>
      <li><span style="background: var(--contre)"></span>Contre</li>
      <li><span style="background: var(--abstention)"></span>Abstention</li>
      <li><span style="background: var(--non-votant)"></span>Non-votant</li>
      <li><span style="background: var(--absent)"></span>Absent</li>
      <li><span class="anneau"></span>Contre la majorité de son groupe</li>
    </ul>
  ) : (
    <ul class="legende groupes" aria-label="Groupes, de gauche à droite">
      {groupes.map((g, i) => (
        <li><span style={`background: ${GRIS[i % 2]}`}></span><abbr title={g.libelle}>{g.sigle}</abbr> {g.membres}</li>
      ))}
      {SIEGES - occupes > 0 && <li><span class="vide"></span>Vacants {SIEGES - occupes}</li>}
    </ul>
  )}
  <details class="detail">
    <summary>Le détail groupe par groupe</summary>
    <div class="tableau">
      <table>
        <caption class="visuellement-cache">{titre} : détail par groupe</caption>
        <thead>
          <tr>
            <th scope="col">Groupe</th>
            <th scope="col" class="nombre">Sièges</th>
            {mode === 'vote' && (
              <>
                <th scope="col" class="nombre">Pour</th>
                <th scope="col" class="nombre">Contre</th>
                <th scope="col" class="nombre">Abst.</th>
                <th scope="col" class="nombre">Non-votants</th>
                <th scope="col" class="nombre">Absents</th>
                <th scope="col" class="nombre">Contre son groupe</th>
              </>
            )}
          </tr>
        </thead>
        <tbody>
          {groupes.map((g) => (
            <tr>
              <th scope="row"><abbr title={g.libelle}>{g.sigle}</abbr></th>
              <td class="nombre">{g.membres}</td>
              {mode === 'vote' && g.decompte && (
                <>
                  <td class="nombre">{g.decompte.pour}</td>
                  <td class="nombre">{g.decompte.contre}</td>
                  <td class="nombre">{g.decompte.abstention}</td>
                  <td class="nombre">{g.decompte.non_votant}</td>
                  <td class="nombre">{g.decompte.absent}</td>
                  <td class="nombre">{g.non_inscrits ? '—' : g.dissidents}</td>
                </>
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {mode === 'vote' && (
      <p class="note">
        « Contre son groupe » : vote pour quand la majorité du groupe a voté contre, ou
        l'inverse. C'est notre calcul, pas une mention officielle de l'Assemblée ; il se
        vérifie avec le décompte du groupe. Jamais pour les non-inscrits ; une abstention n'en
        est pas un.
      </p>
    )}
  </details>
  <script type="application/json" data-annonces set:html={JSON.stringify(annonces).replace(/</g, '\\u003c')}></script>
</figure>

<script>
  // Parcours au clavier et au survol. Sans JavaScript, le dessin, le résumé et le tableau
  // restent complets.
  for (const figure of document.querySelectorAll<HTMLElement>('[data-hemicycle]')) {
    const zone = figure.querySelector<HTMLElement>('.zone')!;
    const info = figure.querySelector<HTMLElement>('.info')!;
    const curseur = figure.querySelector<SVGCircleElement>('.curseur')!;
    const sieges = [...figure.querySelectorAll<SVGCircleElement>('circle.siege')];
    const annonces: [string, number][] = JSON.parse(
      figure.querySelector('[data-annonces]')!.textContent ?? '[]');
    let actuel = -1;

    const montrer = (i: number) => {
      actuel = Math.max(0, Math.min(sieges.length - 1, i));
      const s = sieges[actuel];
      curseur.setAttribute('cx', s.getAttribute('cx')!);
      curseur.setAttribute('cy', s.getAttribute('cy')!);
      curseur.classList.add('visible');
      info.textContent = annonces[actuel][0];
    };
    const groupeSuivant = (sens: 1 | -1) => {
      const g = annonces[Math.max(actuel, 0)][1];
      let i = Math.max(actuel, 0);
      while (i >= 0 && i < annonces.length && annonces[i][1] === g) i += sens;
      if (sens === -1 && i >= 0) {
        const precedent = annonces[i][1];
        while (i > 0 && annonces[i - 1][1] === precedent) i--;
      }
      montrer(i);
    };

    zone.addEventListener('keydown', (e) => {
      const touches: Record<string, () => void> = {
        ArrowRight: () => montrer(actuel + 1),
        ArrowLeft: () => montrer(actuel - 1),
        ArrowDown: () => groupeSuivant(1),
        ArrowUp: () => groupeSuivant(-1),
        Home: () => montrer(0),
        End: () => montrer(sieges.length - 1),
      };
      const action = touches[e.key];
      if (action) {
        e.preventDefault();
        action();
      }
    });
    zone.addEventListener('focus', () => { if (actuel < 0) montrer(0); });
    zone.addEventListener('pointerover', (e) => {
      const cible = e.target as Element;
      if (cible instanceof SVGCircleElement && cible.classList.contains('siege')) {
        montrer(Number(cible.dataset.i));
      }
    });
  }
</script>

<style>
  .hemicycle { margin: 0; }
  .zone { border-radius: 16px; touch-action: manipulation; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .etiquettes text {
    font-family: var(--police-titre);
    font-weight: 600;
    font-size: 15px;
    fill: var(--gris-legende);
  }
  .siege { stroke: #FFFFFF; stroke-width: 0.8; cursor: pointer; }
  .siege.vacant { stroke: #9AA1B2; stroke-width: 1.4; stroke-dasharray: 2.5 2; }
  .cercle-dissident { fill: none; stroke: var(--texte); stroke-width: 1.9; }
  .curseur { fill: none; stroke: var(--violet); stroke-width: 3; pointer-events: none;
    visibility: hidden; }
  .curseur.visible { visibility: visible; }
  .centre-chiffres { font-family: var(--police-titre); font-weight: 700; font-size: 44px;
    fill: var(--texte); }
  .centre-legende { font-size: 19px; fill: var(--gris-legende); }
  .info { min-height: 1.6em; margin: 10px 0 0; text-align: center; font-size: 15px;
    color: var(--texte-doux); }
  .legende {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 16px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    color: var(--texte-doux);
  }
  .legende li { display: inline-flex; align-items: center; gap: 6px; }
  .legende span { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
  .legende .anneau { background: #FFFFFF; box-shadow: 0 0 0 2.5px var(--texte); }
  .groupes { font-family: var(--police-titre); font-weight: 600; }
  .legende .vide { background: #FFFFFF; border: 1.5px dashed #9AA1B2; }
  .detail { margin-top: 16px; }
  .detail summary {
    cursor: pointer;
    font-family: var(--police-titre);
    font-weight: 600;
    color: var(--violet-fonce);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .detail .tableau { margin-top: 8px; }
  .note { font-size: 14px; color: var(--gris); margin: 10px 0 0; }
  abbr { text-decoration: none; }
  @media (max-width: 600px) {
    .etiquettes { display: none; }
  }
</style>
