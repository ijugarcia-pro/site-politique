---
// Le quiz d'entrée (frames V5 « ① Première question », « ② Révélation », « ③ Résultat »,
// « ④ Partage ») : les 10 votes choisis par Julien (data/quiz.json). Pour chacun : la question,
// « Concrètement », Pour / Contre / Je ne sais pas, puis la révélation du vote réel. À droite,
// ton hémicycle se construit à chaque réponse. À la fin : ta place, ton jumeau, les groupes les
// plus proches, la précision, et trois stories à partager. Tout est calculé dans le
// navigateur ; les réponses y restent (lib/navigateur.ts).
import Base from '../layouts/Base.astro';
import EnteteSeance from '../components/EnteteSeance.astro';
import JaugePrecision from '../components/JaugePrecision.astro';
import Seance from '../components/Seance.astro';
import { lotsDuParcours, questionsQuiz } from '../lib/donnees.ts';
import { puceTheme } from '../lib/themes.ts';

// La puce de thème : l'étiquette de régie, la même pour chaque question (lib/themes.ts).
const PUCES = [puceTheme('')];
const cartes = questionsQuiz();
// La suite du quiz : les lots du parcours ; les lots facultatifs ne se proposent qu'après eux.
const nLots = lotsDuParcours();
---
<Base titre="Le quiz d'entrée" focus theme="seance"
  description="Prends le 578e siège : 10 vrais votes de l'Assemblée, puis le groupe et le député qui votent le plus comme toi.">
  <EnteteSeance slot="entete" total={cartes.length} libelle="Progression du quiz"
    sortie={{ href: '/explorer/', texte: 'Explorer tous les votes' }} />

  <Seance cartes={cartes} puces={cartes.map((_, k) => PUCES[k % PUCES.length])}>
    <Fragment slot="bulle">
      Il reste un siège libre à l'Assemblée : <strong>le tien</strong>.
      {` Réponds à ${cartes.length} vrais votes, on te montre quels députés ont voté comme toi.`}
    </Fragment>
    <div class="resultat" slot="fin" data-ecran="resultat" hidden>
      <span class="puce-resultat" data-sur-titre-resultat></span>
      <h1 tabindex="-1" data-titre-resultat>Ta place est prête&nbsp;!</h1>
      <p class="phrase" data-phrase-groupe></p>
      <a class="jumeau" data-jumeau hidden>
        <span class="avatar" data-jumeau-ini></span>
        <span class="jumeau-texte">
          <span class="sur-titre">Ton jumeau à l'Assemblée</span>
          <span class="jumeau-nom" data-jumeau-nom></span>
          <span class="jumeau-detail" data-jumeau-detail></span>
        </span>
        <span class="jumeau-score">
          <span data-jumeau-score></span>
          <span class="petit">votes comme toi</span>
        </span>
      </a>
      <ul class="groupes" data-groupes aria-label="Les groupes qui votent le plus comme toi"></ul>
      <div class="precision">
        <span class="precision-titre">Précision</span>
        <JaugePrecision />
      </div>
      <p class="note" data-note-precision></p>
      <div class="actions">
        <a class="b-principal" href="/lots/" data-suite>
          <span data-suite-titre>Continuer →</span>
          <span class="petit" data-suite-detail>3 votes de plus · environ 2 min</span>
        </a>
        <button type="button" class="b-partager" data-ouvrir-partage>
          <svg width="20" height="20" viewBox="0 0 22 22" aria-hidden="true"><rect x="3" y="3" width="16" height="16" rx="5" fill="none" stroke="currentColor" stroke-width="2.2"></rect><circle cx="11" cy="11" r="3.6" fill="none" stroke="currentColor" stroke-width="2.2"></circle><circle cx="15.6" cy="6.4" r="1.2" fill="currentColor"></circle></svg>
          Partager
        </button>
      </div>
      <p class="recommencer">
        <button type="button" data-recommencer>Recommencer le quiz</button>{' · '}<a
          href="/hemicycle/" data-lien-second>Voir mon hémicycle</a>
      </p>
    </div>
  </Seance>

  <dialog class="partage" data-partage aria-labelledby="titre-partage">
    <div class="partage-tete">
      <h2 id="titre-partage">Montre ta place</h2>
      <button type="button" class="fermer" data-fermer aria-label="Fermer">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <p>Trois stories prêtes pour Instagram ou Snapchat. Elles ne contiennent que ce que tu vois ici.</p>
    <div class="stories" data-stories>
      <figure><img alt="Story « J'ai pris le 578e siège »" data-story="place" /><figcaption><button type="button" data-envoyer="place">Partager</button></figcaption></figure>
      <figure><img alt="Story « Mon jumeau à l'Assemblée »" data-story="jumeau" /><figcaption><button type="button" data-envoyer="jumeau">Partager</button></figcaption></figure>
      <figure><img alt="Story « Mon vote le plus à contre-courant »" data-story="contre" /><figcaption><button type="button" data-envoyer="contre">Partager</button></figcaption></figure>
    </div>
  </dialog>

  <script type="application/json" data-lots set:html={String(nLots)}></script>
</Base>

<script>
  import { lireJSON, repondre } from '../lib/navigateur.ts';
  import { etatLots, prochainLot } from '../lib/lots.ts';
  import { colonnes, initiales, niveau, partCommeToi, teinte, VOTES_FIABLES, type Reponse } from '../lib/profil.ts';
  import { jauge } from '../lib/jauge.ts';
  import { $, mesReps, pluriel, seance } from '../lib/seance.ts';
  // Les stories ne se chargent qu'au clic sur « Partager » : le quiz reste léger.
  import type { DonneesStories, TypeStory } from '../lib/stories.ts';
  import { pastille } from '../lib/salle.ts';

  const CLE = '578e.quiz.v1';
  const nLots = Number($('[data-lots]').textContent);
  const s = seance({
    libelleContinuer: (i) => (i + 1 < s.questions.length ? 'Continuer' : 'Voir ma place'),
  });
  const { questions, salle } = s;
  const { groupes, sieges } = salle.reglages;
  const deputes = sieges.map(([u]) => u);
  const etat = lireJSON<{ i: number; fini: boolean }>(CLE, { i: 0, fini: false });
  const sauver = () => { try { localStorage.setItem(CLE, JSON.stringify(etat)); } catch { /* */ } };

  // --- Le résultat ---
  const resultat = async () => {
    etat.fini = true;
    sauver();
    s.finir('resultat');
    const m = s.matrice() ?? await s.chargement;
    const reps = mesReps();
    const p = s.tonHemicycle(m)!;
    s.panneauHemicycle('Plus un siège est lumineux, plus ce député a voté comme toi');
    const dansQuiz = questions.filter((q) => reps[q.uid]).length;
    $('[data-sur-titre-resultat]').textContent = `${dansQuiz} vote${dansQuiz > 1 ? 's' : ''} sur `
      + `${questions.length} · ${p.reponses > dansQuiz ? `${p.reponses} en tout` : 'premier quiz'}`;
    const g = p.groupes.find((x) => !groupes[x.ligne.u]?.ni) ?? null;
    const j = p.jumeau;
    const phrase = $('[data-phrase-groupe]');
    if (!g) {
      $('[data-titre-resultat]').textContent = 'Pas encore de place';
      phrase.textContent = 'Tu n\'as tranché aucun vote : réponds « Pour » ou « Contre » à au moins une question pour voir qui vote comme toi.';
    } else {
      $('[data-titre-resultat]').textContent = 'Ta place est prête !';
      const b = document.createElement('b');
      b.textContent = `côté ${g.ligne.sigle}`;
      b.title = g.ligne.libelle;
      phrase.replaceChildren('Tu siègerais ', b, !j ? '.'
        : niveau(j.lisse).haut ? '. Et parmi les 577, un député vote presque toujours comme toi :'
        : '. Et parmi les 577, le député qui vote le plus souvent comme toi :');
    }
    salle.jumeau(j?.ligne.u ?? null);
    salle.toi(g?.ligne.u ?? null);
    const carte = $<HTMLAnchorElement>('[data-jumeau]');
    if (j) {
      carte.hidden = false;
      carte.href = `/deputes/${j.ligne.u}/`;
      $('[data-jumeau-ini]').textContent = initiales(j.ligne.n);
      $('[data-jumeau-nom]').textContent = j.ligne.n;
      const pg = document.createElement('span');
      pastille(pg, groupes[j.ligne.g ?? '']);
      $('[data-jumeau-detail]').replaceChildren(pg, ` · ${pluriel(j.communs, 'vote')} en commun`);
      $('[data-jumeau-score]').textContent = `${j.identiques}/${j.communs}`;
    } else {
      carte.hidden = true;
    }
    $('[data-groupes]').replaceChildren(...p.groupes.slice(0, 3).map((x) => {
      const li = document.createElement('li');
      const sigle = document.createElement('abbr');
      pastille(sigle, groupes[x.ligne.u]);
      sigle.classList.add('sigle');
      const barre = document.createElement('span');
      barre.className = 'jauge';
      const plein = document.createElement('span');
      plein.style.width = `${x.taux ?? 0}%`;
      barre.append(plein);
      const pct = document.createElement('span');
      pct.className = 'pct';
      pct.textContent = `${x.taux} %`;
      li.append(sigle, barre, pct);
      return li;
    }));
    // La précision gagnée avec le quiz : de tes réponses hors quiz à toutes tes réponses.
    const horsQuiz = { ...reps };
    for (const q of questions) delete horsQuiz[q.uid];
    jauge($('.precision [data-jauge]'), colonnes(m, horsQuiz).length, p.reponses);
    const reste = Math.max(0, VOTES_FIABLES - p.reponses);
    $('[data-note-precision]').textContent = reste
      ? `Fiable à partir de ${VOTES_FIABLES} votes : encore ${reste} à trancher.`
      : `Ton résultat est fiable : ${Math.round(100 * p.precision)} % de précision ; chaque vote l'affine encore.`;
    // La suite (frame ③) : le prochain lot de 3 votes ; ton hémicycle quand les lots sont faits.
    if (prochainLot(etatLots().faits, nLots) === null) {
      $<HTMLAnchorElement>('[data-suite]').href = '/hemicycle/';
      $('[data-suite-titre]').textContent = 'Voir mon hémicycle →';
      $('[data-suite-detail]').textContent = 'Ton jumeau, ton opposé, tous les groupes';
      const second = $<HTMLAnchorElement>('[data-lien-second]');
      second.href = '/explorer/#a-trancher';
      second.textContent = 'Trancher d\'autres votes';
    }
    $('[data-titre-resultat]').focus();
    // Les stories, prêtes à partager.
    const parDepute = new Map(p.deputes.map((x) => [x.ligne.u, x.lisse]));
    const couleurs = deputes.map((u) => (u ? teinte(parDepute.get(u) ?? null) : '#FFFFFF'));
    let contre: DonneesStories['contre'] = null;
    for (const q of questions) {
      const r = reps[q.uid];
      const k = m.votes.indexOf(q.uid);
      if (!r || k < 0) continue;
      const part = partCommeToi(m, k, r);
      if (part !== null && (!contre || part < contre.part)) contre = { question: q.question, reponse: r, part };
    }
    stories = {
      groupe: g ? { sigle: g.ligne.sigle, libelle: g.ligne.libelle } : null,
      jumeau: j ? { nom: j.ligne.n, initiales: initiales(j.ligne.n), identiques: j.identiques,
        communs: j.communs, groupe: groupes[j.ligne.g ?? '']?.s ?? 'non inscrit' } : null,
      contre, sieges: couleurs, etoile: j ? deputes.indexOf(j.ligne.u) : -1, votes: p.reponses,
    };
  };

  // --- Partage ---
  let stories: DonneesStories | null = null;
  const images = new Map<TypeStory, Blob>();
  const dialogue = $<HTMLDialogElement>('[data-partage]');
  $('[data-ouvrir-partage]').addEventListener('click', async () => {
    if (!stories) return;
    dialogue.showModal();
    const { dessiner, enImage } = await import('../lib/stories.ts');
    for (const type of ['place', 'jumeau', 'contre'] as TypeStory[]) {
      const blob = await enImage(await dessiner(type, stories));
      images.set(type, blob);
      $<HTMLImageElement>(`[data-story="${type}"]`).src = URL.createObjectURL(blob);
    }
  });
  $('[data-fermer]').addEventListener('click', () => dialogue.close());
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-envoyer]')) {
    b.addEventListener('click', async () => {
      const type = b.dataset.envoyer as TypeStory;
      const blob = images.get(type);
      if (!blob) return;
      const fichier = new File([blob], `578e-siege-${type}.png`, { type: 'image/png' });
      if (navigator.canShare?.({ files: [fichier] })) {
        try { await navigator.share({ files: [fichier], title: 'Le 578e siège' }); return; } catch { /* annulé */ }
      }
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = fichier.name;
      a.click();
    });
  }

  // --- Déroulé ---
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-reponse]')) {
    b.addEventListener('click', () => {
      const q = questions[etat.i];
      const v = (b.dataset.reponse || null) as Reponse | null;
      repondre(q.uid, v);
      s.reveler(etat.i, v);
    });
  }
  $('[data-continuer]').addEventListener('click', () => {
    etat.i += 1;
    sauver();
    if (etat.i >= questions.length) resultat();
    else s.poser(etat.i);
  });
  $('[data-recommencer]').addEventListener('click', () => {
    etat.i = 0;
    etat.fini = false;
    sauver();
    s.poser(0);
    $('[data-question]').focus();
  });
  if (etat.fini || etat.i >= questions.length) resultat();
  else s.poser(Math.max(0, etat.i));
</script>

<style>
  /* Le résultat du quiz et le partage, en régie ; la question et la révélation sont dans
     components/Seance.astro. Pas de confettis : ils prenaient les couleurs des votes. */
  .sur-titre { font: 600 var(--taille-puce)/16px var(--police-titre); letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--lumiere); }
  .puce-resultat { display: inline-flex; align-items: center; padding: 6px 8px; background: var(--direct);
    color: var(--sur-direct); font: 600 12px/1 var(--police-titre); letter-spacing: 0.12em; text-transform: uppercase; }
  .resultat { position: relative; }
  .resultat h1 { margin: 18px 0 10px; font: 700 clamp(44px, 5vw, 72px)/0.92 var(--police-titre); text-transform: uppercase;
    letter-spacing: -0.005em; outline: none; }
  .phrase { margin: 0 0 18px; font-size: 18px; line-height: 1.5; color: var(--ivoire-2); }
  .phrase b { color: var(--ivoire); }
  /* Ton jumeau : un panneau, son repère en ivoire (la lumière est pour toi). */
  .jumeau { display: flex; align-items: center; gap: 16px; padding: 16px 18px; border-radius: var(--rayon);
    border: 1px solid var(--filet); background: var(--panneau-2); color: inherit; text-decoration: none; }
  .jumeau:hover { border-color: var(--ivoire-2); color: inherit; }
  .avatar { flex: none; display: flex; align-items: center; justify-content: center; width: 56px; height: 56px;
    border-radius: 50%; border: 2px solid var(--ivoire); color: var(--ivoire); font: 600 21px/1 var(--police-titre); }
  .jumeau-texte { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .jumeau-nom { font: 600 24px/1.1 var(--police-titre); text-transform: uppercase; }
  .jumeau-detail { display: flex; align-items: center; flex-wrap: wrap; gap: 0 4px; font-size: 13px; color: var(--ivoire-2); }
  .petit { font-size: 12px; color: var(--ivoire-2); }
  .jumeau-score { flex: none; display: flex; flex-direction: column; align-items: flex-end; font: 600 34px/1 var(--police-titre);
    font-variant-numeric: tabular-nums; color: var(--ivoire); }
  .jumeau-score .petit { margin-top: 3px; font-family: var(--police-texte); font-weight: 400; }
  .groupes { display: flex; flex-direction: column; gap: 10px; margin: 20px 0 0; padding: 0; list-style: none; }
  .groupes :global(li) { display: grid; grid-template-columns: 70px minmax(0, 1fr) 52px; gap: 12px; align-items: center; }
  .groupes :global(.sigle) { font-size: 16px; text-decoration: none; }
  .groupes :global(.jauge) { height: 8px; background: var(--filet); overflow: hidden; }
  .groupes :global(.jauge span) { display: block; height: 100%; background: var(--ivoire-2); }
  .groupes :global(.pct) { text-align: right; font: 600 17px/1 var(--police-titre); font-variant-numeric: tabular-nums; }
  .precision { display: flex; align-items: center; gap: 12px; margin-top: 20px; padding: 12px 16px; background: var(--panneau-2); }
  .precision-titre { font: 600 var(--taille-puce)/16px var(--police-titre); letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ivoire-2); }
  .precision > :global(.jauge-precision) { flex: 1; }
  .note { margin: 6px 0 0; font-size: 14px; color: var(--ivoire-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .b-principal { flex: 1 1 280px; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: center;
    gap: 4px; min-height: 72px; padding: 0 24px; border-radius: var(--rayon); background: var(--direct); color: var(--sur-direct);
    text-decoration: none; font: 600 19px/1 var(--police-titre); letter-spacing: 0.08em; text-transform: uppercase; }
  .b-principal:hover { color: var(--sur-direct); background: #9A0F27; }
  .b-principal .petit { color: var(--sur-direct); opacity: .9; font: 500 14px/1.2 var(--police-texte); text-transform: none;
    letter-spacing: 0; }
  .b-partager { flex: 0 0 170px; display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 72px;
    border: 1px solid var(--ivoire-2); border-radius: var(--rayon); background: transparent; color: var(--ivoire);
    font: 600 16px/1 var(--police-titre); letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }
  .b-partager:hover { background: var(--panneau-2); }
  @media (max-width: 640px) { .b-partager { flex: 1 1 100%; } }
  .recommencer { margin: 16px 0 0; font-size: 15px; color: var(--ivoire-2); }
  .recommencer button { border: 0; background: none; padding: 0; font: inherit; color: var(--ivoire); text-decoration: underline;
    text-underline-offset: 3px; cursor: pointer; }

  .partage { width: min(1000px, calc(100% - 32px)); max-height: calc(100% - 32px); border: 1px solid var(--filet);
    border-radius: var(--rayon); padding: 28px clamp(18px, 3vw, 36px); background: var(--panneau); color: var(--ivoire);
    box-shadow: var(--ombre-panneau); }
  .partage::backdrop { background: rgba(8, 9, 12, 0.74); }
  .partage-tete { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .partage h2 { font: 600 clamp(26px, 3vw, 34px)/1.05 var(--police-titre); text-transform: uppercase; }
  .partage > p { margin: 6px 0 20px; font-size: 17px; color: var(--ivoire-2); }
  .fermer { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid var(--filet); background: transparent; color: var(--ivoire); cursor: pointer; }
  .stories { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .stories figure { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .stories img { width: 100%; aspect-ratio: 9 / 16; border-radius: var(--rayon); background: var(--panneau-2); object-fit: cover; }
  .stories button { width: 100%; min-height: 46px; border: 1px solid var(--ivoire-2); border-radius: var(--rayon); background: transparent;
    font: 600 15px/1 var(--police-titre); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ivoire); cursor: pointer; }
</style>
