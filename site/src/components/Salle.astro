---
// La salle des frames V5 « Mon hémicycle » et « Quiz » : 577 sièges dans le repère de
// lib/hemicycle.ts ; autour de l'arc, la part de chaque groupe bordée et étiquetée de la
// couleur que l'Assemblée lui associe ; les repères (ta place, ton jumeau, le 578e siège libre),
// la carte d'un siège et le chiffre du centre. Les pages colorent les sièges et placent les
// repères avec lib/salle.ts.
import type { Groupe, Siege } from '../lib/donnees.ts';
import { arc, etiquettes, HAUTEUR, LARGEUR, milieu, parts, places, R_EXTERIEUR,
  RAYON_SIEGE } from '../lib/hemicycle.ts';
import { couleurGroupe, encreSur } from '../lib/couleurs.ts';

interface Props {
  sieges: Siege[];
  groupes: Groupe[];
  titre: string;
  /** Sièges à la couleur de leur groupe (sinon gris), avant que la page les colore. */
  couleursGroupes?: boolean;
  /** Le 578e siège, libre, au-dessus de l'arc. */
  libre?: boolean;
  chiffre?: string;
  legende?: string;
}

const { sieges, groupes, titre, couleursGroupes = false, libre = false, chiffre = '',
  legende = '' } = Astro.props;
const liste = places();
const parUid = new Map(groupes.map((g) => [g.uid, g]));
const lesParts = parts(sieges.map((s) => (s.vacant ? null : s.groupe)));
// Au-dessus de l'arc, la place des étiquettes et des repères (la marge de 68 px de la maquette).
const HAUT = 96;
const BOITE = { x: 0, y: -HAUT, l: LARGEUR, h: HAUTEUR + HAUT };
const ou = (x: number, y: number) =>
  `left:${((100 * (x - BOITE.x)) / BOITE.l).toFixed(2)}%;top:${((100 * (y - BOITE.y)) / BOITE.h).toFixed(2)}%`;
const libelles = etiquettes(liste, lesParts,
  (p) => (parUid.get(p.groupe)?.sigle.length ?? 2) * 11 + 22, 30, 8)
  .map((e) => {
    const g = parUid.get(e.part.groupe)!;
    const fond = couleurGroupe(g.couleur);
    return { ...e, g, fond, encre: encreSur(fond) };
  });
const reglages = JSON.stringify({
  boite: BOITE, rayonToi: R_EXTERIEUR + 75,
  centres: Object.fromEntries(lesParts.map((p) => [p.groupe, milieu(liste, p)])),
  groupes: Object.fromEntries(groupes.map((g) => [g.uid,
    { s: g.sigle, l: g.libelle, c: couleurGroupe(g.couleur), ni: g.non_inscrits }])),
  sieges: sieges.map((s) => [s.depute ?? '', s.groupe ?? '']),
}).replace(/</g, '\\u003c');
const occupes = sieges.filter((s) => !s.vacant).length;
---
<div class="dessin" style={`aspect-ratio: ${BOITE.l} / ${BOITE.h}`} data-salle>
  <svg viewBox={`${BOITE.x} ${BOITE.y} ${BOITE.l} ${BOITE.h}`} role="img" data-salle-svg
    aria-label={`${titre} : ${occupes} députés en exercice dans ${groupes.length} groupes`}>
    <g class="arcs">
      {libelles.map((e) => <path d={arc(liste, e.part, R_EXTERIEUR + RAYON_SIEGE + 5)} stroke={e.fond}></path>)}
    </g>
    {liste.map((p, i) => (
      <circle data-i={i} cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r={RAYON_SIEGE}
        class:list={['siege', { vacant: sieges[i].vacant }]}
        style={sieges[i].vacant || !couleursGroupes ? undefined
          : `fill:${couleurGroupe(parUid.get(sieges[i].groupe ?? '')?.couleur)}`}></circle>
    ))}
  </svg>
  {libelles.map((e) => (
    <abbr class="etiquette" title={e.g.libelle}
      style={`${ou(e.x, e.y)};background:${e.fond};color:${e.encre};transform:translate(-50%,-50%) rotate(${e.rotation.toFixed(1)}deg)`}>{e.g.sigle}</abbr>
  ))}
  <div class="libre" style={ou(LARGEUR / 2, -40)} data-salle-libre hidden={!libre}>
    <span>578<sup>e</sup> siège · libre</span><i></i>
  </div>
  <div class="toi" data-salle-toi hidden>
    <div class="bulle">Toi · 578<sup>e</sup> siège</div>
    <svg width="32" height="32" viewBox="0 0 34 34" aria-hidden="true">
      <path d="M17 2l4.4 9.2 10 1.3-7.3 7 1.9 10L17 24.6 8 29.5l1.9-10-7.3-7 10-1.3z"
        fill="#FFC531" stroke="#1F2433" stroke-width="2" stroke-linejoin="round"></path>
    </svg>
  </div>
  <div class="marque-jumeau" data-salle-jumeau hidden><span>Ton jumeau</span><i></i></div>
  <div class="carte-siege" data-salle-carte hidden>
    <span class="carte-avatar" data-carte-ini></span>
    <span class="carte-texte">
      <span class="carte-nom" data-carte-nom></span>
      <span class="carte-groupe"><span class="pastille-groupe" data-carte-sigle></span><span data-carte-libelle></span></span>
      <span class="carte-accord" data-carte-accord></span>
    </span>
  </div>
  <div class="centre">
    <div class="centre-chiffre" data-salle-chiffre>{chiffre}</div>
    <div class="centre-legende" data-salle-legende>{legende}</div>
  </div>
  <script type="application/json" data-salle-reglages set:html={reglages}></script>
</div>

<style>
  .dessin { position: relative; width: 100%; }
  .dessin > svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .arcs path { fill: none; stroke-width: 5; stroke-linecap: round; }
  .siege { fill: #D6DBE4; cursor: pointer; transition: fill .45s ease, opacity .3s ease; }
  .siege.vacant { fill: #FFFFFF; stroke: #9AA1B2; stroke-width: 1.4; stroke-dasharray: 2.5 2; cursor: default; }
  .siege:global(.sans-commun) { fill: #FFFFFF; stroke: #DFE3EB; stroke-width: 2; }
  .siege:global(.contre-groupe) { stroke: var(--texte); stroke-width: 2.4; r: 6.6px; }
  .siege:global(.estompe) { opacity: .38; }
  .siege:global(.siege-jumeau) { r: 11.4px; fill: #6A3DF0 !important; stroke: #7C4DFF; stroke-width: 3; opacity: 1; }
  .siege:hover { stroke: var(--texte); stroke-width: 2.4; }
  .etiquette {
    position: absolute; z-index: 1; padding: 1px 7px; border-radius: 999px;
    font-family: var(--police-titre); font-weight: 600; font-size: clamp(9px, 0.8vw, 12px);
    line-height: 1.5; white-space: nowrap; text-decoration: none; cursor: help;
  }
  .libre { position: absolute; z-index: 3; transform: translate(-50%, -50%); display: flex;
    flex-direction: column; align-items: center; gap: 6px; pointer-events: none; }
  .libre span { padding: 5px 12px; border-radius: 12px; background: #FFFFFF; border: 2px dashed #B9A4FF;
    color: var(--violet-fonce); font-family: var(--police-titre); font-weight: 600; font-size: 14px; white-space: nowrap; }
  .libre i { width: 26px; height: 26px; border-radius: 50%; border: 2.5px dashed #B9A4FF; }
  .toi { position: absolute; z-index: 4; transform: translate(-50%, -100%); text-align: center; pointer-events: none; }
  .toi .bulle { padding: 6px 12px; border-radius: 12px; background: var(--texte); color: #fff;
    font-family: var(--police-titre); font-weight: 600; font-size: 14px; white-space: nowrap; }
  .toi sup, .libre sup { font-size: 0.65em; }
  .toi svg { display: block; margin: 4px auto 0; }
  .marque-jumeau { position: absolute; z-index: 4; transform: translate(-50%, -100%); display: flex;
    flex-direction: column; align-items: center; pointer-events: none; }
  .marque-jumeau:global(.dessous) { transform: translate(-50%, 0); flex-direction: column-reverse; }
  .marque-jumeau span { padding: 4px 10px; border-radius: 10px; background: var(--violet); color: #fff;
    font-family: var(--police-titre); font-weight: 600; font-size: 12px; white-space: nowrap; box-shadow: 0 3px 0 var(--violet-fonce); }
  .marque-jumeau i { width: 2px; height: 10px; background: var(--violet); }
  .marque-jumeau:global(.vers-droite) { transform: translate(0, -50%); flex-direction: row-reverse; }
  .marque-jumeau:global(.vers-gauche) { transform: translate(-100%, -50%); flex-direction: row; }
  .marque-jumeau:global(.vers-droite) i, .marque-jumeau:global(.vers-gauche) i { width: 10px; height: 2px; }
  .centre { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); width: 30%; text-align: center; pointer-events: none; }
  .centre-chiffre { font-family: var(--police-titre); font-weight: 700; font-size: clamp(24px, 2.9vw, 42px);
    line-height: 1; letter-spacing: -0.02em; white-space: nowrap; }
  .centre-legende { margin-top: 6px; font-size: clamp(11px, 1vw, 14px); line-height: 1.3; color: var(--gris-legende); }
  .carte-siege {
    position: absolute; z-index: 6; transform: translate(-50%, -100%); display: flex; gap: 10px;
    align-items: center; width: max-content; max-width: 320px; padding: 10px 14px 10px 10px;
    border: 2px solid var(--bord); border-radius: 18px; background: var(--fond);
    box-shadow: 0 5px 0 var(--bord); pointer-events: none;
  }
  .carte-siege:global(.a-gauche) { transform: translate(-12%, -100%); }
  .carte-siege:global(.a-droite) { transform: translate(-88%, -100%); }
  .carte-avatar { flex: none; display: flex; align-items: center; justify-content: center; width: 42px; height: 42px;
    border-radius: 13px; background: var(--violet-voile); color: var(--violet-fonce);
    font-family: var(--police-titre); font-weight: 700; font-size: 15px; }
  .carte-texte { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .carte-nom { font-family: var(--police-titre); font-weight: 700; font-size: 16px; line-height: 1.2; }
  .carte-groupe { display: flex; align-items: center; gap: 6px; font-size: 12px; line-height: 1.25; color: var(--gris-legende); }
  .carte-accord { font-size: 13px; line-height: 1.3; color: var(--texte-doux); }
  @media (max-width: 600px) {
    .etiquette { padding: 0 4px; font-size: 8px; }
    .toi .bulle, .libre span { padding: 3px 7px; font-size: 11px; border-radius: 9px; }
    .toi svg { width: 22px; height: 22px; }
    .libre i { width: 18px; height: 18px; }
    .marque-jumeau span { padding: 2px 6px; font-size: 10px; }
    .centre { width: 46%; }
    .centre-chiffre { font-size: 24px; }
    .centre-legende { margin-top: 2px; font-size: 11px; }
  }
</style>
