---
// Démonstration interne (lot V0) : la feuille de gauche, aux mesures de la maquette 10. Données
// illustratives ; la vraie vue « Ta place » arrive au lot V6 (t77). ?siege=N : la vue depuis le
// siège n° N (0 à 576), pour vérifier la vue subjective (lot V3).
import Base from '../../layouts/Base.astro';
import Bouton from '../../components/vdef/Bouton.astro';
import Carte from '../../components/vdef/Carte.astro';
import Feuille from '../../components/vdef/Feuille.astro';

const GROUPES = [['Groupe A', 9], ['Groupe B', 8], ['Groupe C', 6]] as const;
---
<Base titre="Composants de la VDEF · ta place" description="Page interne : la feuille de gauche, avec des données illustratives."
  vue="place" fond="salle" noindex>
  <Feuille position="gauche" titre="demo-place">
    <div class="entete">
      <span class="t-etiquette">D’après tes 12 votes · données illustratives</span>
      <h1 id="demo-place" class="t-feuille titre">Qui vote comme toi</h1>
    </div>
    <Carte etiquette="Ton jumeau · le plus proche" variante="noire" href="#">
      <span class="t-carte">Nom d’exemple</span>
      <span class="sous">Groupe · tu es assis à sa place · et 2 autres à égalité</span>
      <span class="phrase">A voté comme toi sur <strong>10</strong> de tes 12 votes.</span>
    </Carte>
    <Carte etiquette="Ton opposé · le plus éloigné" href="#">
      <span class="t-carte">Autre nom d’exemple</span>
      <span class="sous gris">Groupe</span>
      <span class="phrase">A voté autrement que toi sur <strong>9</strong> de tes 12 votes.</span>
    </Carte>
    <div class="groupes">
      <h2 class="titre-groupes">Les 3 groupes les plus proches</h2>
      <ol>
        {GROUPES.map(([nom, x], k) => (
          <li><span class="rang">{k + 1}</span><span class="t-interface nom">{nom}</span><span class="jauge"><span style={`width: ${(100 * x) / 12}%`}></span></span><span class="t-legende">{x} sur 12</span></li>
        ))}
      </ol>
    </div>
    <Bouton href="#" large class="revoir">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path></svg>
      Revoir mes votes · 12
    </Bouton>
  </Feuille>
</Base>

<script>
  import { salle3D } from '../../salle3d/pilote.ts';
  document.addEventListener('astro:page-load', () => {
    const racine = document.querySelector<HTMLElement>('[data-salle-vdef]');
    const n = Number(new URLSearchParams(location.search).get('siege'));
    if (!racine || !document.querySelector('#demo-place') || !Number.isInteger(n) || n < 0 || n > 576) return;
    const pilote = salle3D(racine);
    pilote.asseoir(n);
    pilote.vue('place', { instant: true });
  });
</script>

<style>
  .entete { display: flex; flex-direction: column; gap: 6px; }
  .titre { font-size: 30px; }
  .sous { font: 600 14px/1.3 var(--police-texte); color: var(--sur-encre-2); }
  .sous.gris { color: var(--texte-2); }
  .phrase { font: 500 16px/1.45 var(--police-texte); }
  .groupes { display: flex; flex-direction: column; gap: 4px; padding: 6px 4px 0; }
  .titre-groupes { font: 700 18px/1.2 var(--police-titre); }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: flex; align-items: center; gap: 12px; padding: 8px 0; }
  .rang { flex: 0 0 28px; height: 28px; border-radius: var(--pilule); background: var(--surface); display: flex; align-items: center; justify-content: center; font: 700 14px/1 var(--police-texte); }
  .nom { flex: 0 0 90px; }
  .jauge { flex: 1; height: 8px; border-radius: var(--pilule); background: var(--surface); overflow: hidden; }
  .jauge span { display: block; height: 100%; background: var(--encre); border-radius: var(--pilule); }
  :global(.feuille .revoir) { margin-top: auto; }
</style>
