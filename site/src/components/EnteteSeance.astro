---
// L'en-tête du mode focus (quiz, lots) : la barre de progression et son compteur, un titre
// facultatif (frame V5 « ⑥ Séance ») et un lien pour sortir. À placer dans le slot « entete »
// de Base.
interface Props {
  total: number;
  libelle: string;
  /** Le titre à gauche de la barre (« Votes passés · lot 2 »), mis à jour par la page. */
  titre?: string;
  sortie: { href: string; texte: string };
  /** Une place pour la série de semaines (frame ⑥), remplie par la page. */
  serie?: boolean;
}

const { total, libelle, titre, sortie, serie = false } = Astro.props;
---
<div class="progression">
  {titre !== undefined && <span class="titre-seance" data-titre-seance>{titre}</span>}
  <div class="barre-cadre">
    <div class="barre" role="progressbar" aria-label={libelle} aria-valuemin="0"
      aria-valuemax={total} aria-valuenow="0" data-barre style={`--n: ${total}`}>
      <span data-barre-pleine></span>
    </div>
    <span class="compteur" data-compteur>Vote 1 sur {total}</span>
  </div>
  {serie && (
    <span class="serie" data-serie hidden>
      <svg width="20" height="22" viewBox="0 0 20 22" aria-hidden="true"><path d="M10 1c1 4 6 6 6 12a6 6 0 0 1-12 0c0-3 2-5 3-6 0 2 1 3 2 3 0-3 0-6 1-9z" fill="#F2C98A"></path></svg>
      <span data-serie-texte></span>
    </span>
  )}
  <a class="quitter" href={sortie.href}>{sortie.texte}</a>
</div>

<style>
  /* La progression du mode focus, en régie : l'étape en étiquette rouge, une barre fine, le
     compteur en capitales ; la série en ivoire, sa flamme en lumière. */
  .progression { display: contents; }
  .titre-seance { flex: none; display: inline-flex; align-items: center; min-height: 36px; padding: 0 12px;
    background: var(--direct); color: var(--sur-direct); font: 600 14px/1 var(--police-titre);
    letter-spacing: 0.12em; text-transform: uppercase; }
  /* Téléphone : la marque et « Quitter » sur la première ligne, la progression dessous. */
  @media (max-width: 640px) {
    .titre-seance { display: none; }
    .barre-cadre { order: 2; flex-basis: 100%; justify-content: flex-start; }
    .quitter { margin-left: auto; padding: 10px 0; }
  }
  .barre-cadre { flex: 1 1 280px; display: flex; align-items: center; justify-content: center; gap: 14px; max-width: 640px; margin: 0 auto; }
  /* La progression en segments de 28 × 4 px, un par vote (DESIGN-FINAL.md, § 6) : la barre que remplit
     lib/ est découpée par un masque, sans toucher au script. */
  .barre { flex: none; width: min(100%, calc(var(--n, 3) * 32px - 4px)); height: 4px; background: var(--filet); overflow: hidden;
    -webkit-mask: repeating-linear-gradient(90deg, #000 0 28px, transparent 28px 32px);
    mask: repeating-linear-gradient(90deg, #000 0 28px, transparent 28px 32px); }
  .barre span { display: block; height: 100%; width: 0; background: var(--ivoire); transition: width .4s ease; }
  .compteur { font: 600 var(--taille-puce)/16px var(--police-titre); letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ivoire-2); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .serie { flex: none; display: inline-flex; align-items: center; gap: 6px; font: 600 16px/1 var(--police-titre);
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ivoire); }
  .serie[hidden] { display: none; }
  .quitter { padding: 14px 4px; font: 600 13px/16px var(--police-titre); letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ivoire-2); text-decoration: none; }
  .quitter:hover { color: var(--ivoire); }
</style>
