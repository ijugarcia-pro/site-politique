---
// La série gelée pendant une trêve parlementaire (F3, docs/animations-lot-1.md § 7) : un flocon
// qui se dessine dans une pastille bleu glacier, et « Ta série de N semaines est gelée : elle
// t'attend pour la reprise ». Jamais un mot de perte. Rempli et montré par lib/gel.ts.
---
<div class="serie-gelee" data-serie-gelee hidden>
  <span class="pastille-gel" aria-hidden="true">
    <svg width="30" height="30" viewBox="0 0 32 32">
      <path pathLength="1" d="M16 4v24"></path>
      <path pathLength="1" d="M5.6 10l20.8 12"></path>
      <path pathLength="1" d="M5.6 22l20.8-12"></path>
      <path pathLength="1" d="M12.5 5.5L16 9l3.5-3.5M12.5 26.5L16 23l3.5 3.5"></path>
    </svg>
  </span>
  <p data-serie-gelee-texte></p>
</div>

<style>
  /* Les bleus du gel (#0B6AAE, #DDF1FF, #BFE3FB) ne sont pas le bleu « Pour ». */
  .serie-gelee { display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: var(--rayon);
    background: #F4FAFF; border: 2px solid #DDF1FF; text-align: left; }
  .serie-gelee p { margin: 0; font-size: 16px; line-height: 1.45; color: #0B3E66; }
  .pastille-gel { flex: none; display: flex; align-items: center; justify-content: center; width: 52px; height: 52px;
    border-radius: 50%; background: #DDF1FF; box-shadow: 0 4px 0 #BFE3FB; }
  .pastille-gel path { fill: none; stroke: #0B6AAE; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 1; stroke-dashoffset: 0; }
  .serie-gelee:global(.joue) .pastille-gel { animation: gel 600ms var(--ease-doux) both; }
  .serie-gelee:global(.joue) .pastille-gel path { stroke-dashoffset: 1; animation: trace 600ms ease-out 200ms both; }
  @keyframes gel { 0% { transform: scale(.4) rotate(-40deg); opacity: 0; } 100% { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .serie-gelee:global(.joue) .pastille-gel, .serie-gelee:global(.joue) .pastille-gel path { animation: none; stroke-dashoffset: 0; }
  }
</style>
